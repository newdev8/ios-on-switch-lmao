# ios-on-switch-lmao Bazel defaults, one reason per flag. A normal build needs nothing else; personal overrides (a remote cache,
# local tuning) go in user.bazelrc (ignored by git), imported last.

# --- Caches: content-addressed, outside the output base, shared by every checkout and worktree ---------------------
# Downloads by sha256 (toolchains, Apple OSS tarballs, IPSW members). Its contents/ directory is also the repository
# contents cache: every repository whose rule declares itself reproducible (http_archive with a sha256, LLVM, Mesa,
# Rust, ...) is handed to a fresh output base already extracted, instead of re-extracting (the LLVM tarball alone
# took 136 s per output base, three times over).
common --repository_cache=~/Library/Caches/switch-ios-bazel/repository
# Hardlink a cached archive into the repository that extracts it instead of copying it. Only download_and_extract
# (http_archive) hardlinks: a repository rule's download() always copies, which APFS makes a clone (ipsw/ipsw.bzl).
common --experimental_repository_cache_hardlinks
# Repository contents cache entries nobody used for a day are deleted (default 14 days): every change to a repository
# rule's definition leaves its previous extraction behind (0.6-0.7 GB for Rust/LLVM-sized repositories).
common --repo_contents_cache_gc_max_age=1d
# Action results by action key: a fresh output base, a new worktree or `bazel clean` reuses them. With a disk cache
# Bazel builds without the bytes: only top-level outputs land in the output base (one is ~1 GB, not 5), each an APFS
# clone of its cache entry: du counts them again, the disk does not.
common --disk_cache=~/Library/Caches/switch-ios-bazel/disk
# No py rule invents __init__.py files, in any repository: MODULE.bazel's explicit_init_py covers only this module, and
# rules_pkg's zip and tar builders still asked for them (rules_python#2945: implicit ones make stray directories
# importable and can empty a real __init__.py).
common --incompatible_default_to_explicit_init_py
# The cap the least recently used entries are deleted above, once Bazel has been idle for gc_idle_delay. One full
# working set is ~8 GB: //:boot //:gpu and the tests ~4.5 GB, //gpu:bundle's seed buckets 1.7 GB and the raw pack's
# probe runs. Each agent branch adds 0.3-1 GB of its own (an XNU object root, a kernel, a package). 8G evicted the
# seed and the raw pack between two deploys, so a raw/ or NVK edit recompiled them from nothing; 24G holds main and
# about a dozen branches. The IPSW's images no longer count: the daily graph reads only its crawl (gpu/seed/crawl.bzl).
common --experimental_disk_cache_gc_max_size=24G
common --experimental_disk_cache_gc_max_age=30d
common --experimental_disk_cache_gc_idle_delay=2m

# --- Hermeticity -------------------------------------------------------------------------------------------------
# Actions see a fixed PATH and none of the shell's environment.
common --incompatible_strict_action_env
# Every action runs sandboxed (darwin-sandbox: read-only declared inputs, declared outputs only). No action needs an
# unsandboxed fallback, so there is none: a new one that tries to read undeclared inputs fails instead of passing.
build --spawn_strategy=sandboxed
# One exception, debug only and off by default (--//bazel/rust:incremental): crates compiled incrementally
# (bazel/rust/defs.bzl, INCREMENTAL_CRATES) keep rustc's sessions below the output base, so their two Rust actions are
# tagged no-sandbox and run here unsandboxed; every other Rust action (and every action of release) stays sandboxed.
build:debug --strategy=Rustc=sandboxed,local
build:debug --strategy=RustcMetadata=sandboxed,local
# The other exception: iOS 27's translation attaches and mounts disk images (hdiutil, diskutil), which no sandbox
# allows, so its two actions (install/translated.bzl) run here.
build --strategy=Pretranslate=local
build --strategy=TranslatedCryptex=local
# And rules_apple's actool (the HW Test apps' asset catalog), which asks CoreSimulator's services for its compile and is
# marked no-sandbox.
build --strategy=AssetCatalogCompile=local
# No network inside actions (repository rules fetch; actions never do).
build --sandbox_default_allow_network=false
# Reuse sandbox directory trees between actions: faster sandbox setup, the same isolation.
build --reuse_sandbox_directories
# External repositories appear in runfiles once (under their own name), not also under _main/external.
build --nolegacy_external_runfiles
# A moved or tampered download fails instead of being used (MODULE.bazel.lock is checked, never rewritten).
common --lockfile_mode=error
# Transient download failures retry instead of failing the build.
common --experimental_repository_downloader_retries=3
# Never stamp: no build time, user or host in any output (Bazel's default, stated: the kernel's version string relies
# on it; its date and builder are //kernel/rules:build_date and :builder, constants).
build --nostamp

# --- Speed ------------------------------------------------------------------------------------------------------
# No --watchfs: Bazel 9.3.1's FSEvents watch sees no edits on macOS 27, so a running server built stale sources.
# Do not stat every file of every external repository and every output before each command (a server tracking ~1M
# nodes spent 7-17 s per command on it). Only Bazel writes either: no repository here is edited in place (no
# local_repository or symlinked working directory; @pinned, @xcode and @gpu_device_data are checked by sha256 or
# rctx.watch, which still re-fetches them), and bazel-out is Bazel's. A hand edit of either goes unnoticed.
common --noexperimental_check_external_repository_files
common --noexperimental_check_output_files

# py_binary launchers as a shell script: rules_python's default first starts the system's /usr/bin/python3 (Xcode's
# xcrun shim) only to re-exec the hermetic interpreter, ~0.08 s of every Python tool action (six on a driver edit's
# path); the script starts the hermetic interpreter at once. The same interpreter, venv and program.
common --@rules_python//python/config_settings:bootstrap_impl=script

# hw_test_app (debug images) is signed ad hoc, like the overlay's other user-space code: the boot package's trust cache
# holds its CDHashes. With this identity rules_apple signs without the stand-in profile it requires for device builds.
build --@rules_apple//apple/build_settings:signing_certificate_name=-
# The app is for the device: rules_apple otherwise builds an Apple silicon host's iOS targets for the simulator.
build --ios_multi_cpus=arm64
# rules_apple tags its bundling, signing and profile-reading actions no-sandbox, for codesign's keychain lookups. An ad
# hoc identity and an XML profile need neither the keychain nor anything undeclared, so they run sandboxed like the rest.
build --modify_execution_info=^(BundleApp|BundleTreeApp|ProcessAndSign|SignBinary|ExtractFromProvisioningProfile)$=-no-sandbox

# --- Output ------------------------------------------------------------------------------------------------------
build --show_result=30
common --color=yes
common --curses=auto
test --test_output=errors
# The cache counters the README talks about ("N processes: M disk cache hit, ...") on every build.
build --show_progress_rate_limit=1

# --- Presets -----------------------------------------------------------------------------------------------------
# The two build profiles (//bazel:profile; every part of the graph selects its flags on it):
# debug: the default. The fastest incremental builds: no LTO, asserts on, symbols, XNU DEVELOPMENT. Keeps going after
# the first failure.
build:debug --//bazel:profile=debug
build:debug --keep_going
# release: full optimisation (fat LTO everywhere, NDEBUG, XNU RELEASE, stripped), no partial result, a full log.
build:release --//bazel:profile=release
# Host code (tests, tools) the usual optimised way: -O2 -DNDEBUG. The kernel's and the iOS toolchains' flags come from
# //bazel:profile, not from this.
build:release --compilation_mode=opt
build:release --nokeep_going
build:release --verbose_failures
# dev: the old name of the default preset.
build:dev --config=debug

# The iOS the build is for, with its IPSW kind (ipsw/pins.bzl) and XNU: ios17 is the default (iPadOS 17.7.11 on
# xnu-10063, iPad7,1), ios27 is iPadOS 27.2 on xnu-12377 for iPad12,1.
common:ios17 --//ipsw:kind=21H461
common:ios27 --//ipsw:kind=24B119
# agent: what an agent worktree adds on the shared machine (16 cores, many agents at once): four cores of local work.
# --jobs bounds the actions in flight, remote ones included; local_resources alone keeps local work to four at a time.
build:agent --jobs=32
build:agent --local_resources=cpu=4
# reproducible-check: ignore every cache so each action really runs, and write an execution log; `bazel run
# //tools/repro:check` builds twice like this in two fresh output bases and diffs every artifact bit for bit.
build:reproducible-check --noremote_accept_cached
build:reproducible-check --disk_cache=
build:reproducible-check --noremote_upload_local_results
build:reproducible-check --execution_log_compact_file=repro-exec.log.zst
# remote: a shared remote cache (bazel-remote, BuildBuddy, ...): the URL is per-user, so
# put `build:remote --remote_cache=grpcs://host:port` (and credentials: --remote_header=... or --credential_helper=...) in user.bazelrc, then use --config=remote.
build:remote --remote_upload_local_results=true
build:remote --remote_timeout=120s
build:remote --remote_cache_compression
build:remote --experimental_remote_cache_eviction_retries=5
build:remote --config=rbe
# rbe: actions run on the remote workers behind that cache (tools/remote), and only top-level outputs come back here.
# The per-user file names the executor (`build:rbe --remote_executor=grpc://host:port`); without one the remote
# strategy is skipped and actions build here.
build:rbe --spawn_strategy=remote,sandboxed
build:rbe --strategy=Rustc=remote,sandboxed,local
build:rbe --strategy=RustcMetadata=remote,sandboxed,local
# A worker that is gone, or a scheduler with none left, costs one failed request per action, then it builds here.
# Bazel runs that fallback unsandboxed and has no flag to sandbox it; tools/remote/README.md keeps its results out of
# the shared cache on the Macs that name an executor (every cache user expands rbe through remote, executor or not).
build:rbe --remote_local_fallback
build:rbe --remote_download_outputs=toplevel
# rules_rust's process_wrapper is stripped (-Cstrip=symbols) with rust-objcopy from the toolchain's sysroot, and NVK's
# 1.96.1 toolchain (third_party/mesa/bazel/repos.bzl) does not declare it: a worker has no such file, while the
# sandbox's links lead into the repository that does. Declaring it there would change NVK's compiler identity, so that
# one small compile stays here.
build:rbe "--strategy_regexp=^Compiling Rust .without process_wrapper=sandboxed"

# nom2v: the m2v deletion's dry run. Bazel loads m2v's runtime crate, Mesa's NVK and its dylibs (//gpu/nvk) as deleted
# packages, and leaves out the tests tagged m2v (they test the fallback itself, or still need it). With --keep_going,
# whatever else fails to load, build or pass is what the deletion still has to move:
#   bazel test --config=nom2v //drivers/... //kits/... //hw_test_app/... //tools/... //gpu/...
common:nom2v --deleted_packages=third_party/m2v/crates/metal2vulkan-runtime,third_party/mesa/src/nouveau/vulkan,gpu/nvk
test:nom2v --build_tests_only
test:nom2v --test_tag_filters=-m2v
build:nom2v --keep_going

# The default preset.
build --config=debug

try-import %workspace%/user.bazelrc
