# What the seed's actions are keyed on (inputs_test.bzl), over stand-ins: no IPSW, no tools built.
#
#   bazel test //gpu/seed/test:all
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//bazel/lint:defs.bzl", "lint_files")
load("//gpu/seed:crawl.bzl", "QUARTZCORE")
load("//gpu/seed:defs.bzl", "metal_seed", "seed_raw_pack", "shader_crawl")
load(":inputs_test.bzl", "seed_inputs_tests")

lint_files()

RAW = [
    "archives.py",
    "draw_context.txt",
    "rawpack.py",
    "directlink.py",
    "mkpack.py",
    "probelog.py",
    "layouts.py",
    "packfile.py",
    "kernels.py",
    "splits.py",
    "eqcheck.py",
    "probe.mm",
    "fetchfree_link.py",
    "ca/caset.py",
    "ca/caspec.py",
    "ca/caspec27.py",
    "ca/deepcolour.py",
    "ca/fetchfree.py",
    "ca/qc-21H461.json",
    "iterated/programs.py",
    "iterated/programs_long.py",
    "iterated/table.py",
    "iterated/ucode.py",
]

# What the generator reads beside its directory (defs.bzl _RAW_LINK's ../runtime/ headers).
RAW_RUNTIME = [
    "raw_owned.h",
    "raw_srgb_table.h",
    "raw_chip_facts.h",
]

[write_file(
    name = path.replace("/", "_"),
    out = path,
    content = [],
    tags = ["manual"],
) for path in [
    "crawl/tree/" + QUARTZCORE,
    "crawl/tree/data/0.metallib",
    "crawl/tree/root/System/Library/PrivateFrameworks/RenderBox.framework/default.metallib",
    "device/1.metallib",
    "crawl/inventory.json",
    "base/TegraGM20BMetal.bundle/Info.plist",
    "tools/precompile",
    "tools/libmock_iokit.dylib",
    "tools/libvulkan_nouveau.dylib",
    "tools/libvulkan_nouveau.dylib.source",
    "tools/MANIFEST.json",
    "tools/raw/probe",
    "corpus/corpus.log",
] + ["raw/" + name for name in RAW] + ["runtime/" + name for name in RAW_RUNTIME]]

filegroup(
    name = "base",
    srcs = [":base/TegraGM20BMetal.bundle/Info.plist"],
    tags = ["manual"],
)

filegroup(
    name = "tools",
    srcs = [
        ":tools/MANIFEST.json",
        ":tools/libmock_iokit.dylib",
        ":tools/libvulkan_nouveau.dylib",
        ":tools/libvulkan_nouveau.dylib.source",
        ":tools/precompile",
        ":tools/raw/probe",
    ],
    tags = ["manual"],
)

filegroup(
    name = "tree",
    srcs = [
        ":crawl/tree/" + QUARTZCORE,
        ":crawl/tree/data/0.metallib",
        ":crawl/tree/root/System/Library/PrivateFrameworks/RenderBox.framework/default.metallib",
    ],
    tags = ["manual"],
)

shader_crawl(
    name = "crawl",
    inventory = ":crawl/inventory.json",
    qc = ":crawl/tree/" + QUARTZCORE,
    tags = ["manual"],
    tree = ":tree",
)

metal_seed(
    name = "seed",
    base = ":base",
    buckets = 4,
    corpus = ":corpus/corpus.log",
    crawl = ":crawl",
    depth = "//gpu/seed:depth",
    tags = ["manual"],
    tools = ":tools",
)

seed_raw_pack(
    name = "raw_pack",
    srcs = [":raw/" + name for name in RAW] + [":runtime/" + name for name in RAW_RUNTIME],
    corpus = ":corpus/corpus.log",
    crawl = ":crawl",
    device_libraries = ":device/1.metallib",
    generator = ":raw/rawpack.py",
    tags = ["manual"],
    tools = ":tools",
)

seed_inputs_tests(
    name = "inputs_test",
    crawl = ":crawl",
    raw_pack = ":raw_pack",
    seed = ":seed",
)
