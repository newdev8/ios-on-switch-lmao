load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/rust:defs.bzl", "THIRD_PARTY_LINT_EXCLUDE")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = THIRD_PARTY_LINT_EXCLUDE)

rust_library(
    name = "metal2vulkan-devtools",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "metal2vulkan_devtools",
    crate_root = "src/lib.rs",
    edition = "2021",
    version = "0.1.0",
    deps = ["@rust_crates//:sha2"],
)
