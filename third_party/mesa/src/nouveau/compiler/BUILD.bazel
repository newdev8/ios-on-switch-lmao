# NAK: meson's _libnak_rs (rust_abi 'c', a staticlib with the standard library in it).
mesa_rust_library(
    name = "nak_rs",
    srcs = glob(
        ["nak/**/*.rs"],
        exclude = ["nak/ir_proc.rs"],
    ),
    crate_name = "nak_rs",
    crate_root = "nak/lib.rs",
    crate_type = "staticlib",
    # ios-on-switch-lmao: release builds leave SwitchHWTest's SM53 probe out (nak/api.rs)
    extra_flags = ["--check-cfg=cfg(switch_release)"] + select({
        "//bazel:release": ["--cfg=switch_release"],
        "//conditions:default": [],
    }),
    lints = NOUVEAU_RUST_ARGS,
    metadata = "ed48680@@nak_rs@sta",
    native_libs = [
        "compiler_bindings",
        "mesa_util",
        "mesa_util_simd",
        "blake3",
        "mesa_util_c11",
        "compiler_c_helpers",
    ],
    proc_macro_deps = [
        ":nak_ir_proc",
        "//third_party/mesa/subprojects/paste-1.0.14:paste",
    ],
    deps = [
        ":nak_bindings",
        "//third_party/mesa/src/compiler/rust:compiler",
        "//third_party/mesa/src/nouveau/compiler/latencies:nak_latencies",
        "//third_party/mesa/src/nouveau/headers:nvidia_headers",
        "//third_party/mesa/src/util/rust:mesa_util",
        "//third_party/mesa/subprojects/rustc-hash-2.1.1:rustc_hash",
    ],
)

# ios-on-switch-lmao: NAK's SM53 half-op encodings against Ryujinx's decoder (nak/sm50.rs sm53_half_tests), on the host. The
# crate's C (NIR, the hardware runner's) is left to dynamic lookup: no test run here calls into it. The test binary is
# built in NVK's configuration and run by sm53_half_test from the default one, as no test runner exists in NVK's.
rust_test(
    name = "nak_sm53_half_test",
    args = ["sm53_half_tests"],
    crate = ":nak_rs_rlib",
    rustc_flags = [
        "--cfg=nak_host_tests",
        "-Clink-arg=-Wl,-undefined,dynamic_lookup",
    ],
    tags = ["manual"],
    deps = [
        "//third_party/mesa/src/c11/impl:mesa_util_c11",
        "//third_party/mesa/src/compiler/rust:compiler_bindings",
        "//third_party/mesa/src/compiler/rust:compiler_c_helpers",
        "//third_party/mesa/src/util:mesa_util",
        "//third_party/mesa/src/util:mesa_util_simd",
        "//third_party/mesa/src/util/blake3",
    ],
)

mesa_files(
    name = "nak_sm53_half_test_bin",
    testonly = True,
    srcs = [":nak_sm53_half_test"],
    platform = "macos",
)

py_test(
    name = "sm53_half_test",
    size = "small",
    srcs = ["run_host_test.py"],
    args = [
        "$(rootpath :nak_sm53_half_test_bin)",
        "sm53_half_tests",
    ],
    data = [":nak_sm53_half_test_bin"],
    main = "run_host_test.py",
)

