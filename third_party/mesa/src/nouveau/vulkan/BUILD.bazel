]

# meson's three Rust staticlibs; the release profile links them as one (//third_party/mesa/bazel:nvk_release_rs).
NVK_RUST_STATICLIBS = [
    ":nvk_rs",
    "//third_party/mesa/src/nouveau/compiler:nak_rs",
    "//third_party/mesa/src/nouveau/nil:nil",
]

# libvulkan_nouveau.dylib: meson's link of src/nouveau/vulkan/meson.build's libvulkan_nouveau, then relinked so the
# entry-point tables' absent weak references are 0 (bazel/link.bzl).
mesa_dylib(
    name = "vulkan_nouveau",
    out = "libvulkan_nouveau.dylib",
    archives = select({
        "//bazel:release": ["//third_party/mesa/bazel:nvk_release_rs"] + [a for a in NVK_ARCHIVES if a not in NVK_RUST_STATICLIBS],
        "//conditions:default": NVK_ARCHIVES,
    }),
    force_load = ":nvk",
    libs = [
        "-lm",
        "-framework",
        "IOKit",
        "-framework",
        "CoreFoundation",
        "-lSystem",
        "-lSystem",
        "-lSystem",
    ],
    link_args = [
        "-Wl,-dead_strip_dylibs",
        "-Wl,-headerpad_max_install_names",
        "-shared",
        "-Wl,-install_name,@rpath/libvulkan_nouveau.dylib",
    ] + select({
        # release: link-time optimisation of the bitcode -flto made, and nothing but the exported symbols kept.
        "//bazel:release": [
            "-flto",
            "-Wl,-S",
            "-Wl,-x",
        ],
        "//conditions:default": [],
    }),
    platform = select({
        "//third_party/mesa/bazel:ios": "ios",
        "//conditions:default": "macos",
    }),
    stubs = "nvk-absent-entrypoints",
)

