load("//bazel/lint:defs.bzl", "lint_files")

# drivers/NativeMobileDisplay: moved from out/native-a57/root-v1/tree/drivers/NativeMobileDisplay by the layout move.
load("//kernel/rules:driver_flags.bzl", "IPSW_KIND_FLAGS")
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")
load("//kits/SwitchABI:defs.bzl", "switch_abi_bindings")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

filegroup(
    name = "overlay_files",
    srcs = glob(["logging/*.plist"]),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

# Display, key store and HID input, touch, buttons, backlight, Joy-Cons, accelerator stub: one late-initialized archive.
kernel_driver(
    name = "NativeLegacyDisplay",
    srcs = [
        "NativeLegacyDisplay.cpp",
        "SwitchScanoutBuffer.cpp",
        "TegraDisplayColor.cpp",
        # The display across SC7 (tegra_display_suspend/resume): hekate's cold display init/power-down.
        "TegraDisplayPower.cpp",
        "original-bindings.S",
    ],
    # IOSurface's accessors (the surfaces' and the hardware planes') are bound by TegraVIC's original-bindings.S.
    abi = [
        "IOMobileFramebufferLegacy",
        "IOSurface",
    ],
    # The IPSW kind's iPad (SWITCH_IPSW_DEVICE_*): SwitchFrameInfo.h's key set.
    copts = IPSW_KIND_FLAGS,
    hdr_deps = [
        "drivers/ArmGIC",
        "drivers/SwitchPower",
        "drivers/SwitchSuspend",
        "drivers/TegraDisplayFlip",
        # TegraGM20BLayout.h: the column-scan experiment's block-linear surfaces (NativeColumnScan.h).
        "drivers/TegraGM20B",
        "drivers/TegraGPIO",
        # SwitchHost1xTokenFence.h: video planes flip from VIC's and NVDEC's syncpoint interrupts.
        "drivers/TegraHost1x",
        "drivers/TegraSMMU",
        # TegraVICConfig.h: the traits the detach gate reads (r18-planes).
        "drivers/TegraVIC",
        "kits/SwitchCAR",
        "kits/SwitchDMA",
        "kits/SwitchDT",
        "kits/SwitchMMIO",
        "kits/SwitchRefusal",
        "kits/SwitchSysctl",
    ],
    late = ["NativeLegacyDisplay.cpp"],
)

switch_abi_bindings(
    name = "original_bindings",
    out = "original-bindings.S",
    classes = ["//kits/SwitchABI:IOMobileFramebufferLegacy"],
    objects = [":NativeLegacyDisplay_cc"],
)

kernel_driver(
    name = "NativeGOPPresenter",
    srcs = ["NativeGOPPresenter.cpp"],
    # TegraGM20BLayout.h: a block-linear surface's rows for the CPU read.
    hdr_deps = ["drivers/TegraGM20B"],
    late = ["NativeGOPPresenter.cpp"],
)
