load("//bazel/lint:defs.bzl", "lint_files")

# drivers/SwitchVideoDecoders: moved from out/native-a57/root-v1/tree/drivers/SwitchVideoDecoders by the layout move.
load("//kernel/rules:kernel.bzl", "kernel_headers")
load("//kernel/rules:package.bzl", "ios_binary")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
    "AVD/VP9Tables.h",
    "test/H264MbaffClip.h",
    "test/HEVCClip.h",
    "test/HEVCTrace.h",
    "test/MPEG2Clip.h",
    "test/MPEG2Trace.h",
    "test/MPEG4Clip.h",
    "test/MPEG4Trace.h",
    "test/VDECClip.h",
    "test/VP9Clip.h",
    "test/VP9Trace.h",
    "test/vp9gen/vpx_config.h",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

# HEVCH8.videodecoder: Apple's software HEVC decoder in VideoToolbox's hardware slot, for still images (HEIC) outside the
# processes that choose streaming codecs.
ios_binary(
    name = "HEVCH8",
    srcs = ["HEVCH8.c"],
    out = "build/switch-video/HEVCH8.videodecoder",
    copts = [
        "-O2",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-dynamiclib",
        "-fvisibility=hidden",
        "-install_name",
        "/System/Library/VideoDecoders/HEVCH8.videodecoder",
        "-framework",
        "CoreFoundation",
    ],
    pagesize = "4096",
    sign_identifier = "com.brunostjohn.switch.hevch8",
)

# AVD.videodecoder: H.264, VP9, HEVC, MPEG-4 Part 2 and MPEG-1/2 on NVDEC as VideoToolbox's hardware 'avc1', 'vp09',
# 'hvc1', 'mp4v', 'mp2v' and 'mp1v' decoders
# (AVD/AVDRegister.c says where they register). Its install name is its own: 24B119's dyld cache holds Apple's
# AVD.videodecoder, and a file naming itself after a cache dylib is an override of it, not a decoder of its own.
ios_binary(
    name = "AVD",
    srcs = [
        "AVD/AVDAlpha.c",
        "AVD/AVDDecoder.c",
        "AVD/AVDEmitter.c",
        "AVD/AVDMPEG.c",
        "AVD/AVDRegister.c",
        "AVD/AVDRoutes.c",
        "AVD/AVDTiles.c",
        "AVD/H264DPB.c",
        "AVD/H264NVDEC.c",
        "AVD/H264Syntax.c",
        "AVD/NVDECClient.c",
        "AVD/NVDECListener.c",
        "AVD/NVDECRing.c",
        "AVD/BlockLinear.c",
        "AVD/VP9NVDEC.c",
        "AVD/VP9Syntax.c",
        "AVD/VP9Probs.c",
        "AVD/HEVCDisplayProbe.c",
        "AVD/HEVCNVDEC.c",
        "AVD/HEVCSetup.c",
        "AVD/HEVCSyntax.c",
        "AVD/MPEG2NVDEC.c",
        "AVD/MPEG2Syntax.c",
        "AVD/MPEG4NVDEC.c",
        "AVD/MPEG4Syntax.c",
        "AVD/MPEGFrames.c",
        "//kits/SwitchRefusal:SwitchRefusal.c",
    ],
    out = "build/switch-video/AVD.videodecoder",
    hdrs = glob(
        [
            "AVD/*.h",
        ],
        allow_empty = True,
    ) + [
        "//drivers/TegraNVDEC:headers",
        "//kits/SwitchRefusal:SwitchRefusal.h",
    ],
    copts = [
        "-O2",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-dynamiclib",
        "-fvisibility=hidden",
        "-install_name",
        "/System/Library/VideoDecoders/SwitchAVD.videodecoder",
        "-framework",
        "CoreFoundation",
        "-framework",
        "CoreMedia",
        "-framework",
        "CoreVideo",
        "-framework",
        "VideoToolbox",
        "-framework",
        "IOKit",
        "-framework",
        "IOSurface",
        "-framework",
        "Security",
    ],
    pagesize = "4096",
    sign_identifier = "com.brunostjohn.switch.avd",
)

# vdectest: the clip check as a command (AVD/ClipCheck.c), on the device and on a Mac.
ios_binary(
    name = "vdectest",
    srcs = [
        "test/vdectest.c",
        "AVD/ClipCheck.c",
    ],
    out = "build/switch-video/vdectest",
    hdrs = [
        "//kits/SwitchCRC:headers",
        "AVD/ClipCheck.h",
        "test/HEVCClip.h",
        "test/VDECClip.h",
        "test/VP9Clip.h",
    ],
    copts = [
        "-O2",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-framework",
        "CoreFoundation",
        "-framework",
        "CoreMedia",
        "-framework",
        "CoreVideo",
        "-framework",
        "VideoToolbox",
    ],
    sign_identifier = "com.brunostjohn.switch.vdectest",
)
