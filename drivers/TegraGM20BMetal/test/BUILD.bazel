        "raw_facade_standins.h",
        "raw_job_methods.h",
        "raw_kernel_model.h",
    ],
    copts = FACADE_OBJC_COPTS,
    features = FACADE_OBJC_FEATURES,
    deps = FACADE_HOST_DEPS + [
        ":raw_facade_host",
        "//kits/SwitchGM20BEmit/test:method_checks",
        "@googletest//:gtest",
    ],
    alwayslink = True,
) for name in [
    "raw_facade_arguments_test",
    "raw_facade_heap_use_test",
]]

[host_test(
    name = name,
    srcs = ["raw_facade_harness.h"],
    linkopts = [
        "-lobjc",
    ],
    deps = [":%s_unit" % name],
) for name in [
    "raw_facade_arguments_test",
    "raw_facade_heap_use_test",
]]

