# The TegraGM20B Metal plugin's sources and the precompile/stage tools (m2v and our changes to it: third_party/m2v). The bundle itself is
# built by //gpu:bundle (gpu/BUILD.bazel); the device-side tools here are what //deploy:* runs.
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")
load("//kernel/rules:package.bzl", "ios_binary")
load("//kits/SwitchGM20BEmit:defs.bzl", "EMIT_SOURCES")

package(default_visibility = ["//visibility:public"])

# raw/pack/mesa is Mesa's code, kept as upstream has it; srgb_knots.h is m2v's SRGB_KNOTS table and srgb_encode.h its
# inverse (raw_ycbcr_converted_store_test holds it to the rule), generated.
lint_files(exclude = [
    "raw/pack/mesa/**",
    "raw/pack/srgb_encode.h",
    "raw/pack/srgb_knots.h",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

# The raw GM20B path: its runtime (compiled into the plugin), its pack generator, and the sources its stack key hashes
# (raw_stack_sources).
filegroup(
    name = "raw_runtime_headers",
    srcs = glob([
        "raw/runtime/*.h",
        "raw/fx/*.h",
    ]) + [
        "raw/pack/probe_bind.h",  # the probe's bind offsets, which name a record's residual words (raw_record.h)
        "raw/pack/srgb_encode.h",  # the sRGB YCbCr store states' table, the device's copy of it (Device::srgbEncode_)
    ],
)

# The raw facade's Objective-C++ units (RawMetal.mm and the RawMetal*.mm beside it, RawAlias.mm, RawComplete.mm, RawDirect.mm)
filegroup(
    name = "raw_facade_srcs",
    srcs = glob(["raw/runtime/Raw*.mm"]) + ["raw/runtime/SwitchSharedEvent.mm"],
)

# Not a hand run's leftovers: a .pyc of the modules (the host Python's) in a checkout would change the raw pack's action key
# there and nowhere else, so that checkout's pack never hits the disk cache another checkout filled, and the other way round.
filegroup(
    name = "raw_pack_generator",
    srcs = glob(
        ["raw/pack/**"],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
            "**/.DS_Store",
        ],
    ) + [
        "raw/runtime/raw_owned.h",  # the methods the raw path owns (pack/mkpack.py reads them)
        "//kits/SwitchGM20B:class_headers",  # pack/nvdec.cpp's method numbers
        "raw/runtime/raw_srgb_table.h",  # the colour table pack/layouts.py recognises
        "raw/runtime/raw_chip_facts.h",  # the chip facts pack/packfile.py writes into a pack's header
        # a kernel's key (pack/kernel_shapes.h)
        "raw/runtime/raw_compute_key.h",
        "raw/runtime/raw_metallib.cpp",
        "raw/runtime/raw_metallib.h",
        "raw/runtime/raw_pack.h",
        "raw/runtime/RawPipelineKey.h",  # the runtime's key of a state, which probe_states.h files records under
    ],
)

# The raw runtime's sources the pack generator's directpack.mm and native_seed.mm make records with (raw/pack/rawpack.py
# DIRECT_RUNTIME), as the plugin makes its own
filegroup(
    name = "raw_direct_sources",
    srcs = [
        "precompile/PrecompileCompute.h",
        "precompile/PrecompileInputs.h",
        "raw/runtime/RawDirect.h",
        "raw/runtime/RawDirect.mm",
        "raw/runtime/RawRenderKey.h",
        "raw/runtime/RawRenderKey.mm",
        "raw/runtime/RawPipelineKey.h",
        "raw/runtime/raw_render_key.h",
        "raw/runtime/raw_cache.cpp",
        "raw/runtime/raw_cache.h",
        "raw/runtime/raw_cache_io.h",
        "raw/runtime/raw_kernel_cache.cpp",
        "raw/runtime/raw_compute_key.h",
        "raw/runtime/raw_compute_record.h",
        "raw/runtime/raw_chip_facts.h",
        "raw/runtime/raw_cubic.h",
        "raw/runtime/raw_descriptors.h",
        "raw/runtime/raw_direct.cpp",
        "raw/runtime/raw_direct.h",
        "raw/runtime/raw_direct_compute.cpp",
        "raw/runtime/raw_direct_compute.h",
        "raw/runtime/raw_direct_encode.h",
        "raw/runtime/raw_direct_heap.h",
        "raw/runtime/raw_direct_nvk.h",
        "raw/runtime/raw_direct_push.h",
        "raw/runtime/raw_dynamic_push.h",
        "raw/runtime/raw_spill_table.h",
        "raw/runtime/raw_direct_storage.h",
        "raw/runtime/raw_storage.h",
        "raw/runtime/raw_split_metadata.h",
        "raw/runtime/raw_emit.cpp",
        "raw/runtime/raw_emit.h",
        "raw/runtime/raw_metallib.cpp",
        "raw/runtime/raw_metallib.h",
        "raw/runtime/raw_nak_target.h",
        "raw/runtime/raw_owned.h",
        "raw/runtime/raw_program_pages.h",
        "raw/runtime/raw_sample_shading.h",
        "raw/runtime/raw_pack.cpp",
        "raw/runtime/raw_pack.h",
        "raw/runtime/raw_push.h",
        "raw/runtime/raw_record.h",
        "raw/runtime/raw_record_parts.cpp",
        "raw/runtime/raw_record_parts.h",
        "raw/runtime/raw_residual.h",
        "raw/runtime/raw_rotation.h",
        "raw/runtime/raw_set_layout.h",
        "raw/runtime/raw_set_reads.h",
        "raw/runtime/raw_written_textures.h",
        "raw/runtime/raw_xr.h",
        "raw/runtime/raw_xr_pass.h",
        "raw/runtime/raw_zeta.h",  # the formats directpack.mm's test classes reach
    ],
)

# The pack generator but ca/, which only picks the states the pack makes and writes each as a corpus line: a line names
# its state's key and everything its record is made from, so no ca/ edit changes the bytes behind a key.
filegroup(
    name = "raw_pack_records",
    srcs = glob(
        ["raw/pack/**"],
        exclude = [
            "raw/pack/ca/**",
            "**/*_test.py",
            "**/__pycache__/**",
            "**/*.pyc",
            "**/.DS_Store",
            "**/.clang-format",
        ],
    ) + [
        "raw/fx/test/twod_sim.h",  # the 2D engine nvdec executes (pack/nvdec.cpp)
        "raw/runtime/raw_srgb_table.h",  # the colour table pack/layouts.py recognises
        "//kits/SwitchGM20B:class_headers",  # pack/nvdec.cpp's method numbers
        "//kits/SwitchGM20BEmit:context",  # the channel's context init pack/context_state.cpp runs
    ],
)

# The system shader compiler (compiler/): compiled into the plugin and run by SwitchShaderCompiler below. Not part of the
# stack key: a store is named by the stack and the pack's rules, its entries are raw_cache.cpp's, and a store name made
# otherwise only misses.
filegroup(
    name = "compiler_srcs",
    srcs = [
        "compiler/compiler_engine.mm",
        "compiler/compiler_libraries.mm",
        "compiler/compiler_record.mm",
        "compiler/compiler_request.mm",
        "compiler/compiler_sandbox.mm",
        "compiler/compiler_service.mm",
    ],
)

filegroup(
    name = "compiler_cc_srcs",
    srcs = [
        "compiler/compiler_log.cpp",
        "compiler/compiler_pool.cpp",
        "compiler/compiler_store.cpp",
    ],
)

filegroup(
    name = "compiler_headers",
    srcs = glob(["compiler/*.h"]),
)

# /usr/libexec/SwitchShaderCompiler (overlay/manifest.json): loads the plugin and runs its compiler. launchd starts it on
# iOS 27 (com.brunostjohn.switch.shadercompiler.plist), the BlueTool stand-in on iOS 17.
ios_binary(
    name = "SwitchShaderCompiler",
    srcs = ["compiler/SwitchShaderCompiler.c"],
    out = "build/switch-gpu/SwitchShaderCompiler",
    copts = [
        "-O2",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-framework",
        "IOKit",
        "-framework",
        "CoreFoundation",
    ],
    entitlements = "compiler/SwitchShaderCompiler.entitlements",
)

# The overlay files of the compiler that overlay/manifest.json names
filegroup(
    name = "overlay_files",
    srcs = ["compiler/com.brunostjohn.switch.shadercompiler.plist"],
)

# What the raw path's records, pack entries and native seed records are made by, as //gpu:raw_stack hashes it: the shader
# tools build the raw pack's tools from exactly these files (//gpu/seed:local_tools), and the plugin makes and reads its
# records with the same units. raw_stack checks that each unit here includes nothing else; tools/gpu/raw_stack_test.py
# that the generator builds and reads nothing else.
filegroup(
    name = "raw_stack_sources",
    srcs = [
        ":raw_direct_sources",
        ":raw_pack_records",
        "//drivers/NativeMetal:NativeBridgeMetalFrontend.mm",
        "//drivers/NativeMetal:frontend_headers",
        "//drivers/TegraGM20B:TegraGM20BABI.h",
        "//drivers/TegraGM20B:TegraGM20BJobABI.h",
        "//drivers/TegraGM20B:TegraGM20BLayout.h",
        "//kits/SwitchRefusal:SwitchRefusal.h",
        "//kits/SwitchRefusal:SwitchRefusalSite.h",
    ],
)

# Every file below raw/: what raw_stack_test.py looks the generator's file names up in
filegroup(
    name = "raw_tree",
    srcs = glob(
        ["raw/**"],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
            "**/.DS_Store",
        ],
    ),
)

# The GPU context-switch stress and fetch readback (raw/test/fetchform.cpp): debug boot packages stage it at
# /usr/bin/switch-fetchform, and the BlueTool stand-in runs it when the Mac posts
# com.brunostjohn.switch.debug.ctxsw-stress (`idevicenotificationproxy -u <udid> post com.brunostjohn.switch.debug.ctxsw-stress`);
# its lines are the "fetchform" category of com.brunostjohn.switch.TegraGM20BMetal (`idevicesyslog -u <udid> -m fetchform`).
ios_binary(
    name = "fetchform",
    srcs = [
        "raw/fx/fx_image.cpp",
        "raw/fx/fx_mip.cpp",
        "raw/runtime/raw_alias.cpp",
        "raw/runtime/raw_amplification.cpp",
        "raw/runtime/raw_arena.cpp",
        "raw/runtime/raw_comp.cpp",
        "raw/runtime/raw_gpu.cpp",
        "raw/runtime/raw_private_comp.cpp",
        "raw/runtime/raw_draw_bands.cpp",
        "raw/runtime/raw_job_uses.cpp",
        "raw/runtime/raw_draw_shortcuts.cpp",
        "raw/runtime/raw_resolve_twod.cpp",
        "raw/runtime/raw_tessellation.cpp",
        "raw/runtime/raw_transfer.cpp",
        "raw/runtime/raw_kernel.cpp",
        "raw/runtime/raw_kernel_job.cpp",
        "raw/runtime/raw_resource_set.cpp",
        "raw/runtime/raw_encoder_state.cpp",
        "raw/runtime/raw_state_segment.cpp",
        "raw/runtime/raw_shared_events.cpp",
        "raw/runtime/raw_pack.cpp",
        "raw/runtime/raw_split.cpp",
        "raw/runtime/raw_variants.cpp",
        "raw/runtime/raw_vertex_streams.cpp",
        "raw/runtime/raw_zeta.cpp",
        "raw/test/fetchform.cpp",
    ] + ["//kits/SwitchGM20BEmit:" + s for s in EMIT_SOURCES],
    out = "build/switch-gpu/fetchform",
    hdrs = [
        ":raw_runtime_headers",
        "//drivers/NativeMetal:bridge/NativeMetalBlend.h",
        "//drivers/TegraGM20B:TegraGM20BABI.h",
        "//drivers/TegraGM20B:TegraGM20BClockABI.h",
        "//drivers/TegraGM20B:TegraGM20BHost.h",
        "//drivers/TegraGM20B:TegraGM20BJobABI.h",
        "//drivers/TegraGM20B:TegraGM20BLayout.h",
        "//drivers/TegraGM20B:TegraGM20BSchedPolicy.h",
        "//drivers/TegraGM20B:TegraGM20BZcullABI.h",
        "//kits/SwitchGM20B:class_headers",
        "//kits/SwitchGM20BEmit:emit_headers",
        "//kits/SwitchGM20BEmit:macros",
    ],
    copts = [
        "-O2",
        "-std=c++17",
        "-DSWITCH_RAW_HARNESS_MARKS",
        "-Wall",
        "-Wextra",
        "-I",
        "drivers/TegraGM20B",
        "-I",
        "kits/SwitchGM20BEmit/mesa",
        "-I",
        "{bin}/kits/SwitchGM20BEmit/gen",
        "-I",
        "third_party/mesa/src/nouveau/headers",
        "-lc++",
        "-framework",
        "CoreFoundation",
        "-framework",
        "IOKit",
    ],
    # debug builds only (Device::fetchBarrier): //boot:package depends on it in the debug profile
    tags = ["manual"],
)

# The pack generator (raw/pack/rawpack.py and the modules it imports); //tools/gpu:rawpack runs it.
py_library(
    name = "raw_pack",
    srcs = glob(
        [
            "raw/pack/*.py",
            "raw/pack/ca/*.py",
            "raw/pack/iterated/*.py",
        ],
        exclude = [
            "raw/pack/ca/*_test.py",
            "raw/pack/iterated/*_test.py",
        ],
    ),
    data = [
        "raw/pack/ca/qc-21H461.json",
        "raw/pack/ca/qc-24B119.json",
        "raw/runtime/raw_srgb_table.h",  # pack/layouts.py reads it at import
    ],
)

# raw/pack/ca/caspec.py makes every Core Animation state of the corpus from its name alone (QuartzCore's own decoding).
py_test(
    name = "caspec_test",
    srcs = ["raw/pack/ca/caspec_test.py"],
    data = [
        "precompile/corpus.log",
        "raw/pack/ca/qc-21H461.json",
    ],
    main = "raw/pack/ca/caspec_test.py",
    deps = [":raw_pack"],
)

# The same for iOS 27's QuartzCore (raw/pack/ca/caspec27.py): every state of the raw pack's tiers against the functions
# and constants its own library declares, and the journal's iOS 27 states made as drawn.
py_test(
    name = "caspec27_test",
    srcs = ["raw/pack/ca/caspec27_test.py"],
    data = [
        "precompile/ca-names/24B119.txt",
        "precompile/corpus.log",
        "raw/pack/ca/qc-24B119.json",
    ],
    main = "raw/pack/ca/caspec27_test.py",
    deps = [":raw_pack"],
)

# raw/pack/ca/fetchfree.py: the fetch-free forms the pack makes of fetching Core Animation states, on both IPSWs' tables.
py_test(
