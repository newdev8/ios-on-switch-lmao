# Developer tools, `bazel run //drivers/TegraGM20BMetal:<name> -- ...`: the shader corpus
# (corpus/tools), the raw path's draw-order check, and the dyld shared cache import check.
[py_binary(
    name = tool,
    srcs = ["corpus/tools/%s.py" % tool],
    main = "corpus/tools/%s.py" % tool,
) for tool in [
    "categorize",
    "dsc_metallibs",
    "dsc_owner",
    "make_corpus",
    "mtlb_extract",
    "report",
    "run_corpus",
    "runtime_compile_callers",
]]

# The pipeline states Apple's OS declares ahead (corpus/tools/archives): binary archives, pipeline libraries and pipeline
# scripts. `bazel run //drivers/TegraGM20BMetal:declared -- --root <mounted OS volume> --root <mounted cryptex>...
# --inventory <tsv>` writes precompile/archives/<build>.tsv from an IPSW's images; archive_coverage diffs one against the
# raw pack's states and the device's journals.
# What the raw pack makes of them (//gpu/seed:raw_pack takes the IPSW kind's: tools/gpu/rawpack.py archive_lines).
filegroup(
    name = "archive_inventories",
    srcs = glob(["precompile/archives/*.tsv"]),
)

# The Core Animation states devices named missing from the pack, per IPSW kind (precompile/ca_names.py merges a boot's
# logs in; //gpu/seed:raw_pack makes them from their names).
filegroup(
    name = "ca_name_lists",
    srcs = glob(["precompile/ca-names/*.txt"]),
)

# Our own apps' render states the raw pack holds, per IPSW kind (//gpu/seed:raw_pack, tools/gpu/rawpack.py app_states).
filegroup(
    name = "app_state_lists",
    srcs = glob(["precompile/app-states/*.log"]),
)

py_library(
    name = "archives",
    srcs = glob(
        ["corpus/tools/archives/*.py"],
