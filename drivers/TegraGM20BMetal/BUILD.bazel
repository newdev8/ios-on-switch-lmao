    main = "raw/pack/fetchfree_link_test.py",
    deps = [":raw_pack"],
)

# raw/pack/iterated: every iterated blend program a fetch-free form names, against QuartzCore's formula.
py_test(
    name = "iterated_table_test",
    srcs = ["raw/pack/iterated/table_test.py"],
    main = "raw/pack/iterated/table_test.py",
