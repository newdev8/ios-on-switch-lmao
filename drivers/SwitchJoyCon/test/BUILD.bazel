# drivers/SwitchJoyCon's HID session rule (SwitchJoyConSession.h, compiled as C by its harness) on the host, and the
# gamecontrollerd connection storm it ends, reproduced by a model of gamecontrollerd, backboardd and the rail; a
# Joy-Con's stick calibration (SwitchJoyConStick.h), which rail reports reach the HID device (SwitchJoyConForward.h),
# when the rail pair is a game controller in use (SwitchJoyConUse.h) and how often a Joy-Con is asked
# (SwitchJoyConCadence.h), against a captured Joy-Con's own calibration and resting stick (switch_joycon_capture.h);
# what a take finds in the RX DMA ring (SwitchJoyConRxRing.h); how a Joy-Con's pairing log is read
# (SwitchJoyConPairingSlot.h); the rail's packets and pairing request against Horizon's captured attach
# (SwitchJoyConRailPacket.h); that the pairing opens every rail session and joyconpaird hands each rail key on
# (SwitchJoyConRail.cpp, helper/joyconpaird.c); which game-controller personalities each kernel's build adds
# (SwitchJoyConHID.cpp); joyconpaird's rules for importing Horizon's staged pairing dump
# (helper/joycon_pairing_import.h); and the rail probe's stages against model Joy-Cons (SwitchJoyConProbe.h).
#
#   bazel test //drivers/SwitchJoyCon/test:all
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_library", "host_test")

lint_files()

host_library(
    name = "session_harness",
    srcs = ["switch_joycon_session_harness.c"],
    hdrs = [
        "switch_joycon_session_harness.h",
        "//drivers/SwitchJoyCon:SwitchJoyConSession.h",
    ],
    copts = [
        "-O1",
        "-Wconversion",
        "-Wsign-conversion",
    ],
)

host_test(
    name = "switch_joycon_session_test",
    srcs = ["switch_joycon_session_test.cpp"],
    deps = [":session_harness"],
)

host_library(
    name = "reports",
    hdrs = [
        "switch_joycon_capture.h",
        "switch_joycon_fixture.h",
        "//drivers/SwitchJoyCon:SwitchJoyConCadence.h",
        "//drivers/SwitchJoyCon:SwitchJoyConForward.h",
        "//drivers/SwitchJoyCon:SwitchJoyConStick.h",
        "//drivers/SwitchJoyCon:SwitchJoyConUse.h",
    ],
)

[host_test(
    name = "switch_joycon_{}_test".format(name),
    srcs = ["switch_joycon_{}_test.cpp".format(name)],
    deps = [":reports"],
) for name in [
    "cadence",
    "forward",
    "stick",
    "use",
]]

host_library(
    name = "probe",
    hdrs = ["//drivers/SwitchJoyCon:SwitchJoyConProbe.h"],
)

host_test(
    name = "switch_joycon_probe_test",
    srcs = ["switch_joycon_probe_test.cpp"],
    deps = [":probe"],
)

host_library(
    name = "pairing_slot",
    hdrs = ["//drivers/SwitchJoyCon:SwitchJoyConPairingSlot.h"],
)

host_test(
    name = "switch_joycon_pairing_slot_test",
    srcs = ["switch_joycon_pairing_slot_test.cpp"],
    deps = [":pairing_slot"],
)

host_library(
    name = "rail_packet",
    hdrs = ["//drivers/SwitchJoyCon:SwitchJoyConRailPacket.h"],
)

host_test(
    name = "switch_joycon_rail_packet_test",
    srcs = ["switch_joycon_rail_packet_test.cpp"],
    deps = [":rail_packet"],
)

host_test(
    name = "switch_joycon_rail_pairing_test",
    srcs = ["switch_joycon_rail_pairing_test.cpp"],
    data = [
        "//drivers/SwitchJoyCon:SwitchJoyConRail.cpp",
        "//drivers/SwitchJoyCon:helper/joyconpaird.c",
    ],
)

host_library(
    name = "rx_ring",
    hdrs = ["//drivers/SwitchJoyCon:SwitchJoyConRxRing.h"],
)

host_test(
    name = "switch_joycon_rx_ring_test",
    srcs = ["switch_joycon_rx_ring_test.cpp"],
    deps = [":rx_ring"],
)

host_test(
    name = "switch_joycon_personality_test",
    srcs = ["switch_joycon_personality_test.cpp"],
    data = ["//drivers/SwitchJoyCon:SwitchJoyConHID.cpp"],
)

host_library(
    name = "pairing_import",
    hdrs = ["//drivers/SwitchJoyCon:helper/joycon_pairing_import.h"],
)

host_test(
    name = "switch_joycon_pairing_import_test",
    srcs = ["switch_joycon_pairing_import_test.cpp"],
    deps = [":pairing_import"],
)
