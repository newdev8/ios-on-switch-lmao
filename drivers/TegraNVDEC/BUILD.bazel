load("//bazel/lint:defs.bzl", "lint_files")

# drivers/TegraNVDEC: moved from out/native-a57/root-v1/tree/drivers/TegraNVDEC by the layout move.
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

kernel_driver(
    name = "TegraNVDEC",
    srcs = [
        "TegraNVDEC.cpp",
        "SwitchNVDECCompletions.cpp",
        "SwitchNVDECJobs.cpp",
        "SwitchNVDECSemantics.cpp",
        "SwitchNVDECOutput.cpp",
        "SwitchNVDECPark.cpp",
        "TegraNVDECCancel.cpp",
        "TegraNVDECMemory.cpp",
        "TegraNVDECUserClient.cpp",
        "firmware.S",
    ],
    hdr_deps = [
        "drivers/TegraGM20B",
        "drivers/TegraHost1x",
        "drivers/TegraSMMU",
        "drivers/TegraVIC",
        "kits/SwitchBootArgs",
        "kits/SwitchCAR",
        "kits/SwitchDMA",
        "kits/SwitchEngineGate",
        "kits/SwitchFalcon",
        "kits/SwitchMMIO",
        "kits/SwitchRefusal",
        "kits/SwitchTime",
    ],
    stems = {"firmware.S": "nvdec_firmware"},
)
