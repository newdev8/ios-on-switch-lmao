load("//bazel/lint:defs.bzl", "lint_files")

# drivers/TegraNVJPG: moved from out/native-a57/root-v1/tree/drivers/TegraNVJPG by the layout move.
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

# TegraNVJPG: the NVJPG falcon (JPEG codec 1.0) as the system's hardware JPEG decoder (the AppleJPEGDriver service and
# its AppleJPEGDriverUserClient, which CMPhoto and VideoToolbox's JPEG decoder open): its SMMU domain, job engine and
# user client; firmware by .incbin.
kernel_driver(
    name = "TegraNVJPG",
    srcs = [
        "TegraNVJPG.cpp",
        "TegraNVJPGUserClient.cpp",
        "firmware.S",
    ],
    hdr_deps = [
        "drivers/TegraHost1x",
        "drivers/TegraSMMU",
        "drivers/TegraVIC",
        "kits/SwitchCAR",
        "kits/SwitchDMA",
        "kits/SwitchEngineGate",
        "kits/SwitchFalcon",
        "kits/SwitchMMIO",
        "kits/SwitchMath",
        "kits/SwitchRefusal",
        "kits/SwitchTime",
    ],
    stems = {"firmware.S": "nvjpg_firmware"},
)
