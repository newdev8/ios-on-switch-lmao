# drivers/TegraNVJPG (NVJPG 1.0 as the AppleJPEGDriver hardware JPEG codec) on the host:
#   nvjpg_host_test     TegraNVJPGJpeg.h's parser against libjpeg-turbo's own parse (BCR @libjpeg_turbo, pinned in
#                       MODULE.bazel) over a matrix of files libjpeg-turbo writes, every refusal, the output targets and
#                       the JFIF matrix (nvjpg_host.c)
#   request_host_test   the AppleJPEGDriver decode request's translation and refusals (request_host.c)
#   tegra_nvjpg_vendored_test  the vendored firmware and NVIDIA headers are the files their SOURCE files name
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_library", "host_shims", "host_test")

lint_files()

host_library(
    name = "nvjpg_host",
    srcs = [
        "nvjpg_host.c",
        "//drivers/TegraNVJPG:TegraNVJPGJpeg.h",
        "//drivers/TegraNVJPG:nvidia/nvjpg_drv.h",
    ],
    copts = ["-O1"],
    defines = [
        "HAVE_LIBJPEG",
        "main=nvjpg_host_main",
    ],
    deps = ["@libjpeg_turbo//:jpeg"],
)

host_test(
    name = "nvjpg_host_test",
    srcs = ["nvjpg_host_test.cpp"],
    deps = [":nvjpg_host"],
)

host_library(
    name = "request_host",
    srcs = [
        "request_host.c",
        "//drivers/TegraNVJPG:TegraNVJPGJpeg.h",
        "//drivers/TegraNVJPG:TegraNVJPGRequest.h",
        "//drivers/TegraNVJPG:nvidia/nvjpg_drv.h",
    ],
    copts = ["-O1"],
    defines = ["main=request_host_main"],
)

host_test(
    name = "request_host_test",
    srcs = ["request_host_test.cpp"],
    deps = [":request_host"],
)

host_test(
    name = "tegra_nvjpg_vendored_test",
    srcs = ["tegra_nvjpg_vendored_test.cpp"],
    data = [
        "//drivers/TegraNVDEC:firmware/LICENCE.nvidia",
        "//drivers/TegraNVJPG:firmware/LICENCE.nvidia",
        "//drivers/TegraNVJPG:firmware/SOURCE",
        "//drivers/TegraNVJPG:firmware/nvidia/tegra210/nvjpg.bin",
        "//drivers/TegraNVJPG:nvidia/SOURCE",
        "//drivers/TegraNVJPG:nvidia/cle7d0.h",
        "//drivers/TegraNVJPG:nvidia/nvjpg_drv.h",
    ],
)

host_shims(
    name = "gate_kernel",
    headers = [
        "IOKit/IOLib.h",
        "IOKit/IOLocks.h",
        "IOKit/IOBufferMemoryDescriptor.h",
        "kern/clock.h",
        "kern/thread.h",
        "kern/thread_call.h",
        "os/log.h",
    ],
    stubs = "switch_nvjpg_gate_stubs.h",
)

# TegraNVJPG.cpp against a model of the engine: a job after the idle power-off powers the partition on, boots and
# proves the falcon and runs; a job past its bound is cancelled (channel torn down, engine reset and rebooted) and the
# next job runs; an engine the reset does not bring back refuses the next job.
host_test(
    name = "switch_nvjpg_gate_test",
    srcs = [
        "switch_nvjpg_gate_test.cpp",
        "//drivers/TegraHost1x:TegraHost1x.h",
        "//drivers/TegraNVJPG:TegraNVJPG.h",
        "//drivers/TegraNVJPG:TegraNVJPGJpeg.h",
        "//drivers/TegraNVJPG:nvidia/cle7d0.h",
        "//drivers/TegraNVJPG:nvidia/nvjpg_drv.h",
        "//drivers/TegraSMMU:TegraSMMU.h",
        "//drivers/TegraSMMU:TegraSMMUDomain.h",
        "//kits/SwitchCAR:SwitchCAR.h",
        "//kits/SwitchCAR:SwitchEngineClock.h",
        "//kits/SwitchCAR:SwitchEngineClockPlan.h",
        "//kits/SwitchCAR:SwitchPMC.h",
        "//kits/SwitchDMA:SwitchDMABuffer.h",
        "//kits/SwitchDMA:SwitchDcache.h",
        "//kits/SwitchDMA:SwitchHwPage.h",
        "//kits/SwitchEngineGate:SwitchEngineGate.h",
        "//kits/SwitchEngineGate:SwitchEngineGateKernel.h",
        "//kits/SwitchEngineGate:SwitchEnginePower.h",
        "//kits/SwitchFalcon:SwitchFalcon.h",
        "//kits/SwitchMath:SwitchMath.h",
        "//kits/SwitchMMIO:SwitchMMIO.h",
        "//kits/SwitchMMIO:SwitchMMIOKernel.h",
        "//kits/SwitchTime:SwitchTime.h",
    ],
    additional_compiler_inputs = ["//drivers/TegraNVJPG:TegraNVJPG.cpp"],
    deps = [":gate_kernel"],
)
