load("//bazel/lint:defs.bzl", "lint_files")

# drivers/SwitchVideoEncoders: moved from out/native-a57/root-v1/tree/drivers/SwitchVideoEncoders by the layout move.
load("//kernel/rules:kernel.bzl", "kernel_headers")
load("//kernel/rules:package.bzl", "ios_binary")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

# H264H7.videoencoder: AVE's stand-in, H.264 on NVENC as VideoToolbox's hardware 'avc1' encoder (registered once the
# kernel published TegraNVENC; sessions open it where the process may). The path is a slot of 21H461's VTLoadVideoEncoders list that the dyld cache does not fill.
ios_binary(
    name = "AVE",
    srcs = [
        "AVE/AVEEncoder.c",
        "AVE/AVEInput.c",
        "AVE/AVELayoutProbe.c",
        "AVE/AVEReorder.c",
        "AVE/AVETiles.c",
        "AVE/H264NVENC.c",
        "AVE/HEVCEncSyntax.c",
        "AVE/HEVCNVENC.c",
        "AVE/NVENCClient.c",
        "//kits/SwitchRefusal:SwitchRefusal.c",
    ],
    out = "build/switch-video/H264H7.videoencoder",
    hdrs = glob(
        ["AVE/*.h"],
        allow_empty = True,
    ) + [
        "//drivers/SwitchVideoDecoders:AVD/VTDecoderSPI.h",
        "//drivers/TegraNVENC:headers",
        "//kits/SwitchRefusal:SwitchRefusal.h",
    ],
    copts = [
        "-O2",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-dynamiclib",
        "-fvisibility=hidden",
        "-install_name",
        "/System/Library/VideoEncoders/H264H7.videoencoder",
        "-framework",
        "CoreFoundation",
        "-framework",
        "CoreMedia",
        "-framework",
        "CoreVideo",
        "-framework",
        "VideoToolbox",
        "-framework",
        "IOKit",
        "-framework",
        "IOSurface",
    ],
    pagesize = "4096",
    sign_identifier = "com.brunostjohn.switch.ave",
)
