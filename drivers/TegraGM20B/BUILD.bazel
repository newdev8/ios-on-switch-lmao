load("//bazel/lint:defs.bzl", "lint_files")

# drivers/TegraGM20B: moved from out/native-a57/root-v1/tree/drivers/TegraGM20B by the layout move.
load("//kernel/rules:driver_flags.bzl", "GPU_C_FLAGS", "LINUX_RELAXATIONS")
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")
load("//kits/SwitchGM20BEmit:defs.bzl", "SWITCH_GM20B_EMIT_INCLUDES")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "gpu_sources",
    srcs = glob([
        "gpu_*.c",
        "gpu_*.h",
    ]),
)

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

kernel_driver(
    name = "TegraGM20B_nvkm",
    srcs = [":" + f for f in glob(["nouveau/**/*.c"])],
    # TegraGM20BComp.h: compression numbers shared with gpu_mem.c and test/gm20b_comp_test.cpp
    c_copts = GPU_C_FLAGS + LINUX_RELAXATIONS + [
        "-I",
        "{tree}/drivers/TegraGM20B",
    ],
    c_recipe = ":freestanding_c",
    hdr_deps = [
        "kits/SwitchLinux",
        "kits/SwitchMMIO",
    ],
    object_names = "path",
)

# The kernel's copy-engine pushes on kits/SwitchGM20BEmit, with XNU's C headers (the kit's), not the nouveau units' shim.
kernel_driver(
    name = "TegraGM20B_emit",
    srcs = [
        "TegraGM20BCopyEmit.c",
        "//kits/SwitchGM20BEmit:mesa/nouveau_copy_rect.c",
    ],
    c_copts = SWITCH_GM20B_EMIT_INCLUDES,
    hdr_deps = [
        "kits/SwitchGM20B",
        "kits/SwitchGM20BEmit",
    ],
    object_names = "path",
)

