host_test(
    name = "switch_display_memory_adapter_test",
    srcs = [
        "switch_display_memory_adapter_test.cpp",
        "//drivers/SwitchPower:SwitchDisplayBandwidth.h",
        "//drivers/SwitchPower:SwitchDisplayMemory.h",
        "//drivers/SwitchPower:SwitchDisplayMemoryMath.h",
        "//drivers/SwitchPower:SwitchDisplayMemoryRegisters.h",
        "//drivers/SwitchPower:SwitchDisplayMemoryState.h",
        "//drivers/SwitchPower:SwitchDisplayMemoryEMC.h",
        "//drivers/SwitchPower:SwitchEMCGovernor.h",
