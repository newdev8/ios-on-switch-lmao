# drivers/SwitchPower on the host:
#   switch_governor_test             SwitchGovernor.h, the CPU's on-demand clock governor: load traces in, operating
#                                    points out, with SwitchPerfGovernor.cpp's tunables as shipped; L4T's T210B01 CVB
#                                    table cut at Horizon's 1785 MHz, re-derived independently
#   switch_thermal_sensors_j181_test SwitchSensorModels.h's J181AP table: the 24B119 plist's services, nearest
#                                    measurements
#   switch_thermal_sensors_test      SwitchSensors.h, thermalmonitord's sensors: the J120AP plist's table, nearest
#                                    measurements, unit conversions, SOC_THERM fuse calibration against L4T's, CLTM
#   switch_thermal_tcal_test         the PMU tcal answer against thermalmonitord's correction and J181's skin model
#   switch_sensors_hid_source_test   the HID descriptor and IOHIDFamily vtable slots the sensors are published through
#   switch_emc_governor_test         SwitchEMCGovernor.h: the EMC rates used, ACTMON's watermarks and the governor's moves
#   switch_soctherm_window_test      SwitchSocThermWindow.h: SOC_THERM's one-degree LVL0 window and the groups' registers
#   switch_thermal_shutdown_test     software shutdown below the hardware trip, its RTC record, the reset cause decoding
#   switch_monotonic_base_test       SwitchMonotonicBase.h: kern.monotonicclock never reads below the previous boot's
# The headers are C: each is compiled as C11 with -Wconversion -Wsign-conversion in a harness (its static inline
# functions as exported ones) and driven by a GoogleTest test.
#
#   bazel test //drivers/SwitchPower/test:all
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_library", "host_test")

lint_files()

C_FLAGS = [
    "-O1",
    "-Wconversion",
    "-Wsign-conversion",
]

host_library(
    name = "switch_governor_harness",
    srcs = ["switch_governor_harness.c"],
    hdrs = [
        "switch_governor_harness.h",
        "//drivers/SwitchPower:SwitchGovernor.h",
    ],
    copts = C_FLAGS,
)

host_test(
    name = "switch_governor_test",
    srcs = [
        "switch_governor_test.cpp",
        # kBootFallbackSeconds, checked at compile time.
        "//drivers/SwitchPower:SwitchPerfGovernor.h",
    ],
    # The tunables, read as the kernel is built with them (a retune is tested as shipped).
    data = ["//drivers/SwitchPower:SwitchPerfGovernor.cpp"],
    deps = [":switch_governor_harness"],
)

host_library(
    name = "switch_thermal_sensors_harness",
    srcs = ["switch_thermal_sensors_harness.c"],
    hdrs = [
        "switch_thermal_sensors_harness.h",
        "//drivers/SwitchPower:SwitchGovernor.h",
        "//drivers/SwitchPower:SwitchSensorModels.h",
        "//drivers/SwitchPower:SwitchSensors.h",
    ],
    copts = C_FLAGS,
)

host_test(
    name = "switch_thermal_sensors_test",
    srcs = ["switch_thermal_sensors_test.cpp"],
    deps = [":switch_thermal_sensors_harness"],
)

host_test(
    name = "switch_thermal_sensors_j181_test",
    srcs = ["switch_thermal_sensors_j181_test.cpp"],
    deps = [":switch_thermal_sensors_harness"],
)

host_test(
    name = "switch_thermal_tcal_test",
    srcs = ["switch_thermal_tcal_test.cpp"],
    deps = [":switch_thermal_sensors_harness"],
)

host_test(
    name = "switch_sensors_hid_source_test",
    srcs = ["switch_sensors_hid_source_test.cpp"],
    data = [
        "//drivers/SwitchBrightness:SwitchALS.cpp",
        "//drivers/SwitchTouch:SwitchHIDDevice.cpp",
    ],
)

host_test(
    name = "switch_emc_governor_test",
    srcs = [
        "switch_emc_governor_test.cpp",
        "//drivers/SwitchPower:SwitchEMCGovernor.h",
    ],
)

host_test(
    name = "switch_soctherm_window_test",
    srcs = [
        "switch_soctherm_window_test.cpp",
        "//drivers/SwitchPower:SwitchSocThermWindow.h",
        "//drivers/SwitchPower:SwitchThermalLimits.h",
    ],
)

host_test(
    name = "switch_thermal_shutdown_test",
    srcs = [
        "switch_thermal_shutdown_test.cpp",
        "//diagnostics/switch:SwitchResetCause.h",
        "//drivers/SwitchPower:SwitchSocThermWindow.h",
        "//drivers/SwitchPower:SwitchThermalLimits.h",
        "//drivers/SwitchPower:SwitchThermalRecord.h",
    ],
)

host_test(
    name = "switch_monotonic_base_test",
    srcs = [
        "switch_monotonic_base_test.cpp",
        "//drivers/SwitchPower:SwitchMonotonicBase.h",
    ],
)

host_test(
    name = "switch_display_bandwidth_test",
    srcs = [
        "switch_display_bandwidth_test.cpp",
        "//drivers/SwitchPower:SwitchDisplayBandwidth.h",
    ],
)

host_test(
    name = "switch_display_memory_test",
    srcs = [
        "switch_display_memory_test.cpp",
        "//drivers/SwitchPower:SwitchDisplayMemory.h",
        "//drivers/SwitchPower:SwitchDisplayMemoryMath.h",
        "//drivers/SwitchPower:SwitchDisplayMemoryRegisters.h",
        "//drivers/SwitchPower:SwitchDisplayMemoryState.h",
    ],
