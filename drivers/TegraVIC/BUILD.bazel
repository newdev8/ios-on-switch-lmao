# drivers/TegraVIC: moved from out/native-a57/root-v1/tree/drivers/TegraVIC by the layout move.
load("//bazel/lint:defs.bzl", "lint_files")
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")
load("//kits/SwitchABI:defs.bzl", "switch_abi_bindings")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

kernel_driver(
    name = "TegraVIC",
    srcs = [
        "TegraVIC.cpp",
        "TegraVICCancel.cpp",
        "SwitchVICJobs.cpp",
        "SwitchVICEvents.cpp",
        "SwitchVICSemantics.cpp",
        "SwitchNativeSurface.cpp",
        "SwitchNativeGpuView.cpp",
        "SwitchNativeScanout.cpp",
        "SwitchVICScanoutConvert.cpp",
        "SwitchVICScanoutCompose.cpp",
        "SwitchVICMapping.cpp",
        "SwitchVICSurfaceBacking.cpp",
        "SwitchVICTransform.cpp",
        "SwitchVICTurn.cpp",
        "SwitchVICTurnRun.cpp",
        "SwitchVICEncodeInput.cpp",
        "SwitchVICSurfaceAccess.cpp",
        "SwitchVICBouncePool.cpp",
        "SwitchVICBounceSubmit.cpp",
        "SwitchVICKernelTest.cpp",
        "SwitchVICPitchProbe.cpp",
        "SwitchVICLayoutProbe.cpp",
        "SwitchVICFractionProbe.cpp",
        "SwitchVICPackedProbe.cpp",
        "SwitchVICTransposeProbe.cpp",
        "SwitchVICLargeProbe.cpp",
        "SwitchVICComposeProbe.cpp",
        "TegraVICPresent.cpp",
        "TegraVICSurface.cpp",
        "TegraVICUserClient.cpp",
        "original-bindings.S",
        "firmware.S",
    ],
    hdrs = ["//kernel/switch:include/switch/memory_attachment.h"],
    abi = ["IOSurface"],
    copts = [
        "-I",
        "{tree}/kernel/switch/include",
    ],
    hdr_deps = [
        "drivers/NativeMobileDisplay",
        "drivers/TegraGM20B",
        "drivers/TegraHost1x",
        "drivers/TegraSMMU",
        "kits/SwitchCAR",
        "kits/SwitchDMA",
        "kits/SwitchEngineGate",
        "kits/SwitchFalcon",
        "kits/SwitchMMIO",
        "kits/SwitchMath",
        "kits/SwitchRefusal",
        "kits/SwitchTime",
    ],
    stems = {
        "firmware.S": "vic_firmware",
        "original-bindings.S": "vic-original-bindings",
    },
)

# The IOSurface kext's functions every driver calls by address: TegraVIC's, the display's surface accessors and its
# hardware planes', and the GPU driver's prefault of new surfaces (one bindings file, since each table address is bound
# once in the kernel).
switch_abi_bindings(
    name = "original_bindings",
    out = "original-bindings.S",
    classes = [
        "//kits/SwitchABI:IOSurface",
        "//kits/SwitchABI:IOSurfaceSharedEvent",
    ],
    objects = [
        ":TegraVIC_cc",
        "//drivers/NativeMobileDisplay:NativeLegacyDisplay_cc",
        "//drivers/TegraGM20B:TegraGM20B_cc",
    ],
)
