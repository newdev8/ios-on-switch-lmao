load("@rules_rust//rust:defs.bzl", "rust_test")

# drivers/NativeMetal on the host:
#   limits_table_test       LimitsTable.h: the device's answers in the base class's limits table, past a field the base
#                           class reads elsewhere (21H461's minConstantBufferAlignmentBytes)
#   queue_priority_test     QueuePriority.h: the process's GPU priority from its Metal queues' (Core Animation's)
#   gpu_memory_release_test GpuMemoryRelease.h: the idle release waits for the command buffers in flight and comes at the
#                           deadline their drain sets; a release asked for (memory pressure's) runs with work in flight
#   image_filter_link_test  ImageFilterLink.h: Core Image's filter-function link request for the system's Metal compiler
#   native_artifact_seed_test  NativeComputeArtifactStorage.h: the process's own analyses, then the seed's packed ones
#                           (SWITCH_SEED_TREE=<an image's ngpu/addons> with --test_env also reads back some of a built seed's)
#   metallib_entries_test   MetallibEntries.h: a metallib's function list, which entries Metal answers as extern, and a
#                           function's patch from its TESS tag (Xcode's bytes for it)
#   metallib_slice_test     MetallibSlice.h: the AIR slice of a universal metallib each IPSW's Metal loads, on its own
#                           CoreImage.metallib and QuartzCore library
#   core_image_probe_test   the selected IPSW's Core Image libraries: the kernels Core Image asks ci_stdlib for first are
#                           ci_filters', so a real device misses there too (NBLibrary answers that miss as Metal does)
#   native_tess_modes_test  NativeMetalTessModes.rs: a tessellation state's SET_TESSELLATION_PARAMETERS, and its evaluation
#                           stage's module with the control stage's modes, as the raw path's direct compile needs them
#   journal_source_test     NativeBridgeMetalFrontend.mm: a raw-made state's journal line is written on the persist queue,
#                           not on its creating thread
#
#   bazel test //drivers/NativeMetal/test:all
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_test")

lint_files()

