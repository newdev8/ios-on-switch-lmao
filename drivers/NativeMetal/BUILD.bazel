# The Metal frontend over m2v that the TegraGM20B plugin links (//gpu:bundle), and the bridge's Rust sources.
# Owned by gpu/; the rest of this directory (Adreno/offline experiments) is not built.
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

# TwoPlaneStandIn.h is generated (TwoPlaneStandIn.sh from TwoPlaneStandIn.metal).
lint_files(exclude = ["TwoPlaneStandIn.h"])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "frontend_headers",
    srcs = [
        "AsyncPipelines.h",
        "GpuMemoryRelease.h",
        "ImageFilterLink.h",
        "LimitsTable.h",
        "MetallibEntries.h",
        "MetallibSlice.h",
        "NativeBridgeMetalFrontend.h",
        "NativeMetalArtifactCache.h",
        "NativeComputeArtifactStorage.h",
        "NativeComputeReflection.h",
        "QueuePriority.h",
        "SurfaceLayout.h",
        "SwitchFrameTimeline.h",
        "SwitchCompileReply.h",
        "TwoPlaneStandIn.h",
        "bridge/NativeMetalBridge.h",
        "bridge/NativeMetalBlend.h",
        "bridge/NativeMetalCompile.h",
        "bridge/NativeMetalDirect.h",
        "bridge/NativeMetalComputeArtifact.h",
        "bridge/NativeMetalObjects.h",
        "//kits/SwitchDMA:SwitchDcache.h",
        "//kits/SwitchSeedPack:SwitchSeedPack.h",
    ],
)

filegroup(
    name = "bridge_rust",
    srcs = [
        "bridge/NativeMetalBridge.rs",
        "bridge/NativeMetalCompile.rs",
        "bridge/NativeMetalDirect.rs",
        "bridge/NativeMetalDirectCompute.rs",
        "bridge/NativeMetalOffline.rs",
        "bridge/NativeMetalHeap.rs",
        "bridge/NativeMetalArguments.rs",
        "bridge/NativeMetalDirectTess.rs",
        "bridge/NativeMetalTessModes.rs",
        "bridge/NativeMetalComputeArtifact.rs",
        "bridge/NativeMetalArtifactCodec.rs",
        "bridge/NativeMetalReflection.rs",
        "bridge/NativeMetalVariants.rs",
        "bridge/NativeMetalFailure.rs",
        "bridge/NativeMetalFunctions.rs",
        "bridge/NativeMetalObjects.rs",
        "bridge/NativeMetalTarget.rs",
    ],
)
