# drivers/TegraDisplayFlip/TegraScanoutRing.h (window A's scanout buffers, latest frame wins) on the host:
#   scanout_ring_test    the ring against a model of DC A's frame-boundary latch: no frame written into a buffer DC A
#                        scans or may take, a ready frame on screen at the next boundary, every latch state read right,
#                        one late frame not leaving every later frame a frame behind (as it does with two buffers),
#                        one fallback to double buffering against a controller that ignores a replaced START_ADDR
#   direct_policy_test   direct scanout's replace/retire policy against Core Animation's three framebuffers
#                        and their recycling on swap completion; retire-at-offer is caught as the hazard
#   switch_deferred_scale_test   SwitchDeferredScale.h against surfaces, a decoder pool, a scaler and a display: every
#                        read of a deferred destination and every scanned frame shows the copy's bytes, holds balance
# NativeLegacyDisplay's use of both is guarded in drivers/NativeMobileDisplay/test.
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_test")

lint_files()

RING = "//drivers/TegraDisplayFlip:TegraScanoutRing.h"

host_test(
    name = "scanout_ring_test",
    srcs = [
        "scanout_ring_test.cpp",
        RING,
    ],
    copts = ["-Wno-unused-parameter"],
)

host_test(
    name = "direct_policy_test",
    srcs = [
        "direct_policy_test.cpp",
        RING,
    ],
    copts = ["-Wno-unused-parameter"],
)

host_test(
    name = "switch_deferred_scale_test",
    srcs = [
        "switch_deferred_scale_test.cpp",
        "//drivers/TegraDisplayFlip:SwitchDeferredScale.h",
    ],
)

host_test(
    name = "switch_display_priority_test",
    srcs = [
        "switch_display_priority_test.cpp",
        "//drivers/TegraDisplayFlip:SwitchDisplayPriority.h",
    ],
)
