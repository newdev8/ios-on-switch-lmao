load("//bazel/lint:defs.bzl", "lint_files")

# drivers/TegraHost1x: moved from out/native-a57/root-v1/tree/drivers/TegraHost1x by the layout move.
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

# TegraHost1x + TegraNVDEC: host1x syncpoints, the NVDEC falcon and its job engine;
# NVDEC's firmware by .incbin.
kernel_driver(
    name = "TegraHost1x",
    hdr_deps = [
        "drivers/ArmGIC",
        "drivers/TegraGM20B",
        "kits/SwitchCAR",
        "kits/SwitchDMA",
        "kits/SwitchIdle",
        "kits/SwitchMMIO",
        "kits/SwitchTime",
    ],
)
