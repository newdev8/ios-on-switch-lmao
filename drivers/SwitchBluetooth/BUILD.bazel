load("//bazel/lint:defs.bzl", "lint_files")

# drivers/SwitchBluetooth: moved from out/native-a57/root-v1/tree/drivers/SwitchBluetooth by the layout move.
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")
load("//kernel/rules:package.bzl", "ios_binary")

package(default_visibility = ["//visibility:public"])

lint_files(exclude = [
    "**/linux/**",
    "**/nouveau/**",
    "**/nvidia/**",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

# This package's headers (kernel_headers): what other drivers' hdr_deps name.
kernel_headers()

kernel_driver(
    name = "SwitchBluetooth",
    srcs = ["SwitchBluetooth.cpp"],
    hdr_deps = [
        "drivers/ArmGIC",
        "drivers/SwitchSuspend",
        "drivers/TegraAPBDMA",
        "kits/SwitchDMA",
        "kits/SwitchDT",
        "kits/SwitchMMIO",
        "kits/SwitchRefusal",
    ],
)

# BlueTool stand-in (off with switch-no-bt).
ios_binary(
    name = "BlueTool",
    srcs = ["BlueTool/BlueTool.c"],
    out = "build/switch-bluetooth/BlueTool",
    hdrs = ["//drivers/TegraGM20BMetal:compiler/SwitchShaderCompilerJetsam.h"],
    copts = [
        "-Os",
        "-Wall",
        "-Wextra",
        "-Werror",
    ] + select({
        # 24B119 sandboxes BlueTool, so only 21H461's stand-in can start joyconpaird and switch-appregd (BlueTool.c).
        "//ipsw:21H461": ["-DSWITCH_BLUETOOL_STARTS_HELPERS=1"],
        "//conditions:default": [],
    }),
    entitlements = select({
        "//ipsw:24B119": "BlueTool/BlueTool27.entitlements",
        "//conditions:default": "BlueTool/BlueTool.entitlements",
    }),
    sign_identifier = "com.apple.BlueTool",
)
