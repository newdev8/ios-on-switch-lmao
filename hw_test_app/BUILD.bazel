# The hardware test app (README.md): SwiftUI on iOS 17 and 27, its test media made at build time on the Mac.
load("@rules_apple//apple:macos.bzl", "macos_command_line_application")
load("@rules_apple//apple:resources.bzl", "apple_resource_group")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load("@rules_swift//swift:swift_interop_hint.bzl", "swift_interop_hint")
load("@rules_swift//swift:swift_library.bzl", "swift_library")
load("@rules_swift//swift:swift_test.bzl", "swift_test")
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_test")
load("//kernel/rules:package.bzl", "ios_binary")
load(":apps.bzl", "hwtest_app", "ios_arm64e")

package(default_visibility = ["//visibility:public"])

lint_files()

# Benchmarks and the pattern code run optimised in every profile; Swift 5 mode keeps strict concurrency checking out
# of test code that hands buffers between VideoToolbox's and Metal's callback threads.
SWIFT_COPTS = [
    "-O",
    "-swift-version",
    "5",
]

swift_library(
    name = "core",
    srcs = glob(["core/*.swift"]),
    copts = SWIFT_COPTS,
    module_name = "HWTestCore",
)

swift_library(
    name = "video",
    srcs = glob(["video/*.swift"]),
    copts = SWIFT_COPTS,
    module_name = "HWTestVideo",
    deps = [":core"],
)

# The GPU scenes (Metal, MPS, Core Image, IOSurface; no UIKit), so the host test runs them on the Mac's GPU too.
swift_library(
    name = "gpu",
    srcs = glob([
        "gpu/*.swift",
        "gpu/scenes/*.swift",
        "gpu/scenes27/*.swift",
        "gpu/x1/*.swift",
    ]),
    copts = SWIFT_COPTS,
    module_name = "HWTestGPU",
    deps = [":core"],
)

# Every GPU scene on this Mac's GPU against its CPU reference, the shaders compiled from source. Manual: it needs a Mac
# whose GPU runs Metal, which CI's runners may not have.
swift_test(
    name = "gpu_test",
    size = "small",
    srcs = glob(["host_gpu_tests/*.swift"]),
    copts = SWIFT_COPTS,
    data = glob(["shaders/*.metal"]),
    tags = ["manual"],
    deps = [
        ":core",
        ":gpu",
    ],
)

# Every clip and still image of core/Media.swift's tables, pinned in bazel/pinned/hw_test_app/media; core_test checks
# the list against the tables.
MEDIA = [
    "{}_{}.{}".format(
        codec,
        size,
        "ivf" if codec == "vp9" else "mp4",
    )
    for codec in [
        "h264",
        "hevc",
        "hevc_main10",
        "vp9",
    ]
    for size in [
        "720p",
        "1080p",
        "4k",
    ]
] + [
    "mpeg4_720p.mp4",
    "mpeg4_1080p.mp4",
    "mpeg2_720p.mp4",
    "mpeg2_1080p.mp4",
    "mpeg1_720p.mp4",
    "h264_paff_256p.mp4",
    "h264_mbaff_1080p.mp4",
] + [
    "hevc_alpha.mp4",
    "jpeg_420.jpg",
    "jpeg_422.jpg",
    "jpeg_444.jpg",
    "png.png",
    "heic.heic",
    "heic_grid.heic",
]

swift_test(
    name = "core_test",
    size = "small",
    srcs = glob(["host_tests/*.swift"]),
    copts = SWIFT_COPTS,
    data = [
        "//tools/benchloop:generated_batches.json",
        "//tools/benchloop:testdata/golden_batch.json",
        "//tools/benchloop:testdata/split_capture_batch.json",
    ],
    env = {
        "BENCH_GENERATED": "$(rlocationpath //tools/benchloop:generated_batches.json)",
        "BENCH_GOLDEN": "$(rlocationpath //tools/benchloop:testdata/golden_batch.json)",
        "BENCH_CAPTURE": "$(rlocationpath //tools/benchloop:testdata/split_capture_batch.json)",
        "HWTEST_MEDIA": " ".join(MEDIA),
    },
    deps = [":core"],
)

# --- The media generator --------------------------------------------------------------------------------------------
# Run by hand (README.md); manual, so no build needs the Mac's encoders, libvpx or libjpeg-turbo.
swift_interop_hint(
    name = "vpx_module",
    module_name = "SwitchVPX",
)

cc_library(
    name = "vpx",
    hdrs = ["media/switch_vpx.h"],
    aspect_hints = [":vpx_module"],
    tags = ["manual"],
    deps = ["@libvpx//:vpx"],
)

swift_interop_hint(
    name = "turbojpeg_module",
    module_name = "SwitchTurboJPEG",
)

cc_library(
    name = "turbojpeg",
    hdrs = ["media/switch_turbojpeg.h"],
    aspect_hints = [":turbojpeg_module"],
    tags = ["manual"],
    deps = ["@libjpeg_turbo//:turbojpeg"],
)

swift_library(
    name = "media_lib",
    srcs = glob(["media/*.swift"]),
    copts = SWIFT_COPTS,
    module_name = "MediaTool",
    tags = ["manual"],
    deps = [
        ":core",
        ":turbojpeg",
        ":video",
        ":vpx",
    ],
)

macos_command_line_application(
    name = "media_tool",
    minimum_os_version = "14.0",
    tags = ["manual"],
    deps = [":media_lib"],
)

# The raw pack corpus's Core Animation states this IPSW's QuartzCore makes (ca_states.py), which gpu.ca.sweep draws on
# the raw facade and on m2v.
py_binary(
    name = "ca_states_filter",
    srcs = ["ca_states.py"],
    main = "ca_states.py",
    deps = [
        "//drivers/TegraGM20BMetal:raw_pack",
        "//tools/gpu/shaders:metallib",
    ],
)

QC_TABLES = {kind: "//drivers/TegraGM20BMetal:raw/pack/ca/qc-" + kind + ".json" for kind in ("21H461", "24B119")}

genrule(
    name = "ca_states",
    srcs = [
        "//drivers/TegraGM20BMetal:precompile/corpus.log",
        "@ipsw//:crawl_qc",
    ] + select({"//ipsw:" + kind: [tables] for kind, tables in QC_TABLES.items()}),
    outs = ["ca_states.log"],
    cmd = select({
        "//ipsw:" + kind: "$(execpath :ca_states_filter) $(execpath //drivers/TegraGM20BMetal:precompile/corpus.log) " +
                          "$(execpath @ipsw//:crawl_qc) $(execpath " + tables + ") $@"
        for kind, tables in QC_TABLES.items()
    }),
    tools = [":ca_states_filter"],
)

# The states this device's QuartzCore asks for where the offline compilation manifest names another colour precision
# (ca_asked.py), which gpu.ca.asked_forms makes on the raw facade.
py_binary(
    name = "ca_asked_forms",
    srcs = ["ca_asked.py"],
    main = "ca_asked.py",
    deps = ["//drivers/TegraGM20BMetal:raw_pack"],
)

# The Core Animation states a device's logs named as made at run time, per IPSW kind (precompile/ca_names.py)
CA_NAMES = {"24B119": "//drivers/TegraGM20BMetal:precompile/ca-names/24B119.txt"}

genrule(
    name = "ca_asked",
    srcs = ["//drivers/TegraGM20BMetal:stage-tegra-gm20b-metal.py"] + select({
        "//ipsw:" + kind: [tables] + ([CA_NAMES[kind]] if kind in CA_NAMES else [])
        for kind, tables in QC_TABLES.items()
    }),
    outs = ["ca_asked.log"],
    cmd = select({
        "//ipsw:" + kind: "$(execpath :ca_asked_forms) $(execpath " + tables + ") " +
                          "$(execpath //drivers/TegraGM20BMetal:stage-tegra-gm20b-metal.py) $@" +
                          (" $(execpath " + CA_NAMES[kind] + ")" if kind in CA_NAMES else "")
        for kind, tables in QC_TABLES.items()
    }),
    tools = [":ca_asked_forms"],
)

py_test(
    name = "ca_states_test",
    size = "small",
    srcs = [
        "ca_states.py",
        "ca_states_test.py",
    ],
    data = [
        "//drivers/TegraGM20BMetal:precompile/corpus.log",
        "@ipsw//:crawl_qc",
    ] + QC_TABLES.values(),
    env = select({
        "//ipsw:" + kind: {
            "CA_BUILD": kind,
            "CA_CORPUS": "$(rootpath //drivers/TegraGM20BMetal:precompile/corpus.log)",
            "CA_LIBRARY": "$(rootpath @ipsw//:crawl_qc)",
            "CA_TABLES": "$(rootpath " + tables + ")",
        }
        for kind, tables in QC_TABLES.items()
    }),
    deps = [
        "//drivers/TegraGM20BMetal:raw_pack",
        "//tools/gpu/shaders:metallib",
    ],
)

# gpu.ca.sweep's reference for the build's IPSW: the corpus states drawn on a Mac's GPU with that IPSW's QuartzCore
# (core/CAGoldens.swift), written into goldens/ by `bazel run //hw_test_app:ca_goldens` (and with --config=ios27).
genrule(
    name = "ca_goldens_txt",
    srcs = select({
        "//ipsw:21H461": ["goldens/ca_21H461.txt"],
        "//ipsw:24B119": ["goldens/ca_24B119.txt"],
    }),
    outs = ["ca_goldens.txt"],
    cmd = "cp $< $@",
)

apple_resource_group(
    name = "ca_states_resources",
    resources = [
        ":ca_asked",
        ":ca_goldens_txt",
        ":ca_states",
    ],
)

# Rewrites goldens/ca_<build>.txt: every corpus state drawn on this Mac's GPU with the selected IPSW's QuartzCore
# (ca_goldens/CAGoldensWriter.swift). Run it after a harvest adds Core Animation states. Manual: it needs a Mac GPU.
swift_test(
    name = "ca_goldens",
    size = "medium",
    srcs = ["ca_goldens/CAGoldensWriter.swift"],
    copts = SWIFT_COPTS,
    data = [
        ":ca_states",
        "@ipsw//:crawl_qc",
    ],
    env = select({
        "//ipsw:" + kind: {
            "CA_BUILD": kind,
            "CA_LIBRARY": "$(rlocationpath @ipsw//:crawl_qc)",
            "CA_STATES": "$(rlocationpath :ca_states)",
        }
        for kind in ("21H461", "24B119")
    }),
    tags = ["manual"],
    deps = [
        ":core",
        ":gpu",
    ],
)

# The GPU scenes' pictures with no CPU model (SceneResult.picture) for the build's IPSW, which GPUSceneTest holds the
# Switch's to: drawn on a Mac's GPU with that IPSW's QuartzCore (scene_goldens/SceneGoldensWriter.swift) and written into
# goldens/ by `bazel run //hw_test_app:scene_goldens` (and with --config=ios27). Run it after changing a scene's picture.
# Manual: it needs a Mac GPU.
swift_test(
    name = "scene_goldens",
    size = "medium",
    srcs = ["scene_goldens/SceneGoldensWriter.swift"],
    copts = SWIFT_COPTS,
    data = glob(["shaders/*.metal"]) + ["@ipsw//:crawl_qc"],
    env = select({
        "//ipsw:" + kind: {
            "CA_BUILD": kind,
            "CA_LIBRARY": "$(rlocationpath @ipsw//:crawl_qc)",
        }
        for kind in ("21H461", "24B119")
    }),
    tags = ["manual"],
    deps = [
        ":core",
        ":gpu",
    ],
)

genrule(
    name = "scene_goldens_txt",
    srcs = select({
        "//ipsw:21H461": ["goldens/scenes_21H461.txt"],
        "//ipsw:24B119": ["goldens/scenes_24B119.txt"],
    }),
    outs = ["scene_goldens.txt"],
    cmd = "cp $< $@",
)

apple_resource_group(
    name = "scene_goldens_resources",
    resources = [":scene_goldens_txt"],
)

# An image compiled GPU-compressed (ASTC), which CoreUI hands Core Animation as texture data: the render server makes its
# texture over memory laid out by the device's texture layout (ui.compressed_image)
apple_resource_group(
    name = "compressed_assets",
    resources = glob(["assets/Compressed.xcassets/**"]),
)

apple_resource_group(
    name = "media_resources",
    strip_structured_resources_prefixes = ["hw_test_app"],
    structured_resources = ["@pinned//:hw_test_app/media/" + name for name in MEDIA],
)

