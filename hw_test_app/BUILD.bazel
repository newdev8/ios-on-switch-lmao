# metal.native.shared_texture_peer's second process (peer/texpeer.mm): debug boot packages stage it at /usr/bin/switch-texpeer;
# the 21H461 BlueTool stand-in starts it for the app, 24B119's launchd for its Mach service (com.brunostjohn.switch.texpeer.plist).
ios_binary(
    name = "switch-texpeer",
    srcs = ["peer/texpeer.mm"],
    out = "build/switch-hwtest/switch-texpeer",
