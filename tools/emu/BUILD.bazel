load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

# hekate's last steps on core 0 (hekate.py REGISTERS follow it in memory), a flat image at its IRAM address.
genrule(
    name = "regwrite",
    srcs = [
        "firmware/regwrite.S",
        "@xcode//:xcode.env",
    ],
    outs = ["regwrite.bin"],
    cmd = """
export DEVELOPER_DIR="$$(/usr/bin/sed -n 's/^DEVELOPER_DIR=//p' $(execpath @xcode//:xcode.env))"
/usr/bin/clang --target=aarch64-none-elf -c $(execpath firmware/regwrite.S) -o $(@D)/regwrite.o
$(execpath @llvm//:bin/ld.lld) -Ttext=0x40010000 -e _start $(@D)/regwrite.o -o $(@D)/regwrite.elf
$(execpath @llvm//:bin/llvm-objcopy) -O binary $(@D)/regwrite.elf $@
""",
    tags = ["requires-darwin"],
    tools = [
        "@llvm//:bin/ld.lld",
        "@llvm//:bin/llvm-objcopy",
    ],
)

py_library(
    name = "emu_lib",
    srcs = [
        "cache.py",
        "gpucheck.py",
        "gpulog.py",
        "hekate.py",
        "machine.py",
        "monitor.py",
        "msgbuf.py",
        "qemu.py",
        "qtest.py",
        "report.py",
        "sdcard.py",
    ],
    data = glob(
        ["patches/*.patch"],
        allow_empty = True,
    ) + [
        ":regwrite",
        ":mesa_classes",
    ],
    deps = [
        "//kits/SwitchGM20B:methods_lib",
        "//tools/install:lib",
    ],
)

# What gpulog.py names the GPU's methods with: Mesa's class headers and its method array lengths, GM20B's MME arrays'
# (limits.tsv) and the methods SwitchGM20BTegra.h adds.
filegroup(
    name = "mesa_classes",
    srcs = [
        "//kits/SwitchGM20B:SwitchGM20BTegra.h",
        "//kits/SwitchGM20B:caps/limits.tsv",
        "//third_party/mesa/src/nouveau/headers:class_parser.py",
    ] + [
        "//third_party/mesa/src/nouveau/headers:nvidia/classes/%s.h" % c
        for c in [
            "cl902d",
            "cla140",
            "clb06f",
            "clb0b5",
            "clb197",
            "clb1c0",
        ]
    ],
)

py_test(
    name = "gpucheck_test",
    srcs = ["gpucheck_test.py"],
    deps = [":emu_lib"],
)

py_test(
    name = "gpulog_test",
    srcs = ["gpulog_test.py"],
    deps = [":emu_lib"],
)

# bazel run //tools/emu:build: the patched tegra_qemu, built once per Mac (README.md).
py_binary(
    name = "build",
    srcs = ["build.py"],
    deps = [":emu_lib"],
)

# bazel run //tools/emu:check -- --kind=ios17|ios27 [--until launchd|gpu]: boot to a milestone, nonzero on a panic, a
# timeout or a failed GPU check.
py_binary(
    name = "check",
    srcs = ["check.py"],
    deps = [":boot_lib"],
)

py_test(
    name = "check_test",
    srcs = [
        "check.py",
        "check_test.py",
    ],
    deps = [":boot_lib"],
)

# Display controller A and the SMMU of the patched tegra_qemu under qtest, run from the shared emulator build of the
# current patches (bazel run //tools/emu:build makes it). A Mac that has never built tegra_qemu skips it.
py_test(
    name = "dc_test",
    srcs = ["dc_test.py"],
    tags = ["requires-darwin"],
    deps = [":emu_lib"],
)

py_test(
    name = "msgbuf_test",
    srcs = ["msgbuf_test.py"],
    deps = [":emu_lib"],
)

# bazel run //tools/emu:boot -- --kind=ios17|ios27 [--sd IMAGE] [--seconds N] (README.md).
py_library(
    name = "boot_lib",
    srcs = ["boot.py"],
    deps = [":emu_lib"],
)

py_test(
    name = "boot_test",
    srcs = ["boot_test.py"],
    deps = [":boot_lib"],
)

py_binary(
    name = "boot",
    srcs = ["boot.py"],
    deps = [":emu_lib"],
)
