diff --git a/hw/arm/tegra2/ahb/gpu/gm20b.h b/hw/arm/tegra2/ahb/gpu/gm20b.h
new file mode 100644
index 0000000..f4d450b
--- /dev/null
+++ b/hw/arm/tegra2/ahb/gpu/gm20b.h
@@ -0,0 +1,115 @@
+/*
+ * NVIDIA GM20B (Tegra X1 GPU) model: shared state of gpu.c, gm20b_falcon.c, gm20b_mmu.c and gm20b_fifo.c.
+ *
+ *  This program is free software; you can redistribute it and/or modify it
+ *  under the terms of the GNU General Public License as published by the
+ *  Free Software Foundation; either version 2 of the License, or
+ *  (at your option) any later version.
+ */
+#ifndef TEGRA_GM20B_H
+#define TEGRA_GM20B_H
+
+#include "hw/sysbus.h"
+#include "qemu/timer.h"
+
+#define GM20B_REGS_BYTES     0x1000000
+#define GM20B_BAR1_OFFSET    0x1000000
+#define GM20B_BAR_BYTES      0x2000000
+#define GM20B_CHANNELS       512
+#define GM20B_SUBCHANNELS    8
+
+enum { GM20B_PMU, GM20B_FECS, GM20B_GPCCS, GM20B_FALCONS };
+
+typedef struct GM20BFalcon {
+    const char *name;
+    hwaddr base;
+    uint32_t imem_bytes, dmem_bytes;
+    uint8_t *imem, *dmem;
+    uint32_t imemc[4], dmemc[8];
+    uint32_t cpuctl, irqstat, irqmask, irqdest;
+    uint32_t mailbox[2];
+    uint32_t bind_stat;
+    int starts;
+    bool lsf;          /* bootstrapped by the ACR: started through CPUCTL_ALIAS */
+    bool rtos;         /* the PMU's LS firmware is up and owns its queues */
+} GM20BFalcon;
+
+/* A channel's position in its pushbuffer between kicks: a method header may have data still to come, and an
+ * acquire that is not yet satisfied blocks the channel at that method. */
+typedef struct GM20BChannel {
+    bool faulted;
+    uint64_t seg_va;          /* the GPFIFO entry being executed: next dword's VA, dwords left */
+    uint32_t seg_left;
+    bool in_seg;
+    uint32_t mthd, subc, count, op;  /* the current method header's state */
+    uint32_t sem[4];          /* SEMAPHOREA..D */
+    uint32_t report[3];       /* 3D/compute SET_REPORT_SEMAPHORE_A..C */
+    uint32_t *ce;             /* MAXWELL_DMA_COPY_A methods, by offset / 4: the channel's copy context */
+    uint32_t class_of[GM20B_SUBCHANNELS];
+    uint64_t methods;
+} GM20BChannel;
+
+typedef struct tegra_gpu_state {
+    SysBusDevice parent_obj;
+    qemu_irq irq_stall;
+    qemu_irq irq_nonstall;
+    MemoryRegion iomem;
+    uint32_t *regs;
+    char *method_log_path;
+    FILE *method_log;
+    char *event_log_path;
+    FILE *event_log;
+    int64_t ptimer_offset;
+    QEMUTimer *ptimer_alarm;
+    QEMUTimer *host_poll;
+    GM20BFalcon falcon[GM20B_FALCONS];
+    bool acr_done;
+    uint32_t runlist_base, runlist_len[2];
+    GM20BChannel chan[GM20B_CHANNELS];
+    uint64_t faults;
+} tegra_gpu;
+
+#define GM20B_REG(s, off) ((s)->regs[(off) >> 2])
+
+/* PFIFO_INTR_0 bits the model raises */
+#define PFIFO_INTR_MMU_FAULT     (1u << 28)
+#define PFIFO_INTR_PBDMA         (1u << 29)
+#define PFIFO_INTR_CHANNEL_INTR  (1u << 31)
+
+/* MMU fault types (GK104+ NV_PFIFO_INTR_MMU_FAULT_INFO_TYPE) and the units and clients the model reports */
+enum { MMU_PDE = 0, MMU_PTE = 2, MMU_VA_LIMIT = 3, MMU_UNBOUND_INST = 4, MMU_RO = 6, MMU_APERTURE = 10 };
+enum { FAULT_UNIT_GR = 0x00, FAULT_UNIT_HOST0 = 0x07, FAULT_UNIT_CE2 = 0x1b };
+enum { FAULT_CLIENT_FE = 0x04, FAULT_CLIENT_HOST = 0x06, FAULT_CLIENT_CE2 = 0x19 };
+
+typedef struct GM20BAccess {
+    tegra_gpu *s;
+    uint64_t inst;            /* instance block of the space, for the fault record */
+    uint64_t pdb;             /* page directory: physical address */
+    bool big64k;
+    uint64_t limit;
+    unsigned unit, client;
+} GM20BAccess;
+
+void gm20b_update_irqs(tegra_gpu *s);
+uint64_t gm20b_ptimer_ns(tegra_gpu *s);
+void gm20b_log_event(tegra_gpu *s, const char *fmt, ...) G_GNUC_PRINTF(2, 3);
+
+void gm20b_falcon_init(tegra_gpu *s);
+void gm20b_falcon_reset(tegra_gpu *s);
+bool gm20b_falcon_read(tegra_gpu *s, hwaddr offset, uint32_t *value);
+bool gm20b_falcon_write(tegra_gpu *s, hwaddr offset, uint32_t value);
+bool gm20b_falcon_pending(tegra_gpu *s, unsigned id);
+void gm20b_falcon_engine_reset(tegra_gpu *s, uint32_t disabled);
+
+bool gm20b_access_init(tegra_gpu *s, GM20BAccess *a, uint64_t inst, unsigned unit, unsigned client);
+bool gm20b_vm_rw(GM20BAccess *a, uint64_t va, void *buf, uint32_t len, bool write);
+void gm20b_bar1_rw(tegra_gpu *s, uint64_t offset, uint64_t *value, unsigned size, bool write);
+
+void gm20b_fifo_reset(tegra_gpu *s);
+uint32_t gm20b_fifo_intr0(tegra_gpu *s);
+bool gm20b_fifo_read(tegra_gpu *s, hwaddr offset, uint32_t *value);
+bool gm20b_fifo_write(tegra_gpu *s, hwaddr offset, uint32_t value);
+void gm20b_fifo_kick(tegra_gpu *s);
+bool gm20b_ce_launch(tegra_gpu *s, GM20BAccess *a, const uint32_t *methods, uint32_t launch);
+
+#endif
diff --git a/hw/arm/tegra2/ahb/gpu/gm20b_ce.c b/hw/arm/tegra2/ahb/gpu/gm20b_ce.c
new file mode 100644
index 0000000..c18f885
--- /dev/null
+++ b/hw/arm/tegra2/ahb/gpu/gm20b_ce.c
@@ -0,0 +1,166 @@
+/*
+ * NVIDIA GM20B copy engine (MAXWELL_DMA_COPY_A): LAUNCH_DMA over pitch and block-linear surfaces, with remap.
+ *
+ *  This program is free software; you can redistribute it and/or modify it
+ *  under the terms of the GNU General Public License as published by the
+ *  Free Software Foundation; either version 2 of the License, or
+ *  (at your option) any later version.
+ */
+
+/*
+ * Method offsets and fields are Mesa's clb0b5.h. Block-linear is GM20B's: 64-byte by 8-row GOBs of 16-byte runs
+ * (x bit 5, y bits 2:1, x bit 4, y bit 0, x bits 3:0), blocks one GOB wide and 1 << height GOBs tall, row-major.
+ * Widths, origins and line lengths are in bytes, or in remapped elements with REMAP_ENABLE. Depth is one layer of
+ * GOBs (3D surfaces are not modelled); physical addressing (SRC_TYPE/DST_TYPE) reaches DRAM directly.
+ */
+
+#include "tegra_common.h"
+#include "sysemu/dma.h"
+#include "gm20b.h"
+
+#define M(off) (m[(off) / 4])
+
+typedef struct Surface {
+    uint64_t base;
+    bool pitch, physical;
+    uint32_t pitch_bytes;
+    uint32_t width, height, layer, block_rows_log2;
+    uint32_t origin_x, origin_y;
+} Surface;
+
+static uint32_t gob_offset(uint32_t x, uint32_t y)
+{
+    return ((x >> 5) & 1) << 8 | ((y >> 1) & 3) << 6 | ((x >> 4) & 1) << 5 | (y & 1) << 4 | (x & 15);
+}
+
+static uint64_t bl_address(const Surface *s, uint32_t x, uint32_t y)
+{
+    uint32_t rows = 8u << s->block_rows_log2, block = 512u << s->block_rows_log2;
+    uint64_t per_row = DIV_ROUND_UP(s->width, 64), layer = per_row * DIV_ROUND_UP(MAX(s->height, 1), rows) * block;
+
+    return s->base + s->layer * layer + (uint64_t)(y / rows) * per_row * block + (uint64_t)(x / 64) * block +
+           ((y % rows) / 8) * 512 + gob_offset(x % 64, y % 8);
+}
+
+static bool span(GM20BAccess *a, const Surface *s, uint64_t addr, void *buf, uint32_t len, bool write)
+{
+    if (s->physical) {
+        dma_memory_rw(&address_space_memory, addr, buf, len, write ? DMA_DIRECTION_FROM_DEVICE : DMA_DIRECTION_TO_DEVICE,
+                      MEMTXATTRS_UNSPECIFIED);
+        return true;
+    }
+    return gm20b_vm_rw(a, addr, buf, len, write);
+}
+
+static bool line_access(GM20BAccess *a, const Surface *s, uint32_t line, uint8_t *buf, uint32_t len, bool write)
+{
+    if (s->pitch)
+        return span(a, s, s->base + (uint64_t)line * s->pitch_bytes, buf, len, write);
+    for (uint32_t done = 0; done < len;) {
+        uint32_t x = s->origin_x + done, run = MIN(len - done, 16 - (x & 15));
+        if (!span(a, s, bl_address(s, x, s->origin_y + line), buf + done, run, write))
+            return false;
+        done += run;
+    }
+    return true;
+}
+
+static void surface(Surface *sf, const uint32_t *m, bool src, uint32_t launch, uint32_t scale)
+{
+    uint32_t block = src ? M(0x728) : M(0x70c), origin = src ? M(0x73c) : M(0x720);
+
+    sf->base = ((uint64_t)((src ? M(0x400) : M(0x408)) & 0xff) << 32) | (src ? M(0x404) : M(0x40c));
+    sf->pitch = launch & (src ? (1u << 7) : (1u << 8));
+    sf->physical = launch & (src ? (1u << 12) : (1u << 13));
+    sf->pitch_bytes = src ? M(0x410) : M(0x414);
+    sf->width = (src ? M(0x72c) : M(0x710)) * scale;
+    sf->height = src ? M(0x730) : M(0x714);
+    sf->layer = src ? M(0x738) : M(0x71c);
+    sf->block_rows_log2 = (block >> 4) & 0xf;
+    sf->origin_x = (origin & 0xffff) * scale;
+    sf->origin_y = origin >> 16;
+}
+
+/* SET_REMAP_COMPONENTS: each destination component takes a source component, constant A or B, or is not written */
+static void remap(const uint32_t *m, const uint8_t *src, uint8_t *dst, uint32_t elements, uint8_t *mask)
+{
+    uint32_t comp = M(0x708), size = ((comp >> 16) & 3) + 1;
+    uint32_t nsrc = ((comp >> 20) & 3) + 1, ndst = ((comp >> 24) & 3) + 1;
+
+    for (uint32_t e = 0; e < elements; e++) {
+        for (uint32_t c = 0; c < ndst; c++) {
+            uint32_t sel = (comp >> (c * 4)) & 7, k = (e * ndst + c) * size;
+            uint8_t konst[4];
+            stl_le_p(konst, sel == 4 ? M(0x700) : M(0x704));
+            if (sel <= 3)
+                memcpy(dst + k, src + (e * nsrc + MIN(sel, nsrc - 1)) * size, size);
+            else if (sel <= 5)
+                memcpy(dst + k, konst, size);
+            memset(mask + k, sel <= 5, size);
+        }
+    }
+}
+
+static bool reads_source(uint32_t comp, uint32_t ndst)
+{
+    for (uint32_t c = 0; c < ndst; c++)
+        if (((comp >> (c * 4)) & 7) <= 3)
+            return true;
+    return false;
+}
+
+static bool copy_line(GM20BAccess *a, const uint32_t *m, uint32_t launch, const Surface *src, const Surface *dst,
+                      uint32_t line, uint32_t length)
+{
+    bool remap_on = launch & (1u << 10);
+    uint32_t comp = M(0x708), size = ((comp >> 16) & 3) + 1, ndst = ((comp >> 24) & 3) + 1;
+    uint32_t src_bytes = remap_on ? length * size * (((comp >> 20) & 3) + 1) : length;
+    uint32_t dst_bytes = remap_on ? length * size * ndst : length;
+    g_autofree uint8_t *in = g_malloc0(src_bytes), *out = g_malloc0(dst_bytes), *mask = g_malloc0(dst_bytes);
+    g_autofree uint8_t *old = NULL;
+
+    if ((!remap_on || reads_source(comp, ndst)) && !line_access(a, src, line, in, src_bytes, false))
+        return false;
+    if (!remap_on)
+        return line_access(a, dst, line, in, dst_bytes, true);
+    remap(m, in, out, length, mask);
+    if (memchr(mask, 0, dst_bytes)) {
+        /* NO_WRITE components keep the destination's bytes */
+        old = g_malloc0(dst_bytes);
+        if (!line_access(a, dst, line, old, dst_bytes, false))
+            return false;
+        for (uint32_t i = 0; i < dst_bytes; i++)
+            out[i] = mask[i] ? out[i] : old[i];
+    }
+    return line_access(a, dst, line, out, dst_bytes, true);
+}
+
+static bool release(GM20BAccess *a, const uint32_t *m, tegra_gpu *s, uint32_t launch)
+{
+    unsigned type = (launch >> 3) & 3;
+    uint64_t va = ((uint64_t)(M(0x240) & 0xff) << 32) | M(0x244), now = gm20b_ptimer_ns(s);
+    uint32_t rec[4] = { cpu_to_le32(M(0x248)), 0, cpu_to_le32((uint32_t)now), cpu_to_le32(now >> 32) };
+
+    if (!type)
+        return true;
+    return gm20b_vm_rw(a, va, rec, type == 2 ? 16 : 4, true);
+}
+
+bool gm20b_ce_launch(tegra_gpu *s, GM20BAccess *a, const uint32_t *m, uint32_t launch)
+{
+    bool remap_on = launch & (1u << 10);
+    uint32_t comp = M(0x708), size = ((comp >> 16) & 3) + 1;
+    uint32_t src_scale = remap_on ? size * (((comp >> 20) & 3) + 1) : 1;
+    uint32_t dst_scale = remap_on ? size * (((comp >> 24) & 3) + 1) : 1;
+    uint32_t lines = (launch & (1u << 9)) ? M(0x41c) : 1;
+    Surface src, dst;
+
+    surface(&src, m, true, launch, src_scale);
+    surface(&dst, m, false, launch, dst_scale);
+    if ((launch & 3) && M(0x418)) {
+        for (uint32_t line = 0; line < lines; line++)
+            if (!copy_line(a, m, launch, &src, &dst, line, M(0x418)))
+                return false;
+    }
+    return release(a, m, s, launch);
+}
diff --git a/hw/arm/tegra2/ahb/gpu/gm20b_falcon.c b/hw/arm/tegra2/ahb/gpu/gm20b_falcon.c
new file mode 100644
index 0000000..116cb49
--- /dev/null
+++ b/hw/arm/tegra2/ahb/gpu/gm20b_falcon.c
@@ -0,0 +1,456 @@
+/*
+ * NVIDIA GM20B falcons as their firmware answers the host: PMU (ACR, then its RTOS), FECS and GPCCS.
+ *
+ *  This program is free software; you can redistribute it and/or modify it
+ *  under the terms of the GNU General Public License as published by the
+ *  Free Software Foundation; either version 2 of the License, or
+ *  (at your option) any later version.
+ */
+
+/*
+ * No falcon code runs. IMEM and DMEM are real memories behind the PIO ports, and each falcon's firmware is replaced by
+ * what it does for the host, as nouveau (nvkm/subdev/acr, pmu/gm20b.c, gr/gf100.c) and nvgpu expect it:
+ *  - PMU, first start: NVIDIA's HS ACR "load" ucode. It halts with MAILBOX0 0 and leaves the PMU, FECS and GPCCS in
+ *    LS mode (started through CPUCTL_ALIAS).
+ *  - PMU, second start: the LS RTOS. It posts its INIT message (queue layout) and answers ACR commands: WPR region
+ *    init and falcon bootstrap.
+ *  - FECS: the ctxsw firmware's handshake (CTXSW_MAILBOX(0) bit 0 once started) and its method interface (sizes,
+ *    bind pointer, golden save, ctxsw start/stop).
+ * Context images are not produced: the golden save leaves the buffer as the driver wrote it.
+ */
+
+#include "tegra_common.h"
+#include "qemu/log.h"
+#include "gm20b.h"
+
+#define F_IRQSSET   0x000
+#define F_IRQSCLR   0x004
+#define F_IRQSTAT   0x008
+#define F_IRQMSET   0x010
+#define F_IRQMCLR   0x014
+#define F_IRQMASK   0x018
+#define F_IRQDEST   0x01c
+#define F_MAILBOX0  0x040
+#define F_MAILBOX1  0x044
+#define F_CPUCTL    0x100
+#define F_HWCFG     0x108
+#define F_DMACTL    0x10c
+#define F_DMATRFCMD 0x118
+#define F_CPUCTL_ALIAS 0x130
+
+#define CPUCTL_STARTCPU  (1u << 1)
+#define CPUCTL_HALTED    (1u << 4)
+#define CPUCTL_ALIAS_EN  (1u << 6)
+#define IRQ_HALT         (1u << 4)
+#define IRQ_SWGEN0       (1u << 6)
+
+/* The PMU RTOS's queues in its DMEM (pmu/gm20b.c reads queue_info 0, 1 and 4) */
+#define PMU_CMDQ_HEAD   0x4a0
+#define PMU_CMDQ_TAIL   0x4b0
+#define PMU_MSGQ_HEAD   0x4c8
+#define PMU_MSGQ_TAIL   0x4cc
+#define PMU_QUEUE_BYTES 0x200
+static const uint16_t pmu_queue_offset[5] = { 0x1000, 0x1200, 0, 0, 0x1400 };
+
+#define UNIT_REWIND 0x00
+#define UNIT_INIT   0x07
+#define UNIT_ACR    0x0a
+#define ACR_CMD_INIT_WPR_REGION   0x00
+#define ACR_CMD_BOOTSTRAP_FALCON  0x01
+#define ACR_LSF_PMU   0
+#define ACR_LSF_FECS  2
+#define ACR_LSF_GPCCS 3
+
+/* FECS's answers to the discover methods: the sizes nvgpu logs for GM20B's ctxsw firmware */
+#define FECS_GOLDEN_BYTES  0x00030c00
+#define FECS_ZCULL_BYTES   0x00001500
+#define FECS_PM_BYTES      0x00008800
+#define FECS_REGLIST_BYTES 0x00000ad0
+
+static const struct {
+    const char *name;
+    hwaddr base;
+    uint32_t imem, dmem;
+} falcon_desc[GM20B_FALCONS] = {
+    [GM20B_PMU] = { "pmu", 0x10a000, 0x10000, 0x10000 },
+    [GM20B_FECS] = { "fecs", 0x409000, 0x8000, 0x2000 },
+    [GM20B_GPCCS] = { "gpccs", 0x41a000, 0x4000, 0x1400 },
+};
+
+void gm20b_falcon_init(tegra_gpu *s)
+{
+    for (unsigned i = 0; i < GM20B_FALCONS; i++) {
+        GM20BFalcon *f = &s->falcon[i];
+        f->name = falcon_desc[i].name;
+        f->base = falcon_desc[i].base;
+        f->imem_bytes = falcon_desc[i].imem;
+        f->dmem_bytes = falcon_desc[i].dmem;
+        f->imem = g_malloc0(f->imem_bytes);
+        f->dmem = g_malloc0(f->dmem_bytes);
+    }
+}
+
+void gm20b_falcon_reset(tegra_gpu *s)
+{
+    for (unsigned i = 0; i < GM20B_FALCONS; i++) {
+        GM20BFalcon *f = &s->falcon[i];
+        memset(f->imem, 0, f->imem_bytes);
+        memset(f->dmem, 0, f->dmem_bytes);
+        memset(f->imemc, 0, sizeof(f->imemc));
+        memset(f->dmemc, 0, sizeof(f->dmemc));
+        f->cpuctl = CPUCTL_HALTED;
+        f->irqstat = f->irqmask = f->irqdest = 0;
+        f->mailbox[0] = f->mailbox[1] = 0;
+        f->bind_stat = 0;
+        f->starts = 0;
+        f->lsf = f->rtos = false;
+    }
+    s->acr_done = false;
+}
+
+bool gm20b_falcon_pending(tegra_gpu *s, unsigned id)
+{
+    GM20BFalcon *f = &s->falcon[id];
+    uint32_t host = f->irqdest ? (f->irqdest & 0xffff) & ~(f->irqdest >> 16) : 0xffffffff;
+
+    return f->irqstat & f->irqmask & host;
+}
+
+static void dmem_write(GM20BFalcon *f, uint32_t at, const void *data, uint32_t len)
+{
+    if (at + len <= f->dmem_bytes)
+        memcpy(f->dmem + at, data, len);
+}
+
+static void dmem_read(GM20BFalcon *f, uint32_t at, void *data, uint32_t len)
+{
+    memset(data, 0, len);
+    if (at + len <= f->dmem_bytes)
+        memcpy(data, f->dmem + at, len);
+}
+
+static void msgq_post(tegra_gpu *s, const uint8_t *msg, uint32_t len)
+{
+    GM20BFalcon *f = &s->falcon[GM20B_PMU];
+    uint32_t head = GM20B_REG(s, f->base + PMU_MSGQ_HEAD);
+    uint32_t offset = pmu_queue_offset[4];
+
+    if (head + ROUND_UP(len, 4) > offset + PMU_QUEUE_BYTES)
+        head = offset;
+    dmem_write(f, head, msg, len);
+    GM20B_REG(s, f->base + PMU_MSGQ_HEAD) = head + ROUND_UP(len, 4);
+    f->irqstat |= IRQ_SWGEN0;
+}
+
+static void pmu_rtos_boot(tegra_gpu *s)
+{
+    uint8_t msg[42] = { UNIT_INIT, sizeof(msg), 0, 0, 0 /* NV_PMU_INIT_MSG_INIT */ };
+    GM20BFalcon *f = &s->falcon[GM20B_PMU];
+
+    for (unsigned q = 0; q < 5; q++) {
+        uint8_t *info = msg + 8 + q * 6;
+        stw_le_p(info, pmu_queue_offset[q] ? PMU_QUEUE_BYTES : 0);
+        stw_le_p(info + 2, pmu_queue_offset[q]);
+        info[4] = q == 4 ? 0 : q;
+    }
+    f->rtos = true;
+    /* The RTOS routes its message interrupt (SWGEN0) to the host itself: nouveau never programs IRQMSET/IRQDEST */
+    f->irqmask |= IRQ_SWGEN0;
+    f->irqdest = IRQ_SWGEN0;
+    GM20B_REG(s, f->base + PMU_MSGQ_TAIL) = pmu_queue_offset[4];
+    GM20B_REG(s, f->base + PMU_MSGQ_HEAD) = pmu_queue_offset[4];
+    for (unsigned q = 0; q < 2; q++) {
+        GM20B_REG(s, f->base + PMU_CMDQ_HEAD + q * 4) = pmu_queue_offset[q];
+        GM20B_REG(s, f->base + PMU_CMDQ_TAIL + q * 4) = pmu_queue_offset[q];
+    }
+    msgq_post(s, msg, sizeof(msg));
+}
+
+static void lsf_bootstrap(tegra_gpu *s, uint32_t id)
+{
+    unsigned which = id == ACR_LSF_FECS ? GM20B_FECS : id == ACR_LSF_GPCCS ? GM20B_GPCCS : GM20B_FALCONS;
+
+    if (which == GM20B_FALCONS)
+        return;
+    s->falcon[which].lsf = true;
+    s->falcon[which].cpuctl = CPUCTL_HALTED | CPUCTL_ALIAS_EN;
+}
+
+static void pmu_acr_command(tegra_gpu *s, const uint8_t *cmd)
+{
+    uint8_t reply[12] = { UNIT_ACR, 0, 0, cmd[3], cmd[4] };
+
+    gm20b_log_event(s, "pmu ACR command %u (falcon %u)", cmd[4], ldl_le_p(cmd + 12));
+    switch (cmd[4]) {
+    case ACR_CMD_INIT_WPR_REGION:
+        reply[1] = 12; /* error_code 0 */
+        break;
+    case ACR_CMD_BOOTSTRAP_FALCON:
+        lsf_bootstrap(s, ldl_le_p(cmd + 12));
+        stl_le_p(reply + 8, ldl_le_p(cmd + 12));
+        reply[1] = 12;
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "tegra.gpu: PMU ACR command 0x%x\n", cmd[4]);
+        reply[1] = 12;
+        stl_le_p(reply + 8, 1);
+        break;
+    }
+    msgq_post(s, reply, reply[1]);
+}
+
+static void pmu_cmdq(tegra_gpu *s, unsigned q)
+{
+    GM20BFalcon *f = &s->falcon[GM20B_PMU];
+    uint32_t head = GM20B_REG(s, f->base + PMU_CMDQ_HEAD + q * 4);
+    uint32_t tail = GM20B_REG(s, f->base + PMU_CMDQ_TAIL + q * 4);
+    uint8_t cmd[128];
+
+    for (unsigned guard = 0; tail != head && guard < 64; guard++) {
+        dmem_read(f, tail, cmd, sizeof(cmd));
+        if (cmd[0] == UNIT_REWIND) {
+            tail = pmu_queue_offset[q];
+            continue;
+        }
+        if (cmd[0] == UNIT_ACR)
+            pmu_acr_command(s, cmd);
+        else
+            qemu_log_mask(LOG_UNIMP, "tegra.gpu: PMU command for unit 0x%x\n", cmd[0]);
+        tail += ROUND_UP(MAX(cmd[1], 4), 4);
+    }
+    GM20B_REG(s, f->base + PMU_CMDQ_TAIL + q * 4) = tail;
+}
+
+static void falcon_start(tegra_gpu *s, unsigned id)
+{
+    GM20BFalcon *f = &s->falcon[id];
+
+    f->starts++;
+    gm20b_log_event(s, "%s start %d%s", f->name, f->starts, f->lsf ? " (LS)" : "");
+    if (id == GM20B_PMU && !s->acr_done) {
+        /* The HS ACR load: WPR set up, the LS falcons bootstrapped later on the RTOS's command */
+        s->acr_done = true;
+        f->lsf = true;
+        f->mailbox[0] = 0;
+        f->cpuctl = CPUCTL_HALTED | CPUCTL_ALIAS_EN;
+        f->irqstat |= IRQ_HALT;
+        return;
+    }
+    f->cpuctl = f->lsf ? CPUCTL_ALIAS_EN : 0;
+    if (id == GM20B_PMU)
+        pmu_rtos_boot(s);
+    else if (id == GM20B_FECS)
+        GM20B_REG(s, 0x409800) |= 1; /* CTXSW_MAILBOX(0): eUcodeHandshakeInitComplete */
+}
+
+static void fecs_method(tegra_gpu *s, uint32_t method)
+{
+    uint32_t data = GM20B_REG(s, 0x409500);
+
+    gm20b_log_event(s, "fecs method 0x%02x data 0x%08x", method, data);
+    switch (method) {
+    case 0x03: /* bind pointer */
+        GM20B_REG(s, 0x409b00) = data;
+        GM20B_REG(s, 0x409800) |= 0x10;
+        break;
+    case 0x09: /* WFI golden save */
+    case 0x15: /* restore golden */
+        GM20B_REG(s, 0x409800) |= 0x1;
+        break;
+    case 0x04: /* halt pipeline */
+    case 0x38: /* stop ctxsw */
+    case 0x39: /* start ctxsw */
+        GM20B_REG(s, 0x409804) = 0x1;
+        break;
+    case 0x10:
+        GM20B_REG(s, 0x409800) = FECS_GOLDEN_BYTES;
+        break;
+    case 0x16:
+        GM20B_REG(s, 0x409800) = FECS_ZCULL_BYTES;
+        break;
+    case 0x25:
+        GM20B_REG(s, 0x409800) = FECS_PM_BYTES;
+        break;
+    case 0x30:
+        GM20B_REG(s, 0x409800) = FECS_REGLIST_BYTES;
+        break;
+    case 0x31: /* set reglist bind instance */
+    case 0x32: /* set reglist virtual address */
+        GM20B_REG(s, 0x409800) = 0x1;
+        break;
+    case 0x21: /* set watchdog timeout */
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "tegra.gpu: FECS method 0x%x (data 0x%x)\n", method, data);
+        GM20B_REG(s, 0x409800) = 0x1;
+        break;
+    }
+}
+
+static GM20BFalcon *falcon_at(tegra_gpu *s, hwaddr offset, unsigned *id, uint32_t *reg)
+{
+    for (unsigned i = 0; i < GM20B_FALCONS; i++) {
+        if (offset >= s->falcon[i].base && offset < s->falcon[i].base + 0x1000) {
+            *id = i;
+            *reg = offset - s->falcon[i].base;
+            return &s->falcon[i];
+        }
+    }
+    return NULL;
+}
+
+/* IMEMC/IMEMD/IMEMT(port) at 0x180 + 0x10 * port, DMEMC/DMEMD(port) at 0x1c0 + 8 * port. Bit 24 of the control
+ * register advances the address after a write, bit 25 after a read. */
+static bool pio_access(GM20BFalcon *f, uint32_t reg, uint32_t *value, bool write)
+{
+    uint32_t *ctrl, bytes, at, sub;
+    uint8_t *mem;
+
+    if (reg >= 0x180 && reg < 0x1c0) {
+        ctrl = &f->imemc[(reg - 0x180) / 0x10];
+        sub = (reg - 0x180) % 0x10;
+        mem = f->imem;
+        bytes = f->imem_bytes;
+        if (sub == 8) /* IMEMT: tags are not kept */
+            return true;
+    } else if (reg >= 0x1c0 && reg < 0x200) {
+        ctrl = &f->dmemc[(reg - 0x1c0) / 8];
+        sub = (reg - 0x1c0) % 8;
+        mem = f->dmem;
+        bytes = f->dmem_bytes;
+    } else {
+        return false;
+    }
+    if (sub == 0) {
+        if (write)
+            *ctrl = *value;
+        else
+            *value = *ctrl;
+        return true;
+    }
+    if (sub != 4)
+        return false;
+    at = *ctrl & 0x00fffffc;
+    if (at + 4 <= bytes) {
+        if (write)
+            stl_le_p(mem + at, *value);
+        else
+            *value = ldl_le_p(mem + at);
+    }
+    if (*ctrl & (write ? (1u << 24) : (1u << 25)))
+        *ctrl = (*ctrl & ~0x00fffffcu) | ((at + 4) & 0x00fffffc);
+    return true;
+}
+
+/* PMC_ENABLE: an engine taken out of the enable mask is reset with its falcons (gm200_flcn_disable for the PMU, the
+ * GR reset for FECS and GPCCS); the PMU's next start is the HS ACR again. */
+void gm20b_falcon_engine_reset(tegra_gpu *s, uint32_t disabled)
+{
+    for (unsigned i = 0; i < GM20B_FALCONS; i++) {
+        GM20BFalcon *f = &s->falcon[i];
+        if (!(disabled & (i == GM20B_PMU ? 0x2000u : 0x1000u)))
+            continue;
+        f->cpuctl = CPUCTL_HALTED;
+        f->irqstat = 0;
+        f->lsf = f->rtos = false;
+        if (i == GM20B_PMU)
+            s->acr_done = false;
+    }
+}
+
+bool gm20b_falcon_read(tegra_gpu *s, hwaddr offset, uint32_t *value)
+{
+    unsigned id;
+    uint32_t reg;
+    GM20BFalcon *f = falcon_at(s, offset, &id, &reg);
+
+    if (!f)
+        return false;
+    if (pio_access(f, reg, value, false))
+        return true;
+    switch (reg) {
+    case F_IRQSTAT:
+        *value = f->irqstat;
+        return true;
+    case F_IRQMASK:
+        *value = f->irqmask;
+        return true;
+    case F_IRQDEST:
+        *value = f->irqdest;
+        return true;
+    case F_MAILBOX0:
+    case F_MAILBOX1:
+        *value = f->mailbox[(reg - F_MAILBOX0) / 4];
+        return true;
+    case F_CPUCTL:
+    case F_CPUCTL_ALIAS:
+        *value = f->cpuctl;
+        return true;
+    case F_HWCFG:
+        *value = (f->imem_bytes >> 8) | ((f->dmem_bytes >> 8) << 9);
+        return true;
+    case F_DMACTL:
+        *value = 0;
+        return true;
+    case F_DMATRFCMD:
+        *value = 0x2; /* idle */
+        return true;
+    case 0x20c:
+        if (id != GM20B_PMU)
+            return false;
+        *value = f->bind_stat << 12;
+        return true;
+    default:
+        return false;
+    }
+}
+
+bool gm20b_falcon_write(tegra_gpu *s, hwaddr offset, uint32_t value)
+{
+    unsigned id;
+    uint32_t reg;
+    GM20BFalcon *f = falcon_at(s, offset, &id, &reg);
+
+    if (!f)
+        return false;
+    if (pio_access(f, reg, &value, true))
+        return true;
+    switch (reg) {
+    case F_IRQSSET:
+        f->irqstat |= value;
+        return true;
+    case F_IRQSCLR:
+        f->irqstat &= ~value;
+        return true;
+    case F_IRQMSET:
+        f->irqmask |= value;
+        return true;
+    case F_IRQMCLR:
+        f->irqmask &= ~value;
+        return true;
+    case F_IRQDEST:
+        f->irqdest = value;
+        return true;
+    case F_MAILBOX0:
+    case F_MAILBOX1:
+        f->mailbox[(reg - F_MAILBOX0) / 4] = value;
+        return true;
+    case F_CPUCTL:
+    case F_CPUCTL_ALIAS:
+        if (value & CPUCTL_STARTCPU)
+            falcon_start(s, id);
+        return true;
+    default:
+        break;
+    }
+    GM20B_REG(s, offset) = value;
+    if (id == GM20B_PMU && reg == 0x480)
+        f->bind_stat = 5;
+    else if (id == GM20B_PMU && reg == 0x058 && (value & 2))
+        f->bind_stat = 0;
+    else if (id == GM20B_PMU && f->rtos && (reg == PMU_CMDQ_HEAD || reg == PMU_CMDQ_HEAD + 4))
+        pmu_cmdq(s, (reg - PMU_CMDQ_HEAD) / 4);
+    else if (id == GM20B_FECS && reg == 0x504)
+        fecs_method(s, value);
+    return true;
+}
diff --git a/hw/arm/tegra2/ahb/gpu/gm20b_fifo.c b/hw/arm/tegra2/ahb/gpu/gm20b_fifo.c
new file mode 100644
index 0000000..f2b4d44
--- /dev/null
+++ b/hw/arm/tegra2/ahb/gpu/gm20b_fifo.c
@@ -0,0 +1,464 @@
+/*
+ * NVIDIA GM20B host (PFIFO, one PBDMA): runlists, channels, GPFIFO and pushbuffer parsing, host methods, the copy
+ * engine, and the method log.
+ *
+ *  This program is free software; you can redistribute it and/or modify it
+ *  under the terms of the GNU General Public License as published by the
+ *  Free Software Foundation; either version 2 of the License, or
+ *  (at your option) any later version.
+ */
+
+/*
+ * Layouts (nouveau nvkm/engine/fifo/gk104.c, gk110.c; Mesa clb06f.h, clb0b5.h):
+ *  CCSR 0x800000 + 8 * chid: INST (bit 31 bound, 27:0 instance >> 12) and CHANNEL (bit 0 enabled; writes: bit 10 set,
+ *       bit 11 clear; bit 22 PBDMA faulted, 23 engine faulted).
+ *  RAMFC (instance block +0): +0x08/0x0c USERD, +0x48/0x4c GPFIFO base and log2 entries (bits 20:16 of +0x4c).
+ *  USERD: +0x88 GP_GET, +0x8c GP_PUT. GPFIFO entry: VA bits 39:2, length in dwords at bits 30:10 of the high word.
+ *  Runlist (0x2270 base, 0x2274 submit): 8-byte entries, bit 13 of word 0 marks a TSG header.
+ * The host runs a channel from GP_GET to GP_PUT whenever BAR1 is written or the poll timer fires, and keeps its place
+ * in a pushbuffer across an unsatisfied semaphore acquire. Every GPFIFO, pushbuffer and semaphore access is a GMMU
+ * access (gm20b_mmu.c): a bad VA faults the channel as the hardware does and the channel stops.
+ * Engine methods are logged, not executed, but for the semaphore releases of 3D, compute and copy, and the copy
+ * engine's copies and fills (pitch and block-linear, with remap), which the kernel's own channels depend on.
+ */
+
+#include "tegra_common.h"
+#include "qemu/log.h"
+#include "sysemu/dma.h"
+#include "host1x_syncpts.h"
+#include "gm20b.h"
+
+#define CCSR(chid)       (0x800000 + (chid) * 8)
+#define CHAN_ENABLED     (1u << 0)
+#define CHAN_ENABLE_SET  (1u << 10)
+#define CHAN_ENABLE_CLR  (1u << 11)
+#define CHAN_PBDMA_FAULT (1u << 22)
+#define CHAN_ENG_FAULT   (1u << 23)
+
+#define CLASS_HOST   0xb06f
+#define CLASS_COPY   0xb0b5
+#define CLASS_3D     0xb197
+#define CLASS_COMPUTE 0xb1c0
+
+#define POLL_NS      200000
+#define LOG_LINES_MAX 4000000
+
+typedef struct ChannelRun {
+    tegra_gpu *s;
+    unsigned chid;
+    GM20BChannel *c;
+    GM20BAccess host;
+    uint64_t userd;
+    uint64_t gp_base;
+    uint32_t gp_entries;
+    bool blocked;
+    bool stop;
+} ChannelRun;
+
+static uint64_t method_lines;
+
+static uint32_t phys_rd32(uint64_t pa)
+{
+    uint32_t v = 0;
+
+    dma_memory_read(&address_space_memory, pa, &v, 4, MEMTXATTRS_UNSPECIFIED);
+    return le32_to_cpu(v);
+}
+
+static void phys_wr32(uint64_t pa, uint32_t v)
+{
+    v = cpu_to_le32(v);
+    dma_memory_write(&address_space_memory, pa, &v, 4, MEMTXATTRS_UNSPECIFIED);
+}
+
+static void log_method(tegra_gpu *s, unsigned chid, unsigned subc, unsigned cls, uint32_t mthd, uint32_t data,
+                       const char *flag)
+{
+    if (!s->method_log && s->method_log_path && *s->method_log_path) {
+        s->method_log = fopen(s->method_log_path, "w");
+        if (s->method_log)
+            setvbuf(s->method_log, NULL, _IOFBF, 1 << 20);
+    }
+    if (!s->method_log || method_lines >= LOG_LINES_MAX)
+        return;
+    fprintf(s->method_log, "%u %u %04x %04x %08x%s%s\n", chid, subc, cls, mthd, data, flag ? " " : "", flag ? flag : "");
+    if (!(++method_lines & 0xfff))
+        fflush(s->method_log);
+}
+
+static void channel_fault(ChannelRun *r, uint32_t bit, const char *why)
+{
+    r->c->faulted = true;
+    r->stop = true;
+    GM20B_REG(r->s, CCSR(r->chid) + 4) |= bit;
+    gm20b_log_event(r->s, "channel %u stopped: %s", r->chid, why);
+}
+
+/* Semaphores (host SEMAPHORED, 3D/compute SET_REPORT_SEMAPHORE_D, copy LAUNCH_DMA): payload alone, or payload, zero
+ * and the PTIMER time in a 16-byte record. */
+static bool semaphore_release(ChannelRun *r, GM20BAccess *a, uint64_t va, uint32_t payload, bool four_words)
+{
+    uint32_t rec[4] = { cpu_to_le32(payload), 0 };
+    uint64_t now = gm20b_ptimer_ns(r->s);
+
+    rec[2] = cpu_to_le32((uint32_t)now);
+    rec[3] = cpu_to_le32(now >> 32);
+    if (gm20b_vm_rw(a, va, rec, four_words ? 16 : 4, true))
+        return true;
+    channel_fault(r, a == &r->host ? CHAN_PBDMA_FAULT : CHAN_ENG_FAULT, "semaphore release");
+    return false;
+}
+
+static int32_t reduce(unsigned op, uint32_t old, uint32_t v)
+{
+    switch (op) {
+    case 0: return MIN((int32_t)old, (int32_t)v);
+    case 1: return MAX((int32_t)old, (int32_t)v);
+    case 2: return old ^ v;
+    case 3: return old & v;
+    case 4: return old | v;
+    case 5: return old + v;
+    case 6: return old >= v ? 0 : old + 1;
+    case 7: return old == 0 || old > v ? v : old - 1;
+    default: return old;
+    }
+}
+
+/* SEMAPHORED: returns false when an acquire is not yet satisfied (the channel waits at this method) */
+static bool host_semaphore(ChannelRun *r, uint32_t d)
+{
+    GM20BChannel *c = r->c;
+    uint64_t va = ((uint64_t)(c->sem[0] & 0xff) << 32) | (c->sem[1] & ~3u);
+    uint32_t payload = c->sem[2], value = 0;
+    unsigned op = d & 0x1f;
+
+    if (op == 0x2) {
+        semaphore_release(r, &r->host, va, payload, !(d & (1u << 24)));
+        return true;
+    }
+    if (!gm20b_vm_rw(&r->host, va, &value, 4, false)) {
+        channel_fault(r, CHAN_PBDMA_FAULT, "semaphore acquire");
+        return true;
+    }
+    value = le32_to_cpu(value);
+    switch (op) {
+    case 0x1:
+        return value == payload;
+    case 0x4:
+        return (int32_t)(value - payload) >= 0;
+    case 0x8:
+        return (value & payload) != 0;
+    case 0x10:
+        value = cpu_to_le32(reduce((d >> 27) & 0xf, value, payload));
+        if (!gm20b_vm_rw(&r->host, va, &value, 4, true))
+            channel_fault(r, CHAN_PBDMA_FAULT, "semaphore reduction");
+        return true;
+    default:
+        log_method(r->s, r->chid, 0, CLASS_HOST, 0x1c, d, "INVALID_SEMAPHORE_OPERATION");
+        return true;
+    }
+}
+
+static bool host_method(ChannelRun *r, unsigned subc, uint32_t mthd, uint32_t data)
+{
+    GM20BChannel *c = r->c;
+
+    log_method(r->s, r->chid, subc, CLASS_HOST, mthd, data, NULL);
+    switch (mthd) {
+    case 0x00: /* SET_OBJECT */
+        c->class_of[subc] = data & 0xffff;
+        return true;
+    case 0x10: case 0x14: case 0x18:
+        c->sem[(mthd - 0x10) / 4] = data;
+        return true;
+    case 0x1c:
+        return host_semaphore(r, data);
+    case 0x20: /* NON_STALL_INTERRUPT */
+        GM20B_REG(r->s, 0x002100) |= PFIFO_INTR_CHANNEL_INTR;
+        gm20b_update_irqs(r->s);
+        return true;
+    case 0x74: /* SYNCPOINTB: increment (bit 0) the syncpoint in 15:8 */
+        if (data & 1)
+            host1x_incr_syncpt((data >> 8) & 0xff);
+        return true;
+    default:
+        return true;
+    }
+}
+
+/* SET_REPORT_SEMAPHORE_D: RELEASE writes the payload, REPORT_ONLY a zero report; ONE_WORD (bit 28) or four words */
+static void report_semaphore(ChannelRun *r, uint32_t d)
+{
+    GM20BAccess eng = r->host;
+    uint64_t va = ((uint64_t)(r->c->report[0] & 0xff) << 32) | r->c->report[1];
+
+    eng.unit = FAULT_UNIT_GR;
+    eng.client = FAULT_CLIENT_FE;
+    if ((d & 3) == 0 || (d & 3) == 2)
+        semaphore_release(r, &eng, va, (d & 3) == 2 ? 0 : r->c->report[2], !(d & (1u << 28)));
+}
+
+static void copy_method(ChannelRun *r, uint32_t mthd, uint32_t data)
+{
+    GM20BAccess ce = r->host;
+
+    if (!r->c->ce)
+        r->c->ce = g_malloc0(0x800);
+    r->c->ce[(mthd & 0x7fc) / 4] = data;
+    if (mthd != 0x300)
+        return;
+    ce.unit = FAULT_UNIT_CE2;
+    ce.client = FAULT_CLIENT_CE2;
+    if (!gm20b_ce_launch(r->s, &ce, r->c->ce, data))
+        channel_fault(r, CHAN_ENG_FAULT, "copy engine");
+}
+
+static bool engine_method(ChannelRun *r, unsigned subc, uint32_t mthd, uint32_t data)
+{
+    GM20BChannel *c = r->c;
+    unsigned cls = c->class_of[subc];
+
+    log_method(r->s, r->chid, subc, cls, mthd, data, cls ? NULL : "NO_CLASS_BOUND");
+    if (cls == CLASS_COPY && mthd < 0x800)
+        copy_method(r, mthd, data);
+    else if ((cls == CLASS_3D || cls == CLASS_COMPUTE) && mthd >= 0x1b00 && mthd < 0x1b0c)
+        c->report[(mthd - 0x1b00) / 4] = data;
+    else if ((cls == CLASS_3D || cls == CLASS_COMPUTE) && mthd == 0x1b0c)
+        report_semaphore(r, data);
+    return true;
+}
+
+static bool method(ChannelRun *r, unsigned subc, uint32_t mthd, uint32_t data)
+{
+    r->c->methods++;
+    return mthd < 0x100 ? host_method(r, subc, mthd, data) : engine_method(r, subc, mthd, data);
+}
+
+static bool fetch(ChannelRun *r, uint32_t *dword)
+{
+    if (gm20b_vm_rw(&r->host, r->c->seg_va, dword, 4, false)) {
+        *dword = le32_to_cpu(*dword);
+        return true;
+    }
+    channel_fault(r, CHAN_PBDMA_FAULT, "pushbuffer fetch");
+    return false;
+}
+
+static void advance(GM20BChannel *c)
+{
+    c->seg_va += 4;
+    c->seg_left--;
+}
+
+/* One header (Maxwell SEC_OP in bits 31:29), or one data dword of the current method */
+static void step(ChannelRun *r)
+{
+    GM20BChannel *c = r->c;
+    uint32_t dw;
+
+    if (!fetch(r, &dw))
+        return;
+    if (c->count) {
+        if (!method(r, c->subc, c->mthd, dw)) {
+            r->blocked = true;
+            return;
+        }
+        c->count--;
+        if (c->op == 1) {
+            c->mthd += 4;
+        } else if (c->op == 5) {
+            c->mthd += 4;
+            c->op = 3;
+        }
+        advance(c);
+        return;
+    }
+    advance(c);
+    c->op = dw >> 29;
+    c->subc = (dw >> 13) & 7;
+    c->mthd = (dw & 0xfff) << 2;
+    switch (c->op) {
+    case 1: case 3: case 5:
+        c->count = (dw >> 16) & 0x1fff;
+        break;
+    case 4:
+        if (!method(r, c->subc, c->mthd, (dw >> 16) & 0x1fff)) {
+            c->seg_va -= 4;
+            c->seg_left++;
+            r->blocked = true;
+        }
+        break;
+    case 7: /* END_PB_SEGMENT */
+        c->seg_left = 0;
+        break;
+    case 0:
+        if (!dw)
+            break;
+        /* fall through */
+    default:
+        log_method(r->s, r->chid, c->subc, 0, c->mthd, dw, "INVALID_OPCODE");
+        channel_fault(r, CHAN_PBDMA_FAULT, "invalid pushbuffer opcode");
+        break;
+    }
+}
+
+static bool next_entry(ChannelRun *r, uint32_t gp_get)
+{
+    GM20BChannel *c = r->c;
+    uint32_t e[2];
+
+    if (!gm20b_vm_rw(&r->host, r->gp_base + (uint64_t)gp_get * 8, e, 8, false)) {
+        channel_fault(r, CHAN_PBDMA_FAULT, "GPFIFO fetch");
+        return false;
+    }
+    c->seg_va = (le32_to_cpu(e[0]) & ~3u) | ((uint64_t)(le32_to_cpu(e[1]) & 0xff) << 32);
+    c->seg_left = (le32_to_cpu(e[1]) >> 10) & 0x1fffff;
+    c->in_seg = true;
+    c->count = 0;
+    return true;
+}
+
+static bool channel_setup(ChannelRun *r)
+{
+    uint64_t inst = (uint64_t)(GM20B_REG(r->s, CCSR(r->chid)) & 0x0fffffff) << 12;
+    uint32_t hi;
+
+    r->userd = (phys_rd32(inst + 0x08) & ~0x1ffu) | ((uint64_t)phys_rd32(inst + 0x0c) << 32);
+    r->gp_base = (phys_rd32(inst + 0x48) & ~7u) | ((uint64_t)((hi = phys_rd32(inst + 0x4c)) & 0xff) << 32);
+    r->gp_entries = 1u << ((hi >> 16) & 0x1f);
+    return gm20b_access_init(r->s, &r->host, inst, FAULT_UNIT_HOST0, FAULT_CLIENT_HOST);
+}
+
+/* Runs the channel until its GPFIFO is empty, it waits on an acquire or it faults; true if it still has work. */
+static bool run_channel(tegra_gpu *s, unsigned chid)
+{
+    ChannelRun r = { .s = s, .chid = chid, .c = &s->chan[chid] };
+    uint32_t gp_get, gp_put;
+    unsigned budget = 1 << 16;
+
+    if (r.c->faulted || !channel_setup(&r))
+        return false;
+    gp_get = phys_rd32(r.userd + 0x88);
+    gp_put = phys_rd32(r.userd + 0x8c);
+    while (!r.stop && !r.blocked && budget--) {
+        if (!r.c->in_seg || !r.c->seg_left) {
+            if (r.c->in_seg) {
+                r.c->in_seg = false;
+                gp_get = (gp_get + 1) % r.gp_entries;
+                phys_wr32(r.userd + 0x88, gp_get);
+            }
+            if (gp_get == (gp_put % r.gp_entries) || !next_entry(&r, gp_get))
+                break;
+            continue;
+        }
+        step(&r);
+    }
+    return r.blocked || (!r.stop && (r.c->in_seg || gp_get != gp_put % r.gp_entries));
+}
+
+void gm20b_fifo_kick(tegra_gpu *s)
+{
+    uint64_t base = (uint64_t)(s->runlist_base & 0x0fffffff) << 12;
+    bool busy = false;
+
+    for (uint32_t i = 0; s->runlist_base && i < s->runlist_len[0]; i++) {
+        uint32_t w0 = phys_rd32(base + i * 8);
+        unsigned chid = w0 & 0xfff;
+
+        if ((w0 & (1u << 13)) || chid >= GM20B_CHANNELS)
+            continue;
+        if ((GM20B_REG(s, CCSR(chid)) & 0x80000000) && (GM20B_REG(s, CCSR(chid) + 4) & CHAN_ENABLED))
+            busy |= run_channel(s, chid);
+    }
+    if (s->runlist_len[0])
+        timer_mod(s->host_poll, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + (busy ? POLL_NS / 4 : POLL_NS));
+}
+
+void gm20b_fifo_reset(tegra_gpu *s)
+{
+    for (unsigned i = 0; i < GM20B_CHANNELS; i++)
+        g_free(s->chan[i].ce);
+    memset(s->chan, 0, sizeof(s->chan));
+    s->runlist_base = 0;
+    s->runlist_len[0] = s->runlist_len[1] = 0;
+    timer_del(s->host_poll);
+}
+
+/* MMU_FAULT is not a latch: it stays set while any unit's MMU_FAULT_ID bit does (nouveau's handler clears only those). */
+uint32_t gm20b_fifo_intr0(tegra_gpu *s)
+{
+    return GM20B_REG(s, 0x002100) | (GM20B_REG(s, 0x00259c) ? PFIFO_INTR_MMU_FAULT : 0);
+}
+
+bool gm20b_fifo_read(tegra_gpu *s, hwaddr offset, uint32_t *value)
+{
+    if (offset >= CCSR(0) && offset < CCSR(GM20B_CHANNELS)) {
+        *value = GM20B_REG(s, offset);
+        return true;
+    }
+    switch (offset) {
+    case 0x002100:
+        *value = gm20b_fifo_intr0(s);
+        return true;
+    case 0x002284: /* runlist 0 info: never pending */
+    case 0x00228c:
+        *value = GM20B_REG(s, offset) & ~(1u << 20);
+        return true;
+    case 0x002634: /* preempt: never pending */
+        *value = GM20B_REG(s, offset) & ~(1u << 20);
+        return true;
+    case 0x002390: /* PBDMA 0 serves runlist 0 */
+        *value = 1;
+        return true;
+    default:
+        return false;
+    }
+}
+
+bool gm20b_fifo_write(tegra_gpu *s, hwaddr offset, uint32_t value)
+{
+    if (offset >= CCSR(0) && offset < CCSR(GM20B_CHANNELS)) {
+        unsigned chid = (offset - CCSR(0)) / 8;
+        if (offset & 4) {
+            uint32_t v = GM20B_REG(s, offset);
+            if (value & CHAN_ENABLE_SET)
+                v |= CHAN_ENABLED;
+            if (value & CHAN_ENABLE_CLR)
+                v &= ~CHAN_ENABLED;
+            if (value & (CHAN_PBDMA_FAULT | CHAN_ENG_FAULT))
+                s->chan[chid].faulted = false;
+            v &= ~(value & (CHAN_PBDMA_FAULT | CHAN_ENG_FAULT));
+            v = (v & ~0x000f0000u) | (value & 0x000f0000u);
+            GM20B_REG(s, offset) = v;
+        } else {
+            GM20B_REG(s, offset) = value;
+            if (!(value & 0x80000000)) {
+                g_free(s->chan[chid].ce);
+                memset(&s->chan[chid], 0, sizeof(s->chan[chid]));
+            }
+        }
+        return true;
+    }
+    switch (offset) {
+    case 0x000204: /* PBDMA enables: GM20B has one */
+        GM20B_REG(s, offset) = value & 1;
+        return true;
+    case 0x002100: /* PFIFO_INTR_0 */
+    case 0x00259c: /* MMU_FAULT_ID */
+        GM20B_REG(s, offset) &= ~value;
+        return true;
+    case 0x002270:
+        s->runlist_base = value;
+        GM20B_REG(s, offset) = value;
+        return true;
+    case 0x002274:
+        gm20b_log_event(s, "runlist %u submit: %u entries at 0x%" PRIx64, (value >> 20) & 0xf, value & 0xffff,
+                        (uint64_t)(s->runlist_base & 0x0fffffff) << 12);
+        s->runlist_len[MIN((value >> 20) & 0xf, 1u)] = value & 0xffff;
+        GM20B_REG(s, offset) = value;
+        gm20b_fifo_kick(s);
+        return true;
+    default:
+        return false;
+    }
+}
diff --git a/hw/arm/tegra2/ahb/gpu/gm20b_mmu.c b/hw/arm/tegra2/ahb/gpu/gm20b_mmu.c
new file mode 100644
index 0000000..926b6e4
--- /dev/null
+++ b/hw/arm/tegra2/ahb/gpu/gm20b_mmu.c
@@ -0,0 +1,174 @@
+/*
+ * NVIDIA GM20B GMMU: the two-level walk from an instance block's page directory, and MMU faults as PFIFO reports them.
+ *
+ *  This program is free software; you can redistribute it and/or modify it
+ *  under the terms of the GNU General Public License as published by the
+ *  Free Software Foundation; either version 2 of the License, or
+ *  (at your option) any later version.
+ */
+
+/*
+ * Formats (nouveau nvkm/subdev/mmu/vmmgf100.c, vmmgm200.c):
+ *  instance block +0x200: page directory, bits 1:0 aperture, 2 volatile, 11 big pages are 64 KiB (else 128 KiB),
+ *                         39:12 address; +0x208: the address limit.
+ *  PDE (8 bytes, one per 128 MiB or 64 MiB): low word the big-page table (aperture 1:0, address >> 8 in 31:4), high
+ *       word the 4 KiB-page table (same fields); bit 35 alone marks a sparse directory entry (GM20x).
+ *  PTE: bit 0 valid, 1 privileged, 2 read-only, address >> 8 in 31:4, bit 32 volatile, 34:33 aperture, kind 43:36.
+ *       An invalid PTE with only the volatile bit is sparse on GM20x: reads return zero, writes are dropped.
+ * There is no TLB: invalidates have nothing to drop, so a stale-translation bug cannot show here.
+ * A fault fills the unit's NV_PFIFO_INTR_MMU_FAULT_* record (instance, VA, type/client/access) and sets its bit in
+ * MMU_FAULT_ID, which PFIFO_INTR_0 MMU_FAULT reflects; a record that is still pending is kept, as the hardware keeps
+ * the first.
+ */
+
+#include "tegra_common.h"
+#include "sysemu/dma.h"
+#include "gm20b.h"
+
+#define VA_BITS 40
+
+static uint64_t phys_rd64(uint64_t pa)
+{
+    uint64_t v = 0;
+
+    dma_memory_read(&address_space_memory, pa, &v, 8, MEMTXATTRS_UNSPECIFIED);
+    return le64_to_cpu(v);
+}
+
+static const char *fault_type_name(unsigned type)
+{
+    static const char *const names[] = { "PDE", "PDE_SIZE", "PTE", "VA_LIMIT_VIOLATION", "UNBOUND_INST_BLOCK",
+                                         "PRIV_VIOLATION", "RO_VIOLATION", "WO_VIOLATION", "PITCH_MASK_VIOLATION",
+                                         "WORK_CREATION", "UNSUPPORTED_APERTURE", "COMPRESSION_FAILURE",
+                                         "UNSUPPORTED_KIND", "REGION_VIOLATION", "BOTH_PTES_VALID", "POISONED" };
+    return type < ARRAY_SIZE(names) ? names[type] : "?";
+}
+
+static void raise_fault(GM20BAccess *a, uint64_t va, unsigned type, bool write)
+{
+    tegra_gpu *s = a->s;
+    hwaddr rec = 0x002800 + a->unit * 0x10;
+
+    s->faults++;
+    gm20b_log_event(s, "fault unit 0x%02x client 0x%02x %s %s va 0x%010" PRIx64 " inst 0x%" PRIx64, a->unit,
+                    a->client, write ? "write" : "read", fault_type_name(type), va, a->inst);
+    if (GM20B_REG(s, 0x00259c) & (1u << a->unit))
+        return;
+    GM20B_REG(s, rec + 0x0) = a->inst >> 12;
+    GM20B_REG(s, rec + 0x4) = (uint32_t)va;
+    GM20B_REG(s, rec + 0x8) = va >> 32;
+    GM20B_REG(s, rec + 0xc) = type | (write ? 0x80 : 0) | 0x40 /* hub */ | (a->client << 8);
+    GM20B_REG(s, 0x00259c) |= 1u << a->unit;
+    gm20b_update_irqs(s);
+}
+
+bool gm20b_access_init(tegra_gpu *s, GM20BAccess *a, uint64_t inst, unsigned unit, unsigned client)
+{
+    uint64_t pd = phys_rd64(inst + 0x200);
+
+    a->s = s;
+    a->inst = inst;
+    a->unit = unit;
+    a->client = client;
+    a->pdb = pd & 0xfffffff000ull;
+    a->big64k = pd & (1u << 11);
+    a->limit = phys_rd64(inst + 0x208);
+    if (!a->pdb) {
+        raise_fault(a, 0, MMU_UNBOUND_INST, false);
+        return false;
+    }
+    return true;
+}
+
+typedef enum { XLATE_OK, XLATE_SPARSE, XLATE_FAULT } XlateResult;
+
+static XlateResult translate(GM20BAccess *a, uint64_t va, bool write, uint64_t *pa, uint64_t *page, unsigned *type)
+{
+    unsigned pd_shift = a->big64k ? 26 : 27, big_shift = a->big64k ? 16 : 17;
+    uint64_t in_pde = va & ((1ull << pd_shift) - 1);
+    uint64_t pde, pte = 0;
+    uint32_t lo, hi;
+
+    if (va >> VA_BITS || (a->limit && va > a->limit)) {
+        *type = MMU_VA_LIMIT;
+        return XLATE_FAULT;
+    }
+    pde = phys_rd64(a->pdb + (va >> pd_shift) * 8);
+    lo = pde, hi = pde >> 32;
+    if (hi & 3) {
+        pte = phys_rd64(((uint64_t)(hi & 0xfffffff0) << 8) + (in_pde >> 12) * 8);
+        *page = 1ull << 12;
+    }
+    if (!(pte & 1) && (lo & 3)) {
+        uint64_t big = phys_rd64(((uint64_t)(lo & 0xfffffff0) << 8) + (in_pde >> big_shift) * 8);
+        if ((big & 1) || !pte) {
+            pte = big;
+            *page = 1ull << big_shift;
+        }
+    }
+    if (!(lo & 3) && !(hi & 3)) {
+        *type = MMU_PDE;
+        return pde == (1ull << 35) ? XLATE_SPARSE : XLATE_FAULT;
+    }
+    if (!(pte & 1)) {
+        *type = MMU_PTE;
+        return pte == (1ull << 32) ? XLATE_SPARSE : XLATE_FAULT;
+    }
+    if (write && (pte & 4)) {
+        *type = MMU_RO;
+        return XLATE_FAULT;
+    }
+    *pa = ((uint64_t)(pte & 0xfffffff0) << 8) + (va & (*page - 1));
+    return XLATE_OK;
+}
+
+bool gm20b_vm_rw(GM20BAccess *a, uint64_t va, void *buf, uint32_t len, bool write)
+{
+    uint8_t *p = buf;
+
+    while (len) {
+        uint64_t pa = 0, page = 1ull << 12;
+        unsigned type = 0;
+        XlateResult r = translate(a, va, write, &pa, &page, &type);
+        uint32_t chunk = MIN(len, page - (va & (page - 1)));
+
+        if (r == XLATE_FAULT) {
+            raise_fault(a, va, type, write);
+            return false;
+        }
+        if (r == XLATE_SPARSE) {
+            if (!write)
+                memset(p, 0, chunk);
+        } else {
+            dma_memory_rw(&address_space_memory, pa, p, chunk, write ? DMA_DIRECTION_FROM_DEVICE : DMA_DIRECTION_TO_DEVICE,
+                          MEMTXATTRS_UNSPECIFIED);
+        }
+        p += chunk;
+        va += chunk;
+        len -= chunk;
+    }
+    return true;
+}
+
+/* BAR1: the CPU's window into the BAR1 address space (NV_PBUS_BAR1_BLOCK 0x1704). A write may be a channel's GP_PUT
+ * in USERD, so the host looks at its channels after every one. */
+void gm20b_bar1_rw(tegra_gpu *s, uint64_t offset, uint64_t *value, unsigned size, bool write)
+{
+    uint32_t block = GM20B_REG(s, 0x001704);
+    GM20BAccess a;
+    uint8_t buf[8] = {};
+
+    if (!(block & 0x80000000) || !gm20b_access_init(s, &a, (uint64_t)(block & 0x0fffffff) << 12, 0x04, 0x07)) {
+        if (!write)
+            *value = 0;
+        return;
+    }
+    if (write) {
+        stq_le_p(buf, *value);
+        gm20b_vm_rw(&a, offset, buf, size, true);
+        gm20b_fifo_kick(s);
+        return;
+    }
+    gm20b_vm_rw(&a, offset, buf, size, false);
+    *value = ldq_le_p(buf) & (size == 8 ? ~0ull : (1ull << (size * 8)) - 1);
+}
