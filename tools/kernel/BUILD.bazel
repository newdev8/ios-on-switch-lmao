# The kernel build's tools, one py_binary per job on the hermetic rules_python toolchain. kernel/rules's rules run
# them (run_tool in kernel/rules/common.bzl); nobody runs them by hand.
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")
load("//kernel/rules:common.bzl", "KERNEL_TOOLS")

package(default_visibility = ["//visibility:public"])

lint_files()

exports_files(["recipes.py"])

# Xcode environment, the path hygiene every compile shares (prefix maps, locale, ZERO_AR_DATE).
py_library(
    name = "common",
    srcs = ["common.py"],
    imports = ["."],
)

# The symbol names an archive defines (corecrypto's and libpthread's namespacing against the kernel's).
py_library(
    name = "kernel_names",
    srcs = ["kernel_names.py"],
    imports = ["."],
)

[py_binary(
    name = tool,
    srcs = [tool + ".py"],
    deps = [":common"] + {
        "corecrypto": [
            ":kernel_names",
            "//tools/common:macho",
        ],
        "libpthread": [
            ":kernel_names",
            "//tools/common:macho",
        ],
    }.get(tool, []),
) for tool in KERNEL_TOOLS]

# bazel run //tools/kernel:hdr_deps [-- --write]: every kernel_driver's hdr_deps against what its sources include.
py_binary(
    name = "hdr_deps",
    srcs = ["hdr_deps.py"],
    args = ["--buildifier=$(rootpath @buildifier//file)"],
    data = ["@buildifier//file"],
)

py_test(
    name = "libpthread_test",
    size = "small",
    srcs = [
        "libpthread.py",
        "libpthread_test.py",
    ],
    tags = ["requires-darwin"],
    deps = [
        ":common",
        ":kernel_names",
        "//tools/common:macho",
    ],
)
