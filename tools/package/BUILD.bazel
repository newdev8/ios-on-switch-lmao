# The boot entry's packaging steps, one py_binary each: //boot:package (boot/defs.bzl) runs every one as its own
# action, so an edit to one module reruns only the steps that import it.
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

py_library(
    name = "loader_abi",
    srcs = ["loader_abi.py"],
    imports = ["."],
)

py_library(
    name = "uimage",
    srcs = ["uimage.py"],
    imports = ["."],
)

py_library(
    name = "boot_config",
    srcs = ["boot_config.py"],
    imports = ["."],
)

py_library(
    name = "native_xnu_layout",
    srcs = ["native_xnu_layout.py"],
    imports = ["."],
)

py_library(
    name = "native_oled_adt",
    srcs = ["native_oled_adt.py"],
    imports = ["."],
    deps = [":loader_abi"],
)

py_library(
    name = "kernel_window",
    srcs = ["build_native_loader.py"],
    imports = ["."],
    deps = [
        ":loader_abi",
        ":native_oled_adt",
        ":native_xnu_layout",
    ],
)

py_binary(
    name = "boot_args",
    srcs = ["boot_args.py"],
)

# //boot:adt: the native OLED board's ADT with the pinned /chosen/random-seed.
py_binary(
    name = "adt",
    srcs = ["adt.py"],
    deps = [":native_oled_adt"],
)

py_binary(
    name = "overlay",
    srcs = ["overlay.py"],
    deps = [
        ":boot_config",
        "//tools/common:macho",
        "//tools/trustcache",
    ],
)

py_binary(
    name = "adt_edit",
    srcs = ["adt_edit.py"],
    deps = [
        ":boot_config",
        ":loader_abi",
        ":native_oled_adt",
        ":native_xnu_layout",
        "//tools/trustcache",
    ],
)

py_binary(
    name = "trust",
    srcs = ["trust.py"],
    deps = ["//tools/trustcache"],
)

py_binary(
    name = "window",
    srcs = ["build_native_loader.py"],
    main = "build_native_loader.py",
    deps = [":kernel_window"],
)

py_binary(
    name = "loader_link",
    srcs = ["loader_link.py"],
    deps = [
        ":loader_abi",
        ":uimage",
    ],
)

py_binary(
    name = "bl33",
    srcs = ["bl33.py"],
    deps = [
        ":kernel_window",
        ":loader_abi",
    ],
)

py_binary(
    name = "boot_script",
    srcs = ["boot_script.py"],
    deps = [
        ":loader_abi",
        ":uimage",
    ],
)

# Remakes bazel/pinned/overlay/wallpaper-1x/<kind>/*.plist (the kind's own iPad's iPadOS 17 and Lake wallpapers at the
# 'any' screen class) from the kind's OS volume image or its mounted root:
#   bazel run //tools/package:wallpaper_1x -- <kind> <OS volume .dmg or root> <output directory>
py_binary(
    name = "wallpaper_1x",
    srcs = ["wallpaper_1x.py"],
)

py_test(
    name = "native_profile_test",
    srcs = ["native_profile_test.py"],
    data = [
        "//boot:loader/copy.h",
        "//ipsw:pins.bzl",
        "//kernel/switch:include/switch/boot_layout.h",
        "//kernel/switch:ram/ram.c",
        "//kernel/xnu-10063.141.1/osfmk:arm64/start.s",
        "//kernel/xnu-12377.121.6/osfmk:arm64/start.s",
    ],
    deps = [
        ":kernel_window",
        ":loader_abi",
        ":native_xnu_layout",
    ],
)

# overlay.py's bundle entries (an .ipa's app staged whole, every Mach-O in it trusted) on a fabricated .ipa, and the
# Supplemental cryptex path's launchd-plists-only rule, on the real manifest too.
py_test(
    name = "overlay_test",
    size = "small",
    srcs = [
        "overlay.py",
        "overlay_test.py",
    ],
    data = ["//overlay:manifest.json"],
    imports = ["."],
    deps = [
        ":boot_config",
        "//tools/common:macho",
        "//tools/trustcache",
    ],
)

py_binary(
    name = "jetsam_overlay",
    srcs = ["jetsam_overlay.py"],
)

# The jetsam overlay in the build's profile: run it in both (--//bazel:profile=release too)
py_test(
    name = "jetsam_overlay_test",
    size = "small",
    srcs = [
        "jetsam_overlay.py",
        "jetsam_overlay_test.py",
    ],
    data = [
        "//hw_test_app:peer/com.brunostjohn.switch.texpeer.jetsam.plist",
        "//overlay:manifest.json",
        "//overlay:supplemental/com.apple.jetsamproperties.cryptex.plist",
        "//overlay:supplemental/com.brunostjohn.switch.shadercompiler.jetsam.plist",
    ],
    env = select({
        "//bazel:debug": {"SWITCH_PROFILE": "debug"},
        "//conditions:default": {"SWITCH_PROFILE": "release"},
    }),
    imports = ["."],
)

# The shader compiler's launch on each iOS version: 27's launchd plist and the jetsam properties overlay launchd takes
# its band and limits from (staged where launchd reads it, on 24B119 only), 17's BlueTool spawn, both held to
# SwitchShaderCompilerJetsam.h.
py_test(
    name = "shader_compiler_launch_test",
    size = "small",
    srcs = [
        "overlay.py",
        "shader_compiler_launch_test.py",
    ],
    data = [
        "//drivers/SwitchBluetooth:BlueTool/BlueTool.c",
        "//drivers/TegraGM20BMetal:compiler/SwitchShaderCompilerJetsam.h",
        "//overlay:manifest.json",
        "//overlay:overlay_sources",
    ],
    imports = ["."],
    deps = [
        ":boot_config",
        "//tools/common:macho",
        "//tools/trustcache",
    ],
)

py_test(
    name = "wallpaper_1x_test",
    srcs = [
        "wallpaper_1x.py",
        "wallpaper_1x_test.py",
    ],
    data = [
        "//bazel/pinned:overlay/wallpaper-1x/21H461/7560.Lake_Flat.plist",
        "//bazel/pinned:overlay/wallpaper-1x/21H461/7570.iPadOS_17_Flat.plist",
        "//bazel/pinned:overlay/wallpaper-1x/24B119/7560.Lake.plist",
        "//bazel/pinned:overlay/wallpaper-1x/24B119/7570.iPadOS_17.plist",
        "//overlay:manifest.json",
    ],
    imports = ["."],
)

# //boot:snapshot copies a build to ~/Library/Application Support/switch-ios/lkg/<name> (its py_binary lives in boot/).
exports_files([
    "adt_edit.py",
    "overlay.py",
    "snapshot.py",
])

# The packaging's modules, for the host tests (//tests), which import them.
filegroup(
    name = "sources",
    srcs = glob(["*.py"]),
)
