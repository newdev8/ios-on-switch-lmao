py_binary(
    name = "direct_build",
    srcs = ["direct/build.py"],
    main = "direct/build.py",
)

direct_runner(
    name = "direct_runner",
    srcs = [
        "direct/directrun.mm",
        "direct/exec.metal",
        "//drivers/TegraGM20BMetal:raw_runtime_headers",
        "//drivers/TegraGM20B:TegraGM20BClockABI.h",
        "//drivers/TegraGM20BMetal:raw_stack_sources",
        "//kits/SwitchGM20B:class_headers",
    ],
    host_bridge = "//gpu:bridge_host",
    metal_abi = "//drivers/NativeMetal/abi:MetalABI.h",
    tools = "//gpu/seed:local_tools",
)

py_test(
    name = "direct_exec_test",
    size = "medium",
    srcs = [
        "direct_exec_test.py",
        "direct_records.py",
    ],
    args = [
        "$(rootpath :direct_runner)",
        "$(rootpath //gpu/seed:local_tools)",
    ],
    data = [
        ":direct_runner",
        "//gpu/seed:local_tools",
    ],
    tags = [
        "no-remote-exec",
        "requires-darwin",
    ],
    deps = [
        ":interp",
        ":isa",
    ],
)
