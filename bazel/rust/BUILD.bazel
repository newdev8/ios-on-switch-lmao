# Rust for every crate the build compiles (rules_rust): which rustc, and how hard it optimizes.
#
#   //bazel/rust:toolchain_version   the rustc release (MODULE.bazel registers one toolchain set per value, each gated by
#                                    its config_setting below): 1.98.0 for m2v and the Metal bridge, 1.96.1 for NVK's
#                                    Rust (NAK and NIL), which Mesa's own build compiled with. A target transitions to the
#                                    version it was written for; nothing sets it on the command line.
load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

# rules_rust 0.75.0 with our changes (MODULE.bazel's single_version_override).
exports_files([
    "Cargo.lock",
    "crates.MODULE.bazel",
    "crates.lock.json",
    "rules_rust.patch",
])

string_flag(
    name = "toolchain_version",
    build_setting_default = "1.98.0",
    values = [
        "1.98.0",
        "1.96.1",
    ],
)

config_setting(
    name = "toolchain_1.98.0",
    flag_values = {":toolchain_version": "1.98.0"},
)

config_setting(
    name = "toolchain_1.96.1",
    flag_values = {":toolchain_version": "1.96.1"},
)

# Xcode's DEVELOPER_DIR and SDK paths (the declared host input, bazel/host), for build scripts that run the C compiler
# (sha2-asm's, crates.MODULE.bazel): a label in this repository, which crate_universe's repositories can name.
alias(
    name = "xcode_env",
    actual = "@xcode//:xcode.env",
)
