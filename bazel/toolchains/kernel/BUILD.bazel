# The kernel's C/C++/assembly toolchain (config.bzl): Apple clang with XNU's compile recipes as features, for
# //bazel/platforms:ios_kernel_arm64. Registered in MODULE.bazel; the kernel's cc targets reach it through
# kernel_driver's transition (kernel/rules/kernel.bzl).
#
#   bazel run //bazel/toolchains/kernel:update_recipes    regenerate recipes.bzl from the native XNU build's tables
load("@rules_cc//cc/toolchains:cc_toolchain.bzl", "cc_toolchain")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")
load(":config.bzl", "kernel_cc_toolchain_config")

package(default_visibility = ["//visibility:public"])

# recipes.bzl and recipes_release.bzl are generated (update_recipes), not formatted by hand.
lint_files(exclude = [
    "recipes.bzl",
    "recipes_12377.bzl",
    "recipes_12377_release.bzl",
    "recipes_release.bzl",
])

kernel_cc_toolchain_config(
    name = "config",
    sdk = "//kernel:sdk",
    # The main repository's top-level directories with kernel sources (the drivers' tree, the pinned bindings).
    source_roots = [
        "bazel",
        "out",
    ],
)

# Xcode's identity is an input of every compile (a new Xcode re-keys them all); the headers come from the targets'
# CcInfo (//kernel:sdk and the drivers' own), so .d files prune them per object.
filegroup(
    name = "files",
    srcs = ["@xcode//:identity"],
)

cc_toolchain(
    name = "cc_toolchain",
    all_files = ":files",
    ar_files = ":files",
    as_files = ":files",
    compiler_files = ":files",
    dwp_files = ":files",
    linker_files = ":files",
    objcopy_files = ":files",
    strip_files = ":files",
    supports_param_files = False,
    toolchain_config = ":config",
)

toolchain(
    name = "toolchain",
    exec_compatible_with = [
        "@platforms//os:osx",
        "@platforms//cpu:arm64",
    ],
    target_compatible_with = ["//bazel/platforms:kernel"],
    toolchain = ":cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

# recipes.bzl (DEVELOPMENT) and recipes_release.bzl (RELEASE) from the native XNU build's tables (each recipe: the XNU
# object whose flags a driver compiles with), and the check that they are current: it fails after a change to those
# tables, or a new Xcode whose clang driver appends other flags; run update_recipes and commit.
XNU = "kernel/xnu-10063.141.1"

RECIPES = [
    "--recipe=iokit_cxx=iokit/Kernel/IOPlatformExpert.cpp",
    "--recipe=iokit_cxx_generic=iokit/Kernel/IOPlatformExpert.cpp:drop=-mcpu=:drop=-march=:drop=-flto",
    "--recipe=osfmk_c=osfmk/arm/arm_init.c",
    "--recipe=bsd_c=bsd/kern/bsd_init.c:keep_warnings",
    "--recipe=mockfs_c=bsd/vfs/vfs_conf.c:keep_warnings:drop=-DMOCKFS=:drop=-UMOCKFS",
    "--recipe=freestanding_c=osfmk/arm/arm_init.c:strip_includes",
]

RECIPE_TABLES = [
    "//{}/config:recipes_development.bzl".format(XNU),
    "//{}/config:recipes_release.bzl".format(XNU),
    "//{}/bsd:objects.bzl".format(XNU),
    "//{}/iokit:objects.bzl".format(XNU),
    "//{}/osfmk:objects.bzl".format(XNU),
    "@xcode//:xcode.env",
]

py_test(
    name = "recipes_test",
    size = "small",
    srcs = ["//tools/kernel:recipes.py"],
    args = [
        "--check",
        "--tables=" + XNU,
        "--xcode-env=$(rootpath @xcode//:xcode.env)",
        "--out=DEVELOPMENT=$(rootpath :recipes.bzl)",
        "--out=RELEASE=$(rootpath :recipes_release.bzl)",
    ] + RECIPES,
    data = [
        ":recipes.bzl",
        ":recipes_release.bzl",
    ] + RECIPE_TABLES,
    main = "//tools/kernel:recipes.py",
    tags = ["requires-darwin"],
    deps = ["//tools/kernel:common"],
)

py_binary(
    name = "update_recipes",
    srcs = ["//tools/kernel:recipes.py"],
    args = [
        "--tables=" + XNU,
        "--xcode-env=$(rootpath @xcode//:xcode.env)",
        "--out=DEVELOPMENT=bazel/toolchains/kernel/recipes.bzl",
        "--out=RELEASE=bazel/toolchains/kernel/recipes_release.bzl",
    ] + RECIPES,
    data = RECIPE_TABLES,
    main = "//tools/kernel:recipes.py",
    deps = ["//tools/kernel:common"],
)

# The 12377 recipes use its iOS 26 target. At an
# iOS 26+ target Apple clang's arm64 is an A12 and -march=armv8-a does not undo it: the generic C++ recipe keeps -mcpu.
XNU_12377 = "kernel/xnu-12377.121.6"

RECIPES_12377 = [r.replace(":drop=-mcpu=", "") for r in RECIPES] + ["--ios-min=26.0"]

RECIPE_TABLES_12377 = [
    "//{}/config:recipes_development.bzl".format(XNU_12377),
    "//{}/config:recipes_release.bzl".format(XNU_12377),
    "//{}/bsd:objects.bzl".format(XNU_12377),
    "//{}/iokit:objects.bzl".format(XNU_12377),
    "//{}/osfmk:objects.bzl".format(XNU_12377),
    "@xcode//:xcode.env",
]

py_test(
    name = "recipes_12377_test",
    size = "small",
    srcs = ["//tools/kernel:recipes.py"],
    args = [
        "--check",
        "--tables=" + XNU_12377,
        "--xcode-env=$(rootpath @xcode//:xcode.env)",
        "--out=DEVELOPMENT=$(rootpath :recipes_12377.bzl)",
        "--out=RELEASE=$(rootpath :recipes_12377_release.bzl)",
    ] + RECIPES_12377,
    data = [
        ":recipes_12377.bzl",
        ":recipes_12377_release.bzl",
    ] + RECIPE_TABLES_12377,
    main = "//tools/kernel:recipes.py",
    tags = ["requires-darwin"],
    deps = ["//tools/kernel:common"],
)

py_binary(
    name = "update_recipes_12377",
    srcs = ["//tools/kernel:recipes.py"],
    args = [
        "--tables=" + XNU_12377,
        "--xcode-env=$(rootpath @xcode//:xcode.env)",
        "--out=DEVELOPMENT=bazel/toolchains/kernel/recipes_12377.bzl",
        "--out=RELEASE=bazel/toolchains/kernel/recipes_12377_release.bzl",
    ] + RECIPES_12377,
    data = RECIPE_TABLES_12377,
    main = "//tools/kernel:recipes.py",
    deps = ["//tools/kernel:common"],
)
