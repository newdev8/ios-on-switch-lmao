# The platforms ios-on-switch-lmao builds for. Toolchain resolution picks the C/C++ toolchain (bazel/toolchains) from the target
# platform; rules whose outputs belong to one platform move their dependencies there with a transition
# (bazel/platforms/transitions.bzl), so `bazel build //:boot` builds each part for the right platform.
#
#   ios_kernel_arm64   the kernel: XNU and the drivers (arm64, -mkernel; bazel/toolchains/kernel)
#   ios_arm64          iOS user space: the Metal plugin, the overlay's binaries (bazel/toolchains/apple)
#   macos_user_arm64   macOS user space as iOS user space builds: host twins of iOS code, e.g. NVK's (bazel/toolchains/apple)
#   macos_arm64        this Mac: host tests and tools (the host toolchain)
load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@xcode//:defs.bzl", "XCODE_BUILD")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

# Which ABI the code runs under. Kernel cc targets carry target_compatible_with = [":kernel"], so a host-configured
# `bazel build //...` skips them; they are built through the kernel rules' transition instead.
constraint_setting(name = "abi")

constraint_value(
    name = "kernel",
    constraint_setting = ":abi",
)

constraint_value(
    name = "user",
    constraint_setting = ":abi",
)

constraint_value(
    name = "host",
    constraint_setting = ":abi",
)

platform(
    name = "ios_kernel_arm64",
    constraint_values = [
        "@platforms//os:ios",
        "@platforms//cpu:arm64",
        ":kernel",
    ],
)

platform(
    name = "ios_arm64",
    constraint_values = [
        "@platforms//os:ios",
        "@platforms//cpu:arm64",
        ":user",
    ],
)

# The host twin of iOS user-space code: the same toolchain recipe for macOS (target and SDK only), unlike the host's.
platform(
    name = "macos_user_arm64",
    constraint_values = [
        "@platforms//os:osx",
        "@platforms//cpu:arm64",
        ":user",
    ],
)

platform(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:osx",
        "@platforms//cpu:arm64",
        ":host",
    ],
)

# Where every action runs: this Mac, or a Mac remote worker (--config=rbe, tools/remote) that advertises exactly these
# properties and has this Xcode build at the same path. The properties are part of every action's remote cache key
# whichever of the two runs it, so both share one set of entries.
platform(
    name = "exec_darwin_arm64",
    constraint_values = [
        "@platforms//os:osx",
        "@platforms//cpu:arm64",
    ],
    exec_properties = {
        "ISA": "arm64",
        "OSFamily": "darwin",
        "xcode": XCODE_BUILD,
    },
)

# The platforms a kernel_transition came from (bazel/platforms/transitions.bzl); empty outside the kernel's compiles.
string_flag(
    name = "outer",
    build_setting_default = "",
)
