# Tegra210 CAR clocks and resets and PMC power partitions and pads, one copy of their registers and lock; the UPHY PLL's
# calibration announcements between PCIe and SuperSpeed USB (SwitchUPHY.h); the PLLs L4T clocks NVDEC, NVENC and NVJPG
# from (SwitchEngineClock.h).
#
#   bazel test //kits/SwitchCAR/test:all
load("//bazel/lint:defs.bzl", "lint_files")
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")

package(default_visibility = ["//visibility:public"])

lint_files()

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

kernel_headers()

kernel_driver(
    name = "SwitchCAR",
    srcs = [
        "SwitchCAR.cpp",
        "SwitchEngineClock.cpp",
        "SwitchUPHY.cpp",
    ],
    hdr_deps = ["kits/SwitchMMIO"],
)
