# Mesa's Fermi MME decoder and simulator, from Mesa's tree (raw/pack/mesa holds a copy of the same files).
host_library(
    name = "mesa_mme_sim",
    srcs = [
        MESA_MME + "mme_fermi.c",
        MESA_MME + "mme_fermi_sim.c",
        "//kits/SwitchGM20BEmit:nv_push_cl9097_dump",
        "//kits/SwitchGM20BEmit:push_headers_mesa",
    ] + MESA_MME_HEADERS + SWITCH_GM20B_MESA_HEADERS,
    copts = MESA_MME_COPTS + ["-Wno-unused-variable"],
)

# What GM20B's classes take, for every test that decodes a push or runs a macro: a method its class lacks or a scratch
# word past the Fermi MME's 128 fails the test.
cc_library(
    name = "method_checks",
    testonly = True,
    hdrs = ["method_checks.h"],
    visibility = ["//drivers/TegraGM20BMetal/test:__pkg__"],
    deps = [
        "//kits/SwitchGM20B:methods",
        "//kits/SwitchGM20BEmit:macros_h",
        "@googletest//:gtest",
    ],
)

# The gate on the hardware's method ranges: the table against the Fermi MME's limits, and every method the context init
# writes and every raw macro names or writes against the class that takes it.
host_test(
    name = "method_ranges_test",
    srcs = [
        "method_ranges_test.cpp",
    ] + MESA_MME_HEADERS,
    copts = MESA_MME_COPTS,
    deps = [
        ":mesa_mme_sim",
        ":method_checks",
        "//kits/SwitchGM20B:caps",
        "//kits/SwitchGM20B:classes",
        "//kits/SwitchGM20BEmit:context_h",
        "//kits/SwitchGM20BEmit:macros_h",
    ],
)

host_test(
    name = "emit_mme_test",
    srcs = [
        "emit_mme_test.cpp",
    ] + MESA_MME_HEADERS,
    copts = MESA_MME_COPTS,
    deps = [
        ":mesa_mme_sim",
        "//kits/SwitchGM20B:classes",
        "//kits/SwitchGM20BEmit:macros_h",
        ":method_checks",
    ],
)

