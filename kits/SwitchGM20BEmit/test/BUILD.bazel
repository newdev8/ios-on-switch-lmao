# The kit compiled by the kernel toolchain, C and C++: never linked, built so the kernel's headers and flags keep taking it.
kernel_driver(
    name = "SwitchGM20BEmitKernelCheck",
    srcs = ["//kits/SwitchGM20BEmit:" + s for s in EMIT_SOURCES] + [
        "kernel_check.c",
        "kernel_check_cxx.cpp",
    ],
    c_copts = SWITCH_GM20B_EMIT_INCLUDES,
    copts = SWITCH_GM20B_EMIT_INCLUDES,
    hdr_deps = [
        "kits/SwitchGM20B",
        "kits/SwitchGM20BEmit",
    ],
    tags = ["no-lint"],
)

# kits/SwitchGM20BEmit/SwitchGM20BMacroSlots.h's NVK slots and scratch words against nvk_mme.h's and context.tsv's
py_test(
    name = "macro_slots_test",
    srcs = ["macro_slots_test.py"],
    data = [
        "//kits/SwitchGM20BEmit:SwitchGM20BMacroSlots.h",
        "//kits/SwitchGM20BEmit:context/context.tsv",
        "//third_party/mesa/src/nouveau/vulkan:nvk_mme.h",
    ],
)
