# xnu.bzl and defs.bzl are the rules for vendored XNU trees (kernel/xnu-<version>/): their headers, generated sources
# and SDK, replayed from tables recorded from XNU's make (the tables come from xnu_record.py, the actions run xnu_ops.py).

load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

exports_files([
    "xnu_objects_test.py",
    "xnu_ops.py",
    "xnu_record.py",
])

# The objects.bzl and recipes_<config>.bzl tables from a VERBOSE=YES make build of an XNU tree (usage: its docstring;
# absolute paths, since bazel run starts it in its runfiles).
py_binary(
    name = "xnu_compile_record",
    srcs = ["xnu_compile_record.py"],
)

py_test(
    name = "xnu_compile_record_test",
    size = "small",
    srcs = [
        "xnu_compile_record.py",
        "xnu_compile_record_test.py",
    ],
)

# Where build paths appear to be in the outputs (__FILE__ strings, debug info). The default is machine independent;
# --config=cmake-equivalence sets it to the checkout, which reproduces the CMake flow's strings exactly.
string_flag(
    name = "path_root",
    build_setting_default = "/switch-ios",
)

# XNU's version string date (newvers.pl reads KERNEL_BUILD_DATE): fixed, so a rebuild is bit-identical.
string_flag(
    name = "build_date",
    build_setting_default = "Thu  1 Jan 1970 00:00:00 UTC",
)

# XNU's version string builder (newvers.pl runs whoami; the build puts a whoami printing this first on PATH).
string_flag(
    name = "builder",
    build_setting_default = "switch-ios",
)
