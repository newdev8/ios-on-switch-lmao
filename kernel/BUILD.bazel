# --- The kernel SDK root (the CMake flow's .cache/fakeroot) -------------------------------------------------------
# kernel/xnu-<version>:sdkroot (XNU's installhdrs as Bazel actions, one file each) as one directory, for the tools
# that still take a directory (firehose, corecrypto, libpthread).
xnu_tree(
    name = "fakeroot_headers",
    src = "//kernel/xnu-10063.141.1:sdkroot",
    out = ".cache/fakeroot-headers",
)

kernel_firehose(
    name = "fakeroot",
    sdkroot = ":fakeroot_headers",
    xnu = "//kernel/xnu-10063.141.1:srcs",
)

# xnu-12377's SDK root as one directory: the headers corecrypto and libpthread compile against for it (its
# libfirehose_kernel.a is :fakeroot's, through kernel/xnu-12377.121.6:sdkroot_files).
xnu_tree(
    name = "fakeroot_headers_12377",
    src = "//kernel/xnu-12377.121.6:sdkroot",
    out = ".cache/fakeroot-headers-12377",
)

# The SDK root directory corecrypto and libpthread compile against, for the selected XNU.
alias(
    name = "kernel_headers_root",
    actual = select({
        ":xnu_12377_121_6": ":fakeroot_headers_12377",
        "//conditions:default": ":fakeroot",
    }),
)

# What the kernel's code compiles against: //kernel:sdk (kernel/xnu-<version>, every header its own file).

# Generated headers the drivers' flags name ({build}/<dir>): built once, in the configuration that asks for the kernel.
