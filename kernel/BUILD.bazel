    name = "xnu_symbols",
    srcs = select({
        ":xnu_12377_121_6": [
            "//kernel/xnu-12377.121.6/config:all_alias_exp",
            "//kernel/xnu-12377.121.6/config:link_symbols",
            "//kernel/xnu-12377.121.6/config:link_symbols_list",
        ],
        "//conditions:default": [
            "//kernel/xnu-10063.141.1/config:all_alias_exp",
            "//kernel/xnu-10063.141.1/config:link_symbols",
            "//kernel/xnu-10063.141.1/config:link_symbols_list",
        ],
    }),
    outs = ["build/xnu/kernel-names.txt"],
    args = select({
        ":xnu_12377_121_6": [
            "--names-list=$(execpath //kernel/xnu-12377.121.6/config:link_symbols_list)",
            "--aliases=$(execpath //kernel/xnu-12377.121.6/config:all_alias_exp)",
