# The XNU the kernel is built from: kernel/xnu-<version>/, the selected IPSW kind's (kernel/rules/version.bzl). Code
# that differs per version uses #if XNU_<version>; drivers depend on :sdk, never on one XNU's labels.
xnu_versions(name = "xnu_version")

# The kernel's VM page size. 16k is 16 KiB VM pages, as on every iPad, over the A57's 4 KiB translation granule (XNU's
# PAGE_RATIO 4); the kernel toolchain then adds -DSWITCH_VM_16K_PAGES=1 to every kernel compile. 4k is the native 4 KiB
# kernel, kept until a 16 KiB boot is proven on the device.
string_flag(
    name = "vm_page_size",
    build_setting_default = "16k",
    scope = "target",
    values = [
        "16k",
        "4k",
    ],
)

# kprof (osfmk/kern/switch_kprof.c) in a debug kernel, for a measurement boot: --//kernel:kprof. Release kernels never
# have it.
bool_flag(
    name = "kprof",
    build_setting_default = False,
    scope = "target",
)

# Only switch_kprof.c reads SWITCH_KPROF, so only its object changes with the flag (both XNUs' osfmk tables).
selects.config_setting_group(
    name = "kprof_debug",
    match_all = [
        ":kprof_on",
        "//bazel:debug",
    ],
)

config_setting(
    name = "kprof_on",
    flag_values = {":kprof": "true"},
)

config_setting(
    name = "vm_page_16k",
    flag_values = {":vm_page_size": "16k"},
)

