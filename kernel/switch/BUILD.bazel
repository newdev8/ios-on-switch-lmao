# Our code in XNU (README.md): the hook headers Apple's files include (include/switch/) and the code behind them, one
# directory per subsystem, compiled into both kernels as XNU objects (objects.bzl).
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//kernel:__subpackages__"])

lint_files()

# The sources and hook headers kernel/tests reads or compiles on the host.
exports_files(glob([
    "include/switch/*.h",
    "*/*.c",
    "*/*.cpp",
    "*/*.h",
]))

filegroup(
    name = "srcs",
    srcs = glob(
        [
            "*/*.c",
            "*/*.cpp",
            "*/*.s",
        ],
        allow_empty = True,
        exclude = ["include/**"],
    ) + [
        "//translate/arm64e:a64x/a64x_classify.c",
        "//translate/arm64e:a64x/a64x_image.c",
        "//translate/arm64e:a64x/a64x_rewrite.c",
    ],
    visibility = [
        "//kernel:__subpackages__",
        "//kits/SwitchSysctl/test:__pkg__",
    ],
)

filegroup(
    name = "headers",
    srcs = glob(["**/*.h"]) + [
        "//boot:loader/ram.h",
        "//kits/SwitchCDHash:switch_cdhash.h",
        "//kits/SwitchIdle:switch_idle.h",
        "//kits/SwitchIdle:switch_idle_governor.h",
        "//kits/SwitchPretranslated:switch_pretranslated.h",
        "//kits/SwitchPretranslated:switch_pretranslated_originals.h",
        "//translate/arm64e:a64x/a64x.h",
        "//translate/arm64e:a64x/a64x_fp16.h",
        "//translate/arm64e:a64x/a64x_vlive.h",
    ],
)
