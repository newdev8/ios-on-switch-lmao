# XNU's bsd: the BSD layer: processes, VFS, networking, syscalls. Apple's files as Apple has them (APPLE_LICENSE); only BUILD.bazel and .bzl files are ours.
#
# :objects compiles each object of objects.bzl (make's bsd.filelist, link order) on its own, so an edit to one
# source recompiles that object and relinks the kernel (//kernel/xnu-12377.121.6/config:xnu_objects.bzl). A new
# source: add it to objects.bzl where conf/files would put it, with any flags its conf/Makefile.* entry adds.
load("//bazel/lint:defs.bzl", "lint_files")
load("//ipsw:ipsw.bzl", "ipsw_volumes_header")
load("//kernel/xnu-12377.121.6/config:xnu_objects.bzl", "xnu_objects")
load(":objects.bzl", "DEVELOPMENT", "RELEASE")

package(default_visibility = ["//visibility:public"])

# XNU's own files keep XNU's style: only our Starlark is formatted and linted.
lint_files(exclude = [
    "**/*.py",
    "**/*.c",
    "**/*.cc",
    "**/*.cpp",
    "**/*.h",
    "**/*.hpp",
    "**/*.inc",
    "**/*.m",
    "**/*.mm",
    "**/*.rs",
    "**/*.sh",
    "**/*.md",
    "**/*.json",
    "**/*.toml",
    "**/.clang-format",
    "**/.clang-tidy",
])

# Every file, by its path below bsd/ (r18-xnu-hdrs' header, MIG and config rules name them).
exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

# What XNU's compiles may include from here (.d files prune each compile to what it read).
filegroup(
    name = "headers",
    srcs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.inc",
            "**/*.def",
            "**/*.defs",
            "**/*.iig",
            "**/*.modulemap",
        ],
        allow_empty = True,
    ),
)

# Every vendored file (r18-xnu-hdrs' :srcs): not ours, BUILD.bazel and .bzl.
filegroup(
    name = "all",
    srcs = glob(
        ["**"],
        exclude = [
            "BUILD.bazel",
            "*.bzl",
        ],
    ),
)

# kern_exec.c's -include: the scratch Data volume the owner-data mount selects (XNU_OWNER_DATA_MOUNT=1 with
# XNU_NATIVE_RAM_BLOCK=1) and the selected IPSW kind's System volume and cryptexes (SwitchRawMount.h). vm_unix.c
# takes the kind from it too (its UI scale sites, vm/switch_ui_scale_sites.h).
ipsw_volumes_header(
    name = "owner_header",
    out = "owner/owner-data-volume.h",
    lines = ['#define XNU_OWNER_DATA_VOLUME_UUID "CCD5A1A2-2FDC-4B25-B322-AE1722871BC9"'],
)

xnu_objects(
    name = "objects",
    srcs = glob([
        "**/*.c",
        "**/*.cpp",
        "**/*.s",
    ]) + ["//kernel/xnu-12377.121.6/osfmk:kperf/kperfbsd.c"],
    component = "bsd",
    release = RELEASE,
    table = DEVELOPMENT,
)
