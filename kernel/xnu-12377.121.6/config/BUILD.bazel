# XNU's config/: the kernel's own objects (version.o, lastkerneldataconst.o, lastkernelconstructor.o, nonlto.o), the KPI
# export lists and symbol sets, and the rules that compile XNU natively (xnu_objects.bzl) and link the kernel
# (xnu_kernel.bzl; the kernel tree's kernel_unprelinked calls it with the ios-on-switch-lmao archives). Apple's files as Apple
# has them (APPLE_LICENSE); only BUILD.bazel and .bzl files are ours.
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")
load(":objects.bzl", "DEVELOPMENT", "RELEASE")
load(":xnu_kernel.bzl", "xnu_exports", "xnu_link_objects", "xnu_object_names", "xnu_version_c")
load(":xnu_objects.bzl", "by_profile", "xnu_objects")

package(default_visibility = ["//visibility:public"])

# XNU's own files keep XNU's style: only our Starlark is formatted and linted (recipes_*.bzl is a generated table).
lint_files(exclude = [
    "**/*.pl",
    "**/*.sh",
    "**/*.plist",
    "recipes_*.bzl",
])

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

# Every vendored file (r18-xnu-hdrs' :srcs: MASTER, the exports, the scripts): not ours, BUILD.bazel and .bzl.
filegroup(
    name = "all",
    srcs = glob(
        ["**"],
        exclude = [
            "BUILD.bazel",
            "*.bzl",
        ],
    ),
)

filegroup(
    name = "headers",
    srcs = [],
)

# --- The kernel's own objects (makedefs/MakeInc.kernel) ------------------------------------------------------------
xnu_version_c(
    name = "version_c",
    config = by_profile("DEVELOPMENT", "RELEASE"),
)

xnu_objects(
    name = "objects",
    srcs = [
        "//kernel/xnu-12377.121.6/libsa:lastkernelconstructor.c",
        "//kernel/xnu-12377.121.6/libsa:lastkerneldataconst.c",
        "//kernel/xnu-12377.121.6/libsa:nonlto.c",
    ],
    component = "config",
    gen_hdrs = None,
    gen_relative = False,
    gen_srcs = ":version_c",
    release = RELEASE,
    table = DEVELOPMENT,
)

# The components' objects the kernel links, in link order (what xnu_symbols lists the names of).
xnu_link_objects(name = "link_objects")

filegroup(
    name = "link_symbols",
    srcs = [":link_objects"],
    output_group = "symbols",
)

filegroup(
    name = "link_symbols_list",
    srcs = [":link_objects"],
    output_group = "symbols_list",
)

# objects.bzl against doconf's Makefiles (conf/files, MASTER): a conf/files edit can't drift from the native tables.
xnu_object_names(name = "object_names")

_DOCONF = [
    "osfmk",
    "bsd",
    "libkern",
    "iokit",
    "pexpert",
    "libsa",
    "security",
    "san",
]

py_test(
    name = "objects_test",
    size = "small",
    srcs = ["//kernel/rules:xnu_objects_test.py"],
    args = ["$(rootpath :object_names)"] + ["$(rootpaths //kernel/xnu-12377.121.6:config_makefile_{})".format(c) for c in _DOCONF],
    data = [":object_names"] + ["//kernel/xnu-12377.121.6:config_makefile_" + c for c in _DOCONF],
    main = "//kernel/rules:xnu_objects_test.py",
)

# --- KPI exports and symbol sets (config/Makefile) ----------------------------------------------------------------
xnu_exports(
    name = "exports",
    srcs = glob([
        "*.exports",
        "generate_*.sh",
    ]) + ["newvers.pl"],
    plists = glob(["System.kext/PlugIns/*.kext/Info.plist"]),
)

[filegroup(
    name = name,
    srcs = [":exports"],
    output_group = group,
) for name, group in [
    ("all_kpi_exp", "kpi"),
    ("all_alias_exp", "alias"),
    ("symbolsets_plist", "symbolsets"),
]]
