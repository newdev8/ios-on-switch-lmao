# XNU code ios-on-switch-lmao changes, compiled for the host from the vendored kernel/xnu-10063.141.1 (our changes included) and
# run against the code it replaced:
#   xnu_console_wide_test    video_console.c's rotated text console's 16-byte LDP/STP paths (r9-preboot round 3) give
#                            the same pixels as the 32-bit loops they replaced (arm64 inline assembly: arm64 hosts)
#   xnu_memcmp_test          osfmk/arm64/switch_memcmp.h's word-at-a-time memcmp/bcmp (r17-launch) against the byte
#                            loops, exhaustively to 80 bytes at every alignment and over random inputs, guard pages
#                            after both buffers
#   xnu_memcmp_source_test   subrs.c uses it on arm64 only, through the two bodies the harness copies
#   xnu_kernel_classes_source_test  both trees' OSKext.cpp register our drivers' classes under sKextLock, as OSKext::start
#                            does, and no driver calls OSMetaClass::preModLoad/postModLoad itself
#   xnu_stall_test           kernel/switch/diag/stall.h's decisions: which samples of a UI main thread are a stall,
#                            one report and one end per episode, wait names by block_hint.h value, user addresses
#   xnu_render_senders_test  osfmk/ipc/switch_render_senders.h's table and line: the render server's senders by
#                            process, largest first, with their rates and top ids, the rest as others
#   xnu_render_senders_source_test  ipc_kmsg_send counts a message under its destination port's lock, only for the
#                            watched space and not for a kernel reply
#   xnu_frames_test          kernel/switch/diag/frames.h: a client's commits as bursts of messages and the gaps between
#                            them in refresh periods, touch deliveries, the line; both trees' ipc_kmsg_send feed it
#   xnu_latency_test         kernel/switch/diag/latency.h: a touch report through its delivery, the app's commit, the
#                            render server's vsync and swap to the scan-out; one sample in flight, stale ones dropped
#   xnu_sched_stats_test     kernel/switch/sched/stats.h's latency histogram, percentiles and line entry; that
#                            thread_invoke feeds it in both dispatch paths under the incoming thread's lock, and that
#                            a release kernel compiles every hook to nothing
#   xnu_sched_render_test    kernel/switch/sched/render.h: the display thread's dispatches split its time from a vsync
#                            to its swap into running, blocked and waiting for a core
#   xnu_ui_scale_test        bsd/vm/switch_ui_scale.h's scales (whole-point screens, exact floats, boot-arg values)
#                            and the cache text they write, against the assembler and the bytes the 1.6-only sites
#                            shipped; the status bar battery's fill in whole pixels with equal gaps at 1.25; the
#                            switcher's landscape card scale; Control Center's battery row in whole pixels at 1.25
#   xnu_ui_scale_sites_test  bsd/vm/switch_ui_scale_sites_21H461.h against 21H461's text mappings: every edit in its site's
#                            chunk, each site the one site of its slot in its mapping and on no other pager's slot; the
#                            two battery fills one edit of the same code, the CoverSheetKit row's tbz and the CoreUI
#                            row bytes decoded; the switcher's card scale (its branches kept, the landscape scale the
#                            largest that keeps six cards clear of the status bar and the dock, as Apple lays them out);
#                            the SystemStatusUI row the icon size 15 entries of its tables; no two sites on one page;
#                            the headers the same in both trees, no pager at scale 1 but an every_scale site's (21H461
#                            has none), the kernel's kind's table and cache magic
#   xnu_ui_scale_sites_24B119_test  bsd/vm/switch_ui_scale_sites_24B119.h against 24B119's (translated) text mappings:
#                            the same placement checks; the FrontBoardServices, MobileGestalt, CoreUI, ProgressUI and
#                            CoverSheetKit edits decoded; the keyboard's iPad table giving the 10.2-inch iPad's idiom
#                            below 768x1024 and every other screen's unchanged; the home grid the row of screen type
#                            0x68, the one every scale's screen falls through to; the switcher's landscape-only card
#                            scale keeping the shipped calls and exit; both copies of WidgetKit's placeholder deadline;
#                            WidgetKit's archived image limit at 2x; the scroll edge keyline's two ladders sending every
#                            scale but 3 to the 2x row; only the grid and WidgetKit's two applied at scale 1
#   xnu_page_ratio_test      16 KiB VM pages over the 4 KiB granule: pmap.c's write_pte_fast (both trees) writes a
#                            VM page as four consecutive 4 KiB frames, repeats empty and compressed entries, refuses an
#                            unaligned PTE
#   xnu_page_size_test       the native-4K guards (both trees) choose 16 KiB for the kernel, the commpage, process maps
#                            and the shared region in the 16k kernel, and 4 KiB everywhere in the 4k one
#   switch_pmap_test         <switch/pmap.h>: arm_clear_fast_fault skips the TLB invalidate only for a PTE whose one
#                            change is setting the Access flag
#   switch_protection_test   <switch/protection_rules.h>: an unlabelled vnode reads as D before the epoch and as a new one
#                            after it, a new one is labelled only when it would read otherwise, listxattr loses only
#                            the label; 12377's hooks label after authorization and the MAC check, a failed label fails
#                            its call, bulk class requests on Data go through getattrlist
#   switch_cpulimit_test     <switch/cpulimit.h>: a blocking per-thread CPU limit's share scaled to this CPU, lifted at
#                            a whole core, and its hook in both trees' thread_set_cpulimit
#   switch_commpage_test     <switch/commpage.h>: the ARMv8 crypto features from ID_AA64ISAR0_EL1 into the commpage and
#                            hw.optional.arm.FEAT_*, and its hook in both trees' commpage_init_arm_optional_features_isar0
#   switch_spawn_test        <switch/spawn.h>: iOS 27's posix_spawn attribute block (xnu-13432's layout, 24B119's
#                            libsystem_kernel offsets) read into the 12377 kernel's struct, its own size copied as
#                            before, any other size refused, and the hook in 12377's posix_spawn
#   switch_prefs_test        kernel/switch/boot/prefs.c takes keys out of plists CoreFoundation wrote and reads back
#                            (binary, both count forms, wide references, damaged files; XML as the setup wrote it); no
#                            boot-time setup in either tree or the 12377 port record sets SpringBoard's never-dim keys
#   switch_prefs_add_test    kernel/switch/boot/prefs.c adds a missing integer key to plists CoreFoundation wrote and
#                            reads back (binary, offsets widening, XML, <dict/>), never replaces one; only 27's setup
#                            adds True Tone's default
#
#   bazel test //kernel/tests:all
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_library", "host_test")

lint_files()

# --- video_console.c's wide helpers -----------------------------------------------------------------------------------
# helpers.h: video_console.c from "static inline boolean_t\nvc_rotate3_wide(" up to "static void\nvc_clear_screen(".
genrule(
    name = "console_helpers",
    srcs = ["//kernel/xnu-10063.141.1/osfmk:console/video_console.c"],
    outs = ["helpers.h"],
    cmd = """awk '
        on && prev == "static void" && $$0 ~ /^vc_clear_screen\\(/ { done = 1; exit }
        on { print prev }
        !on && prev == "static inline boolean_t" && $$0 ~ /^vc_rotate3_wide\\(/ { on = 1; print prev }
        { prev = $$0 }
        END { if (!done) exit 1 }
    ' $< > $@""",
)

host_library(
    name = "console_wide",
    srcs = [
        "helpers.h",
        "xnu_console_wide_harness.c",
    ],
    copts = ["-O2"],
    defines = ["main=xnu_console_wide_main"],
    includes = ["."],
)

host_test(
    name = "xnu_console_wide_test",
    srcs = ["xnu_console_wide_test.cpp"],
    target_compatible_with = ["@platforms//cpu:arm64"],
    deps = [":console_wide"],
)

