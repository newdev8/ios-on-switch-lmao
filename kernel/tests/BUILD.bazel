# --- 16 KiB VM pages over the 4 KiB granule -------------------------------------------------------------------------
# write_pte_fast_<tree>.h: pmap.c from "static void\nwrite_pte_fast(" through its closing brace.
[
    genrule(
        name = "write_pte_fast_" + tree,
        srcs = ["//kernel/xnu-{}/osfmk:arm/pmap/pmap.c".format(version)],
        outs = ["write_pte_fast_{}.h".format(tree)],
        cmd = """awk '
            prev == "static void" && $$0 ~ /^write_pte_fast\\(/ { on = 1; print prev }
            on { print }
            on && $$0 == "}" { done = 1; exit }
            { prev = $$0 }
            END { if (!done) exit 1 }
        ' $< > $@""",
    )
    for tree, version in [
        ("10063", "10063.141.1"),
        ("12377", "12377.121.6"),
    ]
]

host_test(
    name = "xnu_page_ratio_test",
    srcs = [
        "write_pte_fast_10063.h",
        "write_pte_fast_12377.h",
        "xnu_page_ratio_test.cpp",
    ],
    includes = ["."],
)

# page_policy_<tree>_<file>.h: each native-4K guard's block of the source, as a function (xnu_guard_blocks.awk).
[
    genrule(
        name = "page_policy_{}_{}".format(tree, name),
        srcs = ["//kernel/xnu-{}/{}".format(version, source)],
        outs = ["page_policy_{}_{}.h".format(tree, name)],
        cmd = "awk -v name=xnu{}_{} -v max={} -f $(execpath xnu_guard_blocks.awk) $(execpath //kernel/xnu-{}/{}) > $@".format(
            tree,
            name,
            blocks,
            version,
            source,
        ),
        tools = ["xnu_guard_blocks.awk"],
    )
    for tree, version in [
        ("10063", "10063.141.1"),
        ("12377", "12377.121.6"),
    ]
    for name, source, blocks in [
        ("arm_init", "osfmk:arm/arm_init.c", 2),
        ("commpage", "osfmk:arm/commpage/commpage.c", 1),
        ("mach_loader", "bsd:kern/mach_loader.c", 1),
        ("shared_region", "osfmk:vm/vm_shared_region.c", 1),
    ]
]

[
    host_library(
        name = "page_size_" + size,
        srcs = [
            "xnu_page_size_harness.c",
        ] + [
            "page_policy_{}_{}.h".format(tree, name)
            for tree in [
                "10063",
                "12377",
            ]
            for name in [
                "arm_init",
                "commpage",
                "mach_loader",
                "shared_region",
            ]
        ],
        hdrs = ["xnu_page_size_harness.h"],
        defines = ["XNU_PAGE_SHIFTS=xnu_page_shifts_" + size] + (["SWITCH_VM_16K_PAGES=1"] if size == "16k" else []),
        includes = ["."],
    )
    for size in [
        "16k",
        "4k",
    ]
]

