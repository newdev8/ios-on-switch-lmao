# ios-on-switch-lmao: iPadOS 17.7.11 (21H461, iPad7,1) on the Nintendo Switch OLED. README.md has the whole map.
#
#   bazel build //:boot        the Hekate boot entry (bazel-bin/boot/ios: switchroot/, bootloader/, overlay/)
#   bazel build //:kernel      the prelinked kernel (XNU + drivers + Apple's kexts)
#   bazel build //:gpu         the TegraGM20B Metal bundle and its trust cache (//gpu:bundle adds the IPSW-made seed)
#   bazel test //...           unit tests, pinned-input checks, format and lint
#   bazel run //deploy:sd -- <disk>      bazel run //deploy:pull_logs -- <disk>      bazel run //install:sd -- <disk>
#   bazel run //:image                   out/sd: an install image per iOS version (switchroot/ios/IOS17.SII.*)
#   bazel run //:image_to_card -- <disk> those images, install-ios.bin and the hekate entry onto the card
#
# Format and lint (//bazel/lint; every tool pinned in bazel/lint/tools.bzl, @llvm or the Rust toolchain):
#
#   bazel run //:format [-- PATH...]   format every file in place (or only these files and directories):
#                                      C/C++/ObjC clang-format, Python ruff format, Starlark buildifier,
#                                      shell shfmt, Rust rustfmt, Markdown rumdl, JSON/TOML dprint, Swift
#                                      swift-format (Xcode's)
#   bazel test //:format_test          the same formatters as checks, one cached action per file
#   bazel test //:lint_test            the linters: ruff check, buildifier lint=warn, shellcheck, rumdl
#   bazel test //:clang_tidy_test      clang-tidy over every C/C++/ObjC unit the build compiles, one cached action each
#   bazel run //tools/lint:py_owners   every tracked .py file belongs to a py_binary/py_test/py_library
#   bazel run //tools/lint:compdb      compile_commands.json for clangd
#
# The files are //:lint_files: each package's lint_files() (bazel/lint/defs.bzl) plus its subpackages'. Configs, at
# the root: .clang-format, .clang-tidy, ruff.toml, .buildifier.json, .shellcheckrc, .rumdl.toml, dprint.json,
# rustfmt.toml, .swift-format. Not linted: assembly (.S: no maintained linter; the assembler at -Werror is the
# check), linker scripts, plists, device trees, GLSL/Metal shaders and patches.
load("//bazel/lint:checks.bzl", "format_runner", "lint_test")
load("//bazel/lint:clang_tidy.bzl", "clang_tidy_test")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

exports_files([
    ".buildifier-tables.json",
    ".github/logo.svg",
    ".github/pull_request_template.md",
    ".buildifier.json",
    ".clang-format",
    ".clang-tidy",
    ".rumdl.toml",
    ".shellcheckrc",
    ".swift-format",
    "dprint.json",
    "ruff.toml",
    "rustfmt.toml",
])

# Never walk the root: its directory also holds out/ (agents' scratch, large and untracked), and a recursive glob or
# subpackages(**) here costs every Bazel command tens of seconds of loading. The root's own files are the top-level
# ones, .github/, docs/ and the .clang-tidy of drivers/, diagnostics/ and kits/ (no package of their own; the glob stops
# at their subpackages); its subpackages are those at the top level and one below it (drivers/<X>, ...).
lint_files(
    dirs = [
        ".github",
        "diagnostics",
        "docs",
        "drivers",
        "kits",
    ],
    # Untracked tool state at the top level of working copies.
    exclude = ["skills-lock.json"],
    subpackages = subpackages(
        include = [
            "*",
            "*/*",
        ],
        allow_empty = True,
        exclude = ["bazel-*"],
    ),
)

alias(
    name = "boot",
    actual = "//boot:package",
)

alias(
    name = "kernel",
    actual = "//kernel:prelinked",
)

alias(
    name = "gpu",
    actual = "//gpu:base",
)

alias(
    name = "image",
    actual = "//install:image",
    tags = ["manual"],
)

alias(
    name = "image_dry_run",
    actual = "//install:image_dry_run",
)

alias(
    name = "image_boot",
    actual = "//install:image_boot",
)

alias(
    name = "image_to_card",
    actual = "//install:image_to_card",
)

format_runner(
    name = "format",
    srcs = [":lint_files"],
)

lint_test(
    name = "format_test",
    srcs = [":lint_files"],
    checks = [
        "buildifier_format",
        "clang_format",
        "dprint",
        "ruff_format",
        "rumdl_format",
        "rustfmt",
        "shfmt",
        "swift_format",
    ],
    exempt = "//bazel/lint:format_exempt.txt",
)

lint_test(
    name = "lint_test",
    srcs = [":lint_files"],
    checks = [
        "actionlint",
        "buildifier",
        "ruff",
        "rumdl",
        "shellcheck",
        "swift_lint",
    ],
    # Not in `bazel test //...` until the tree's findings are fixed.
    tags = ["manual"],
)

clang_tidy_test(
    name = "clang_tidy_test",
    # Not in `bazel test //...` until the drivers' findings are fixed.
    tags = ["manual"],
    targets = [
        ":boot",
        ":gpu",
    ],
)
